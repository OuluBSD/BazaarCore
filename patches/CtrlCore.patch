+// -------------------------------------------------------------------------
+// 16-color attribute mapping: VTCell -> CHAR_INFO.Attributes (WORD)
+// -------------------------------------------------------------------------
+// Standard Windows console attributes use B-G-R bit ordering with intensity:
+// Blue=1, Green=2, Red=4, Intensity=8.
+// Standard ANSI 16 palette uses 0=Black, 1=Red, 2=Green, 3=Yellow, 4=Blue,
+// 5=Magenta, 6=Cyan, 7=White, 8=DarkGrey, 9..15=Bright variants.
+word TuiColorToWinConsoleAttr(const VTCell& cell)
+{
+	static const word sAnsiToWin4[16] = {
+		0,   // 0: Black
+		4,   // 1: Red
+		2,   // 2: Green
+		6,   // 3: Yellow (Red + Green)
+		1,   // 4: Blue
+		5,   // 5: Magenta (Red + Blue)
+		3,   // 6: Cyan (Green + Blue)
+		7,   // 7: White (Red + Green + Blue)
+		8,   // 8: Dark Grey (Intensity)
+		12,  // 9: Bright Red (Intensity + Red)
+		10,  // 10: Bright Green (Intensity + Green)
+		14,  // 11: Bright Yellow (Intensity + Yellow)
+		9,   // 12: Bright Blue (Intensity + Blue)
+		13,  // 13: Bright Magenta (Intensity + Magenta)
+		11,  // 14: Bright Cyan (Intensity + Cyan)
+		15   // 15: Bright White (Intensity + White)
+	};
+
+	int fg_ansi = 7;
+	if(!IsNull(cell.ink)) {
+		int sp = cell.ink.GetSpecial();
+		if(sp >= 0 && sp < 16)
+			fg_ansi = sp;
+		else
+			fg_ansi = NearestAnsi16(cell.ink);
+	}
+	int fg_win = sAnsiToWin4[fg_ansi & 15];
+
+	int bg_ansi = 0;
+	if(!IsNull(cell.paper)) {
+		int sp = cell.paper.GetSpecial();
+		if(sp >= 0 && sp < 16)
+			bg_ansi = sp;
+		else
+			bg_ansi = NearestAnsi16(cell.paper);
+	}
+	int bg_win = sAnsiToWin4[bg_ansi & 15];
+
+	// Bold: boost foreground to bright intensity if < 8
+	if(cell.sgr & VTCell::SGR_BOLD)
+		fg_win |= 8;
+
+	// Inverted / reverse video: swap fg and bg
+	if(cell.sgr & VTCell::SGR_INVERTED)
+		Swap(fg_win, bg_win);
+
+	word attr = (word)((fg_win & 0x0F) | ((bg_win & 0x0F) << 4));
+
+	if(cell.sgr & VTCell::SGR_INVERTED)
+		attr |= COMMON_LVB_REVERSE_VIDEO;
+
+	if(cell.sgr & VTCell::SGR_UNDERLINE)
+		attr |= COMMON_LVB_UNDERSCORE;
+
+	return attr;
+}
+
+// -------------------------------------------------------------------------
+// Structured event re-encoders (KEY_EVENT_RECORD and MOUSE_EVENT_RECORD)
+// -------------------------------------------------------------------------
+
+// Encodes a key record using win32-input-mode:
+// CSI <vk> ; <sc> ; <uc> ; <kd> ; <cs> ; <rc> _
+String TuiEncodeWin32KeyEvent(word vk, word sc, wchar_t uc, bool keydown, dword control_key_state, word repeat)
+{
+	String s;
+	s << "\033["
+	  << (int)vk << ';'
+	  << (int)sc << ';'
+	  << (int)(word)uc << ';'
+	  << (keydown ? 1 : 0) << ';'
+	  << (int)control_key_state << ';'
+	  << (int)(repeat > 0 ? repeat : 1) << '_';
+	return s;
+}
+
+// Encodes a mouse record using SGR 1006 format:
+// CSI < btn ; col ; row M/m
+// Double-click is encoded with the additive bit 128 (b | 128).
+String TuiEncodeWin32MouseEvent(Point cell, dword button_state, dword control_key_state, dword event_flags)
+{
+	int x = cell.x + 1;
+	int y = cell.y + 1;
+
+	// Modifiers from control_key_state
+	int mods = 0;
+	if(control_key_state & 0x0010) mods |= 4;              // Shift
+	if(control_key_state & (0x0001 | 0x0002)) mods |= 8;   // Alt
+	if(control_key_state & (0x0004 | 0x0008)) mods |= 16;  // Ctrl
+
+	// Wheel event (event_flags == 0x0004: MOUSE_WHEELED)
+	if(event_flags & 0x0004) {
+		short delta = (short)((button_state >> 16) & 0xFFFF);
+		int btn = 64 + mods + (delta > 0 ? 0 : 1);
+		String s;
+		s << "\033[<" << btn << ';' << x << ';' << y << 'M';
+		return s;
+	}
+
+	// Mouse motion (event_flags == 0x0001: MOUSE_MOVED)
+	if(event_flags & 0x0001) {
+		if(button_state & 0x0007) {
+			int b = (button_state & 1) ? 0 : ((button_state & 2) ? 2 : 1);
+			int btn = b + 32 + mods;
+			String s;
+			s << "\033[<" << btn << ';' << x << ';' << y << 'M';
+			return s;
+		}
+		// Hover motion
+		int btn = 35 + mods;
+		String s;
+		s << "\033[<" << btn << ';' << x << ';' << y << 'M';
+		return s;
+	}
+
+	// Double click (event_flags == 0x0002: DOUBLE_CLICK)
+	if(event_flags & 0x0002) {
+		int b = (button_state & 1) ? 0 : ((button_state & 2) ? 2 : ((button_state & 4) ? 1 : 0));
+		int btn = b + mods + 128; // set double click flag bit
+		String s;
+		s << "\033[<" << btn << ';' << x << ';' << y << 'M';
+		return s;
+	}
+
+	// Plain button press
+	if(button_state & 0x0007) {
+		int b = (button_state & 1) ? 0 : ((button_state & 2) ? 2 : ((button_state & 4) ? 1 : 0));
+		int btn = b + mods;
+		String s;
+		s << "\033[<" << btn << ';' << x << ';' << y << 'M';
+		return s;
+	}
+
+	// Button release
+	String s;
+	s << "\033[<" << mods << ';' << x << ';' << y << 'm';
+	return s;
+}
+
+// -------------------------------------------------------------------------
+// TuiTerminalWinConsole implementation
+// -------------------------------------------------------------------------
+
+#ifdef PLATFORM_WIN32
+
+static BOOL WINAPI TuiWinConConsoleCtrlHandler(DWORD)
+{
+	TheTuiTerminal().Stop();
+	return FALSE;
+}
+
+static LONG WINAPI TuiWinConUnhandledExceptionFilter(EXCEPTION_POINTERS*)
+{
+	TheTuiTerminal().Stop();
+	return EXCEPTION_CONTINUE_SEARCH;
+}
+
+static LONG WINAPI TuiWinConVectoredHandler(EXCEPTION_POINTERS *p)
+{
+	if(p && p->ExceptionRecord && p->ExceptionRecord->ExceptionCode == EXCEPTION_STACK_OVERFLOW)
+		TheTuiTerminal().Stop();
+	return EXCEPTION_CONTINUE_SEARCH;
+}
+
+#endif
+
+TuiTerminalWinConsole::TuiTerminalWinConsole()
+: started(false)
+, cellsize(80, 25)
+, cursor_pos(0, 0)
+, cursor_visible(false)
+, hin(nullptr)
+, hout(nullptr)
+, horig_out(nullptr)
+, hwake(nullptr)
+, saved_in_mode(0)
+, saved_out_mode(0)
+, saved_cp_in(0)
+, saved_cp_out(0)
+, saved_exfilter(nullptr)
+, exc_token(nullptr)
+{
+	caps.colors = 16;
+	caps.mouse = true;
+	caps.mouse_pixels = false;
+	caps.kitty_keys = false;
+	caps.win32_input = true;
+	caps.osc52_write = false;
+	caps.osc11_query = false;
+	caps.sixel = false;
+	caps.kitty_gfx = false;
+	caps.sync_output = false;
+	caps.blocks_2x2 = true;
+	caps.blocks_2x3 = false;
+	caps.blocks_2x4 = false;
+	saved_cursor_info[0] = 0;
+	saved_cursor_info[1] = 0;
+}
+
+TuiTerminalWinConsole::~TuiTerminalWinConsole()
+{
+	Stop();
+}
