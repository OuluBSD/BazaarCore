+Size TuiTerminalWinConsole::GetCellSize()
+{
+	UpdateSize();
+	return cellsize;
+}
+
+void TuiTerminalWinConsole::UpdateSize()
+{
+#ifdef PLATFORM_WIN32
+	if(hout && hout != INVALID_HANDLE_VALUE) {
+		CONSOLE_SCREEN_BUFFER_INFO csbi;
+		if(GetConsoleScreenBufferInfo((HANDLE)hout, &csbi)) {
+			cellsize.cx = max(1, (int)(csbi.srWindow.Right - csbi.srWindow.Left + 1));
+			cellsize.cy = max(1, (int)(csbi.srWindow.Bottom - csbi.srWindow.Top + 1));
+		}
+	}
+#endif
+}
+
+void TuiTerminalWinConsole::SetSimulatedSize(Size sz)
+{
+	cellsize = sz;
+	sim_buffer.Clear();
+	sim_buffer.SetCount(cellsize.cx * cellsize.cy);
+	sim_attrs.Clear();
+	sim_attrs.SetCount(cellsize.cx * cellsize.cy);
+}
+
+void TuiTerminalWinConsole::QueueSimulatedInput(const String& input)
+{
+	sim_input_queue.Cat(input);
+}
+
+void TuiTerminalWinConsole::ReleaseBuffers()
+{
+	sim_buffer.Clear();
+	sim_attrs.Clear();
+	sim_input_queue.Clear();
+}
+
+#ifdef PLATFORM_WIN32
+
+bool TuiTerminalWinConsole::Start()
+{
+	if(started)
+		return true;
+
+	if(!_isatty(0) || !_isatty(1))
+		return false;
+
+	HANDLE in = GetStdHandle(STD_INPUT_HANDLE);
+	HANDLE orig_out = GetStdHandle(STD_OUTPUT_HANDLE);
+	if(!in || !orig_out || in == INVALID_HANDLE_VALUE || orig_out == INVALID_HANDLE_VALUE)
+		return false;
+
+	DWORD in_mode = 0, out_mode = 0;
+	if(!GetConsoleMode(in, &in_mode) || !GetConsoleMode(orig_out, &out_mode))
+		return false;
+
+	saved_in_mode = in_mode;
+	saved_out_mode = out_mode;
+	hin = in;
+	horig_out = orig_out;
+
+	// Create alternate screen buffer to isolate TUI output and enable clean restoration
+	HANDLE alt_out = CreateConsoleScreenBuffer(
+		GENERIC_READ | GENERIC_WRITE,
+		FILE_SHARE_READ | FILE_SHARE_WRITE,
+		NULL,
+		CONSOLE_TEXTMODE_BUFFER,
+		NULL
+	);
+	if(!alt_out || alt_out == INVALID_HANDLE_VALUE) {
+		hout = horig_out;
+	}
+	else {
+		hout = alt_out;
+		SetConsoleActiveScreenBuffer(alt_out);
+	}
+
+	// Configure raw console input with mouse and resize events enabled
+	DWORD raw_in_mode = (saved_in_mode | ENABLE_EXTENDED_FLAGS | ENABLE_WINDOW_INPUT | ENABLE_MOUSE_INPUT)
+	                  & ~(DWORD)(ENABLE_LINE_INPUT | ENABLE_ECHO_INPUT | ENABLE_PROCESSED_INPUT
+	                           | ENABLE_QUICK_EDIT_MODE | ENABLE_INSERT_MODE
+	                           | ENABLE_VIRTUAL_TERMINAL_INPUT);
+	SetConsoleMode(in, raw_in_mode);
+
+	CONSOLE_CURSOR_INFO cci;
+	if(GetConsoleCursorInfo((HANDLE)hout, &cci)) {
+		saved_cursor_info[0] = cci.dwSize;
+		saved_cursor_info[1] = cci.bVisible;
+	}
+
+	saved_cp_in  = GetConsoleCP();
+	saved_cp_out = GetConsoleOutputCP();
+	SetConsoleOutputCP(CP_UTF8);
+	SetConsoleCP(CP_UTF8);
+
+	if(!hwake)
+		hwake = CreateEvent(NULL, FALSE, FALSE, NULL);
+
+	SetConsoleCtrlHandler(TuiWinConConsoleCtrlHandler, TRUE);
+	saved_exfilter = (void*)SetUnhandledExceptionFilter(TuiWinConUnhandledExceptionFilter);
+	exc_token = AddVectoredExceptionHandler(0, TuiWinConVectoredHandler);
+
+	UpdateSize();
+	started = true;
+	return true;
+}
+
+void TuiTerminalWinConsole::Stop()
+{
+	if(!started)
+		return;
+	started = false;
+
+	if(hout != horig_out && hout != INVALID_HANDLE_VALUE) {
+		SetConsoleActiveScreenBuffer((HANDLE)horig_out);
+		CloseHandle((HANDLE)hout);
+		hout = INVALID_HANDLE_VALUE;
+	}
+
+	if(hin && hin != INVALID_HANDLE_VALUE)
+		SetConsoleMode((HANDLE)hin, saved_in_mode);
+	if(horig_out && horig_out != INVALID_HANDLE_VALUE)
+		SetConsoleMode((HANDLE)horig_out, saved_out_mode);
+
+	if(saved_cp_in)
+		SetConsoleCP(saved_cp_in);
+	if(saved_cp_out)
+		SetConsoleOutputCP(saved_cp_out);
+
+	SetConsoleCtrlHandler(TuiWinConConsoleCtrlHandler, FALSE);
+	if(saved_exfilter)
+		SetUnhandledExceptionFilter((LPTOP_LEVEL_EXCEPTION_FILTER)saved_exfilter);
+	if(exc_token)
+		RemoveVectoredExceptionHandler(exc_token);
+
+	if(saved_cursor_info[0] > 0 && horig_out && horig_out != INVALID_HANDLE_VALUE) {
+		CONSOLE_CURSOR_INFO cci;
+		cci.dwSize = saved_cursor_info[0];
+		cci.bVisible = (BOOL)saved_cursor_info[1];
+		SetConsoleCursorInfo((HANDLE)horig_out, &cci);
+	}
+}
+
+void TuiTerminalWinConsole::Put(const String& bytes)
+{
+	if(started && hout && hout != INVALID_HANDLE_VALUE && bytes.GetCount()) {
+		DWORD written = 0;
+		WriteFile((HANDLE)hout, ~bytes, (DWORD)bytes.GetCount(), &written, NULL);
+	}
+}
+
+void TuiTerminalWinConsole::Sync()
+{
+}
+
+void TuiTerminalWinConsole::SetCursor(Point cell, bool visible)
+{
+	if(!started || !hout || hout == INVALID_HANDLE_VALUE)
+		return;
+	cursor_pos = cell;
+	cursor_visible = visible;
+
+	COORD pos = { (SHORT)cell.x, (SHORT)cell.y };
+	SetConsoleCursorPosition((HANDLE)hout, pos);
+	CONSOLE_CURSOR_INFO cci;
+	cci.dwSize = 25;
+	cci.bVisible = visible ? TRUE : FALSE;
+	SetConsoleCursorInfo((HANDLE)hout, &cci);
+}
+
+bool TuiTerminalWinConsole::WaitInput(int ms)
+{
+	if(!started || !hin || hin == INVALID_HANDLE_VALUE)
+		return false;
+
+	HANDLE handles[2] = { (HANDLE)hin, (HANDLE)hwake };
+	DWORD count = hwake ? 2 : 1;
+	DWORD r = WaitForMultipleObjects(count, handles, FALSE, ms < 0 ? INFINITE : (DWORD)ms);
+	return r == WAIT_OBJECT_0 || r == (WAIT_OBJECT_0 + 1);
+}
+
+void TuiTerminalWinConsole::DrainInput(String& out)
+{
+	if(!hin || hin == INVALID_HANDLE_VALUE)
+		return;
+
+	DWORD nevents = 0;
+	if(!GetNumberOfConsoleInputEvents((HANDLE)hin, &nevents) || nevents == 0)
+		return;
+
+	Buffer<INPUT_RECORD> recs(nevents);
+	DWORD nread = 0;
+	if(!ReadConsoleInputW((HANDLE)hin, recs, nevents, &nread) || nread == 0)
+		return;
+
+	for(DWORD i = 0; i < nread; i++) {
+		const INPUT_RECORD& r = recs[i];
+		switch(r.EventType) {
+		case KEY_EVENT:
+			out << TuiEncodeWin32KeyEvent(
+				r.Event.KeyEvent.wVirtualKeyCode,
+				r.Event.KeyEvent.wVirtualScanCode,
+				r.Event.KeyEvent.uChar.UnicodeChar,
+				r.Event.KeyEvent.bKeyDown != FALSE,
+				r.Event.KeyEvent.dwControlKeyState,
+				r.Event.KeyEvent.wRepeatCount
+			);
+			break;
+		case MOUSE_EVENT:
+			out << TuiEncodeWin32MouseEvent(
+				Point(r.Event.MouseEvent.dwMousePosition.X, r.Event.MouseEvent.dwMousePosition.Y),
+				r.Event.MouseEvent.dwButtonState,
+				r.Event.MouseEvent.dwControlKeyState,
+				r.Event.MouseEvent.dwEventFlags
+			);
+			break;
+		case WINDOW_BUFFER_SIZE_EVENT:
+			UpdateSize();
+			Ctrl::TuiSyncResize();
+			break;
+		case FOCUS_EVENT:
+			out << (r.Event.FocusEvent.bSetFocus ? "\033[I" : "\033[O");
+			break;
+		default:
+			break;
+		}
+	}
+}
+
+String TuiTerminalWinConsole::ReadInput()
+{
+	String out;
+	DrainInput(out);
+	return out;
+}
+
+void TuiTerminalWinConsole::WakeUp()
+{
+	if(hwake)
+		SetEvent((HANDLE)hwake);
+}
+
+bool TuiTerminalWinConsole::PutCells(const TuiScreen& screen, const Vector<Rect>& dirty)
+{
+	if(!started || !hout || hout == INVALID_HANDLE_VALUE)
+		return false;
+
+	for(int i = 0; i < dirty.GetCount(); i++) {
+		const Rect& r = dirty[i];
+		int w = r.GetWidth();
+		int h = r.GetHeight();
+		if(w <= 0 || h <= 0)
+			continue;
+
+		Buffer<CHAR_INFO> buf(w * h);
+		for(int y = 0; y < h; y++) {
+			for(int x = 0; x < w; x++) {
+				int idx = y * w + x;
+				const VTCell& cell = screen.At(r.left + x, r.top + y);
+				buf[idx].Attributes = TuiColorToWinConsoleAttr(cell);
+				if(cell.chr == 0 || cell.chr == 1)
+					buf[idx].Char.UnicodeChar = ' ';
+				else if(cell.chr >= 0x10000)
+					buf[idx].Char.UnicodeChar = (WCHAR)(0xD800 + ((cell.chr - 0x10000) >> 10));
+				else
+					buf[idx].Char.UnicodeChar = (WCHAR)cell.chr;
+			}
+		}
+
+		COORD bufSize = { (SHORT)w, (SHORT)h };
+		COORD bufCoord = { 0, 0 };
+		SMALL_RECT writeRegion = { (SHORT)r.left, (SHORT)r.top, (SHORT)(r.right - 1), (SHORT)(r.bottom - 1) };
+		WriteConsoleOutputW((HANDLE)hout, buf, bufSize, bufCoord, &writeRegion);
+	}
+
+	SetCursor(screen.GetCaret(), screen.IsCaretVisible());
+	return true;
+}
+
+#else
+
+// -------------------------------------------------------------------------
+// Non-Windows simulation implementation for headless testing on Linux
+// -------------------------------------------------------------------------
+
+bool TuiTerminalWinConsole::Start()
+{
+	if(started)
+		return true;
+	started = true;
+	if(cellsize.cx <= 0 || cellsize.cy <= 0)
+		cellsize = Size(80, 25);
+	sim_buffer.Clear();
+	sim_buffer.SetCount(cellsize.cx * cellsize.cy);
+	sim_attrs.Clear();
+	sim_attrs.SetCount(cellsize.cx * cellsize.cy);
+	return true;
+}
+
+void TuiTerminalWinConsole::Stop()
+{
+	started = false;
+}
+
+void TuiTerminalWinConsole::Put(const String& bytes)
+{
+}
+
+void TuiTerminalWinConsole::Sync()
+{
+}
+
+void TuiTerminalWinConsole::SetCursor(Point cell, bool visible)
+{
+	cursor_pos = cell;
+	cursor_visible = visible;
+}
+
+bool TuiTerminalWinConsole::WaitInput(int ms)
+{
+	return sim_input_queue.GetCount() > 0;
+}
+
+String TuiTerminalWinConsole::ReadInput()
+{
+	String out = sim_input_queue;
+	sim_input_queue.Clear();
+	return out;
+}
+
+void TuiTerminalWinConsole::WakeUp()
+{
+}
+
+bool TuiTerminalWinConsole::PutCells(const TuiScreen& screen, const Vector<Rect>& dirty)
+{
+	if(!started)
+		return false;
+
+	if(dirty.IsEmpty())
+		return true;
+
+	if(sim_buffer.GetCount() != cellsize.cx * cellsize.cy) {
+		sim_buffer.SetCount(cellsize.cx * cellsize.cy);
+		sim_attrs.SetCount(cellsize.cx * cellsize.cy);
+	}
+
+	for(int i = 0; i < dirty.GetCount(); i++) {
+		const Rect& r = dirty[i];
+		for(int y = r.top; y < r.bottom; y++) {
+			for(int x = r.left; x < r.right; x++) {
+				int idx = y * cellsize.cx + x;
+				if(idx >= 0 && idx < sim_buffer.GetCount()) {
+					const VTCell& cell = screen.At(x, y);
+					sim_buffer[idx] = cell;
+					sim_attrs[idx] = TuiColorToWinConsoleAttr(cell);
+				}
+			}
+		}
+	}
+
+	SetCursor(screen.GetCaret(), screen.IsCaretVisible());
+	return true;
+}
+
+#endif
+
+TuiTerminalWinConsole& GetTuiTerminalWinConsole()
+{
+	alignas(TuiTerminalWinConsole) static byte storage[sizeof(TuiTerminalWinConsole)];
+	static TuiTerminalWinConsole *sInst;
+	if(!sInst)
+		sInst = new(storage) TuiTerminalWinConsole;
+	return *sInst;
+}
+
+END_UPP_NAMESPACE
+
+#endif
diff -uNr -x '*.o' -x '*.a' -x '*.obj' CtrlCore_a/TuiTermWinConsole.h CtrlCore_b/TuiTermWinConsole.h
--- a/TuiTermWinConsole.h	1970-01-01 02:00:00.000000000 +0200
+++ b/TuiTermWinConsole.h	2026-09-14 14:21:02.170518900 +0300
@@ -0,0 +1,83 @@
+// CtrlCoreTUI 11/01 (legacy Windows console API driver): TuiTerminal implementation
+// using WriteConsoleOutputW / ReadConsoleInputW / CreateConsoleScreenBuffer.
+// Plan doc: 2-plan/ai-upp/root/CtrlCoreTUI/11-legacy-console/01-win-console-api.md.
+
+#ifndef _CtrlCore_TuiTermWinConsole_h_
+#define _CtrlCore_TuiTermWinConsole_h_
+
+#include "TuiTerminal.h"
+#include "TuiScreen.h"
+
+NAMESPACE_UPP
+
+// 16-color attribute mapping from VTCell to Windows Console CHAR_INFO.Attributes
+word   TuiColorToWinConsoleAttr(const VTCell& cell);
+
+// Structured event re-encoders
+String TuiEncodeWin32KeyEvent(word vk, word sc, wchar_t uc, bool keydown, dword control_key_state, word repeat = 1);
+String TuiEncodeWin32MouseEvent(Point cell, dword button_state, dword control_key_state, dword event_flags);
+
+class TuiTerminalWinConsole : public TuiTerminal {
+public:
+	TuiTerminalWinConsole();
+	virtual ~TuiTerminalWinConsole();
+
+	bool  Start() override;
+	void  Stop() override;
+	const TuiCapabilities& GetCapabilities() const override;
+	Size  GetCellSize() override;
+	void  Put(const String& bytes) override;
+	void  Sync() override;
+	void  SetCursor(Point cell, bool visible) override;
+	bool  WaitInput(int ms) override;
+	String ReadInput() override;
+	void  WakeUp() override;
+
+	// Phase 11 seam extension: direct cell writing
+	bool  PutCells(const TuiScreen& screen, const Vector<Rect>& dirty) override;
+
+	void  ReleaseBuffers();
+
+	// Simulated / test inspection accessors
+	void  SetSimulatedSize(Size sz);
+	Size  GetScreenSize() const { return cellsize; }
+	void  QueueSimulatedInput(const String& input);
+	const Vector<VTCell>& GetSimulatedBuffer() const { return sim_buffer; }
+	const Vector<word>&   GetSimulatedAttrs() const  { return sim_attrs; }
+
+private:
+	bool            started;
+	Size            cellsize;
+	TuiCapabilities caps;
+	Point           cursor_pos;
+	bool            cursor_visible;
+
+	// Simulated buffer for Linux test host / testing
+	Vector<VTCell>  sim_buffer;
+	Vector<word>    sim_attrs;
+	String          sim_input_queue;
+
+	// Platform handles stored as opaque pointers to avoid including windows.h in header
+	void*           hin;
+	void*           hout;
+	void*           horig_out;
+	void*           hwake;
+	dword           saved_in_mode;
+	dword           saved_out_mode;
+	dword           saved_cp_in;
+	dword           saved_cp_out;
+	void*           saved_exfilter;
+	void*           exc_token;
+	dword           saved_cursor_info[2]; // dwSize + bVisible
+
+	void            UpdateSize();
+#ifdef PLATFORM_WIN32
+	void            DrainInput(String& out);
+#endif
+};
+
+TuiTerminalWinConsole& GetTuiTerminalWinConsole();
+
+END_UPP_NAMESPACE
+
+#endif
