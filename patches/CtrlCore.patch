+
+void TuiRegisterNerdFontGlyph(const Image& img, const WString& glyph, Color ink)
+{
+	TuiRegisterNerdFontGlyph(img.GetSerialId(), glyph, ink);
+}
+
+void TuiRegisterNerdFontGlyph(int64 serial, const char *glyph_utf8, Color ink)
+{
+	TuiRegisterNerdFontGlyph(serial, ToUtf32(glyph_utf8), ink);
+}
+
+void TuiRegisterNerdFontGlyph(const Image& img, const char *glyph_utf8, Color ink)
+{
+	TuiRegisterNerdFontGlyph(img.GetSerialId(), ToUtf32(glyph_utf8), ink);
+}
+
+void TuiRegisterNerdFontGlyph(const char *iml_name, int i, const WString& glyph, Color ink)
+{
+	int q = FindIml(iml_name);
+	if(q >= 0) {
+		Image m = GetIml(q).Get(i);
+		if(!m.IsEmpty())
+			TuiRegisterNerdFontGlyph(m.GetSerialId(), glyph, ink);
+	}
+}
+
+void TuiRegisterNerdFontGlyph(const char *iml_name, int i, const char *glyph_utf8, Color ink)
+{
+	TuiRegisterNerdFontGlyph(iml_name, i, ToUtf32(glyph_utf8), ink);
+}
+
+const TuiIconGlyph *TuiFindIconGlyph(int64 serial)
+{
+	if(serial == 0)
+		return nullptr;
+	int q = s_icon_registry().Find(serial);
+	if(q < 0)
+		return nullptr;
+	const TuiIconRecord& rec = s_icon_registry()[q];
+	if(IsTuiNerdFontEnabled() && !rec.nerd_glyph.glyph.IsEmpty())
+		return &rec.nerd_glyph;
+	if(!rec.std_glyph.glyph.IsEmpty())
+		return &rec.std_glyph;
+	return nullptr;
+}
