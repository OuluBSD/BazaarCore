+Value TuiChLookFn(Ctrl *ctrl, Draw& w, const Rect& r, const Value& v, int op, Color ink)
+{
+	int nop = op & ~LOOK_NOCACHE;
+
+	if(IsType<Color>(v)) {
+		Color c = v;
+		switch(nop) {
+		case LOOK_PAINT:
+			w.DrawRect(r, c);
+			return 0;
+		case LOOK_PAINTEDGE: {
+			int policy = ChBorderPolicyValue();
+			if(policy == CHBORDER_GRAPHIC) {
+				TuiPaintBoxBorder(w, r, !IsNull(ink) ? ink : SColorShadow());
+				return 0;
+			}
+			if(policy == CHBORDER_PAPER) {
+				DrawFrame(w, r, !IsNull(ink) ? ink : SColorShadow());
+				return 0;
+			}
+			return 0; // CHBORDER_NONE
+		}
+		case LOOK_MARGINS: {
+			int policy = ChBorderPolicyValue();
+			if(policy == CHBORDER_GRAPHIC) {
+				Size cell = TuiCellSize();
+				return Rect(cell.cx, cell.cy, cell.cx, cell.cy);
+			}
+			return Rect(0, 0, 0, 0);
+		}
+		}
+		return Null;
+	}
+
+	if(IsType<ChBorderData>(v)) {
+		const ChBorderData& b = ValueTo<ChBorderData>(v);
+		switch(nop) {
+		case LOOK_PAINT: {
+			int policy = ChBorderPolicyValue();
+			Size cell = TuiCellSize();
+			Rect m = (policy == CHBORDER_GRAPHIC) ? Rect(cell.cx, cell.cy, cell.cx, cell.cy) : Rect(0, 0, 0, 0);
+			ChPaint(ctrl, w, r.Deflated(m), b.face, ink);
+			TuiChLookFn(ctrl, w, r, v, LOOK_PAINTEDGE, ink);
+			return 0;
+		}
+		case LOOK_PAINTEDGE: {
+			int policy = ChBorderPolicyValue();
+			if(policy == CHBORDER_GRAPHIC) {
+				TuiPaintBoxBorder(w, r, !IsNull(ink) ? ink : SColorShadow());
+				return 0;
+			}
+			if(policy == CHBORDER_PAPER) {
+				DrawFrame(w, r, !IsNull(ink) ? ink : SColorShadow());
+				return 0;
+			}
+			return 0; // CHBORDER_NONE
+		}
+		case LOOK_MARGINS: {
+			int policy = ChBorderPolicyValue();
+			if(policy == CHBORDER_GRAPHIC) {
+				Size cell = TuiCellSize();
+				return Rect(cell.cx, cell.cy, cell.cx, cell.cy);
+			}
+			return Rect(0, 0, 0, 0);
+		}
+		}
+		return Null;
+	}
+
+	if(IsType<ChLookWithData>(v)) {
+		const ChLookWithData& x = ValueTo<ChLookWithData>(v);
+		if(nop == LOOK_PAINT) {
+			ChPaint(ctrl, w, r, x.look, ink);
+			Point p = r.CenterPos(x.img.GetSize()) + x.offset;
+			if(x.colorfn)
+				w.DrawImage(p.x, p.y, x.img, (*x.colorfn)(x.ii));
+			else if(!IsNull(x.color))
+				w.DrawImage(p.x, p.y, x.img, x.color);
+			else
+				w.DrawImage(p.x, p.y, x.img);
+			return 1;
+		}
+		if(nop == LOOK_MARGINS)
+			return ChMargins(ctrl, x.look);
+		if(nop == LOOK_PAINTEDGE) {
+			ChPaintEdge(ctrl, w, r, x.look, ink);
+			return 0;
+		}
+		return Null;
+	}
+
+	return Null;
+}
