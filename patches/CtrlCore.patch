+{
+	s_osc52_read_response = text;
+}
+
+bool IsTuiPasteFileDropEnabled()
+{
+	if(s_paste_file_drop)
+		return true;
+	const char *env = getenv("UPP_TUI_PASTE_FILE_DROP");
+	return env && (*env == '1' || strcasecmp(env, "true") == 0 || strcasecmp(env, "yes") == 0);
+}
+
+void SetTuiPasteFileDropEnabled(bool b)
+{
+	s_paste_file_drop = b;
+}
+
+void TuiWriteOsc52(const String& text)
+{
+	if(s_suppress_osc52 || text.IsEmpty())
+		return;
+
+	String payload = text;
+	const int MAX_PAYLOAD = 75000;
+	if(payload.GetLength() > MAX_PAYLOAD) {
+		LOG("OSC 52: clipboard payload truncated from " << payload.GetLength() << " to " << MAX_PAYLOAD << " bytes");
+		payload.Trim(MAX_PAYLOAD);
+		s_osc52_truncated++;
+	}
+
+	String b64 = Base64Encode(payload);
+	b64.Replace("\r", "");
+	b64.Replace("\n", "");
+
+	String osc;
+	if(getenv("TMUX"))
+		osc << "\033Ptmux;\033\033]52;c;" << b64 << "\033\033\\\033\\";
+	else
+		osc << "\033]52;c;" << b64 << "\007";
+
+	s_osc52_writes++;
+	TheTuiTerminal().Put(osc);
+	TheTuiTerminal().Sync();
+}
+
+String TuiReadOsc52(int timeout_ms)
+{
+	if(!IsTuiOsc52ReadEnabled())
+		return Null;
+
+	if(!s_osc52_read_response.IsEmpty()) {
+		String res = s_osc52_read_response;
+		s_osc52_read_response.Clear();
+		return res;
+	}
+
+	String osc = "\033]52;c;?\007";
+	TheTuiTerminal().Put(osc);
+	TheTuiTerminal().Sync();
+
+	int start = msecs();
+	while(msecs() - start < timeout_ms) {
+		if(!s_osc52_read_response.IsEmpty()) {
+			String res = s_osc52_read_response;
+			s_osc52_read_response.Clear();
+			return res;
+		}
+		if(TheTuiTerminal().WaitInput(10)) {
+			String input = TheTuiTerminal().ReadInput();
+			if(!input.IsEmpty()) {
+				TuiFeedInput(input);
+				if(!s_osc52_read_response.IsEmpty()) {
+					String res = s_osc52_read_response;
+					s_osc52_read_response.Clear();
+					return res;
+				}
+			}
+		}
+	}
+	return Null;
+}
+
+#ifdef PLATFORM_WIN32
+static bool sWin32ClipboardOpen()
+{
+	for(int i = 0; i < 20; i++) {
+		if(::OpenClipboard(NULL))
+			return true;
+		::Sleep(5);
+	}
+	return false;
+}
+
+static void sSetWin32ClipboardText(const WString& wtext)
+{
+	if(!sWin32ClipboardOpen())
+		return;
+	::EmptyClipboard();
+	int len = (wtext.GetLength() + 1) * sizeof(wchar);
+	HGLOBAL hGlobal = ::GlobalAlloc(GMEM_MOVEABLE, len);
+	if(hGlobal) {
+		void *ptr = ::GlobalLock(hGlobal);
+		if(ptr) {
+			memcpy(ptr, ~wtext, len);
+			::GlobalUnlock(hGlobal);
+			::SetClipboardData(CF_UNICODETEXT, hGlobal);
+		}
+		else
+			::GlobalFree(hGlobal);
+	}
+	::CloseClipboard();
+}
+
+static WString sGetWin32ClipboardText()
+{
+	WString res;
+	if(!sWin32ClipboardOpen())
+		return res;
+	HANDLE hData = ::GetClipboardData(CF_UNICODETEXT);
+	if(hData) {
+		const wchar *ptr = (const wchar *)::GlobalLock(hData);
+		if(ptr) {
+			res = ptr;
+			::GlobalUnlock(hData);
+		}
+	}
+	::CloseClipboard();
+	return res;
+}
+
+static bool sIsWin32ClipboardAvailableText()
+{
+	return ::IsClipboardFormatAvailable(CF_UNICODETEXT) || ::IsClipboardFormatAvailable(CF_TEXT);
+}
