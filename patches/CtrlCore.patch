+static int s_osc52_writes = 0;
+static int s_osc52_truncated = 0;
+static bool s_suppress_osc52 = false;
+static int s_osc52_read_mode = -1;
+static String s_osc52_read_response;
+static bool s_paste_file_drop = false;
+
+int  GetTuiOsc52WriteCount()     { return s_osc52_writes; }
+int  GetTuiOsc52TruncatedCount() { return s_osc52_truncated; }
