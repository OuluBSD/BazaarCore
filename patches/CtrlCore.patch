+// Exit path 3 (Panic/ASSERT): every panic and failed assertion funnels through
+// PanicMessageBox() (Core/Util.cpp), so installing our own box restores the
+// terminal BEFORE the message is written -- on a raw-mode terminal the text
+// would otherwise be unreadable. Stop() is idempotent and async-signal-safe;
+// abort() afterwards still runs the POSIX SIGABRT handler as a second,
+// no-op safety net.
+//
+// We must NOT call PanicMessageBox() here: it would re-dispatch through
+// sPanicMessageBox (ourselves) and recurse. Reproduce its default action
+// (write to stderr) directly instead.
+static void TuiPanicMessageBox(const char *title, const char *text)
+{
+	TheTuiTerminal().Stop();
+	IGNORE_RESULT(write(2, text, (int)strlen(text)));
+	IGNORE_RESULT(write(2, "\n", 1));
+}
