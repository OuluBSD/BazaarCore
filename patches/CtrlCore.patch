+
+void TuiDrawFocus(Draw& w, const Rect& r, Color c)
+{
+	TuiDraw *td = dynamic_cast<TuiDraw*>(&w);
+	Point off = td ? td->GetOffset() : Point(0, 0);
+	Rect sr = r + off;
+	Size cell_sz = TuiCellSize();
+	if(cell_sz.cx <= 0 || cell_sz.cy <= 0) return;
+	int x1 = max(0, sr.left / cell_sz.cx);
+	int y1 = max(0, sr.top / cell_sz.cy);
+	int x2 = min(TheTuiScreen().GetSize().cx - 1, (sr.right - 1) / cell_sz.cx);
+	int y2 = min(TheTuiScreen().GetSize().cy - 1, (sr.bottom - 1) / cell_sz.cy);
+	for(int y = y1; y <= y2; y++) {
+		for(int x = x1; x <= x2; x++) {
+			VTCell& cell = TheTuiScreen().At(x, y);
+			cell.sgr |= VTCell::SGR_UNDERLINE;
+		}
+	}
+}
