+{
+	s_suppress_osc52 = b;
+}
+
+bool IsTuiOsc52ReadEnabled()
+{
+	if(s_osc52_read_mode >= 0)
+		return s_osc52_read_mode == 1;
+	const char *env = getenv("UPP_TUI_OSC52_READ");
+	return env && (*env == '1' || strcasecmp(env, "true") == 0 || strcasecmp(env, "yes") == 0);
+}
+
+void SetTuiOsc52ReadMode(int mode)
+{
+	s_osc52_read_mode = mode;
+}
