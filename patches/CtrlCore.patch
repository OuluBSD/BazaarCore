diff -uNr -x '*.o' -x '*.a' -x '*.obj' CtrlCore_a/TuiTermVT.cpp CtrlCore_b/TuiTermVT.cpp
--- a/TuiTermVT.cpp	1970-01-01 02:00:00.000000000 +0200
+++ b/TuiTermVT.cpp	2026-09-15 23:01:43.692821900 +0300
@@ -0,0 +1,1022 @@
+#include <CtrlCore/CtrlCore.h>
+
+#ifdef PLATFORM_TUI
+
+#include "TuiTerminal.h"
+#include "TuiTermWinConsole.h"
+#include "TuiTermHeadless.h"
+
+#include <new>
+
+#ifdef PLATFORM_WIN32
+#include <windows.h>
+#include <io.h>
+// windows.h only declares CP_UTF8 with WIN32_LEAN_AND_MEAN undefined; the U++
+// build defs suppress it, so pin the single code page constant we need.
+#ifndef CP_UTF8
+#define CP_UTF8 65001
+#endif
+#else
+#include <termios.h>
+#include <unistd.h>
+#include <sys/ioctl.h>
+#include <poll.h>
+#include <signal.h>
+#include <fcntl.h>
+#endif
+
+// CtrlCoreTUI 01/02 task 6 (exit paths): the terminal is restored by every
+// exit path that can be caught. Ordering matters on the Panic path: Stop()
+// must run BEFORE the panic message is printed, or the message is unreadable
+// on a raw-mode terminal. Stop() itself is idempotent and async-signal-safe,
+// so the paths below may overlap freely (e.g. Panic restores, then abort()
+// raises SIGABRT, which also runs the handler -- the second Stop() is a no-op).
+//
+//  1. normal exit            -- EXITBLOCK (atexit) below; runs on main() return
+//                               and on Ctrl::Exit()
+//  2. EndSession / Exit()    -- same atexit path (EndSession is a state flag;
+//                               the loop unwinds to main() return)
+//  3. Panic() / ASSERT       -- TuiCtrl.cpp::InstallPanicBox() calls Stop()
+//                               before the message is written
+//  4. POSIX fatal signals    -- sFatalHandler below (SIGSEGV/SIGABRT/SIGBUS/
+//                               SIGTERM/SIGHUP/SIGINT) restores then re-raises
+//                               with the default disposition
+//  5. Windows ctrl handler   -- SetConsoleCtrlHandler in Start(), plus an
+//                               unhandled-exception filter and a vectored
+//                               handler narrowed to stack overflow
+//
+// SIGKILL (and Windows task-manager kill) cannot be caught: `reset` is the
+// documented recourse (plan risk note).
+
+NAMESPACE_UPP
+
+// Windows exit-path handlers, defined after the class below. Declared here so
+// Start()/Stop() (class members) can reference them; both live in Upp::
+// exactly like the definitions later in this file.
+#ifdef PLATFORM_WIN32
+static BOOL WINAPI TuiConsoleCtrlHandler(DWORD);
+static LONG WINAPI TuiUnhandledExceptionFilter(EXCEPTION_POINTERS*);
+static LONG WINAPI TuiVectoredHandler(EXCEPTION_POINTERS*);
+#endif
+
+// CtrlCoreTUI 01/02 (gate_raw): the VT/termios TuiTerminal implementation.
+//
+// Design notes:
+// - Put() writes bytes straight to the tty and Sync() is a no-op, so Stop() has
+//   nothing buffered to lose. The cell layer (phase 02) is what batches; the
+//   seam stays write-through for signal-safety.
+// - Stop() is idempotent and async-signal-safe: it issues one precomputed
+//   leave-sequence write plus one mode restore (tcsetattr / SetConsoleMode).
+//   Enter/leave bytes are fixed at Start() time so restore needs no allocation.
+// - Windows input does NOT use ENABLE_VIRTUAL_TERMINAL_INPUT. Console records
+//   are read with ReadConsoleInput and re-encoded to VT bytes here (the seam is
+//   byte-oriented precisely so this can happen once, on this side). Reasons:
+//     * readiness becomes decidable -- WaitForMultipleObjects(hin, wakeup) plus
+//       a drain that encodes, so ReadInput() never blocks. Under VT input mode
+//       there is no way to ask "will ReadFile yield bytes?", and key-up, focus
+//       and mouse records make the handle readable while ReadFile blocks.
+//     * ENABLE_WINDOW_INPUT delivers WINDOW_BUFFER_SIZE_EVENT, so resize needs
+//       no polling (VT input mode swallows those records).
+//     * Ctrl+C arrives as a plain 0x03 byte, deterministically.
+// - QuerySize() is called from Start(), from the resize record on Windows and
+//   from the SIGWINCH self-pipe byte on POSIX.
+
+class TuiTerminalVT : public TuiTerminal {
+	bool            started = false;
+	// The leave sequence lives in a fixed buffer, not a String: this object is
+	// never destroyed (see TheTuiTerminal below), so anything it holds on the
+	// heap is a leak U++ reports at exit -- and on Windows that report is a
+	// modal MessageBox with no window to show it, which hangs the process.
+	// A plain buffer also makes Stop() allocation-free, which the signal paths
+	// need anyway. 128 bytes against a worst case near 70.
+	char            restore_buf[128];
+	int             restore_len = 0;
+	TuiCapabilities caps;
+	Size            cellsize = Size(80, 25);
+
+	#ifdef PLATFORM_WIN32
+	HANDLE hin = NULL, hout = NULL, hwake = NULL;
+	DWORD  saved_in_mode = 0, saved_out_mode = 0;
+	UINT   saved_cp_in = 0, saved_cp_out = 0;
+	PVOID  exc_token = NULL;              // RemoveVectoredExceptionHandler token
+	LPTOP_LEVEL_EXCEPTION_FILTER saved_exfilter = NULL;
+	String inq;                           // decoded VT bytes ReadInput() has not taken
+	wchar  pending_high = 0;              // UTF-16 surrogate carried between records
+	#else
+	int             in_fd   = STDIN_FILENO;
+	int             out_fd  = STDOUT_FILENO;
+	struct termios  saved_term;
+	int             selfpipe[2] = { -1, -1 };
+	volatile sig_atomic_t winch  = 0;
+	bool            wakeup = false;
+	static TuiTerminalVT *s_instance;
+	static void sWinchHandler(int);
+	static void sFatalHandler(int);   // POSIX exit path 4
+	#endif
+
+	String EnterSequence()
+	{
+		String s;
+		// Alternate screen, hide cursor, bracketed paste, focus reporting.
+		s << "\x1b[?1049h\x1b[?25l\x1b[?2004h\x1b[?1004h";
+		if(caps.mouse)
+			s << "\x1b[?1000h\x1b[?1002h\x1b[?1003h\x1b[?1006h";   // all-motion SGR
+		if(caps.mouse_pixels)
+			s << "\x1b[?1016h";                                     // pixel coords
+		if(caps.kitty_keys)
+			s << "\x1b[>1u";                                        // kitty keyboard
+		return s;
+	}
+
+	String LeaveSequence()
+	{
+		String s;
+		if(caps.kitty_keys)
+			s << "\x1b[<u";
+		if(caps.mouse_pixels)
+			s << "\x1b[?1016l";
+		if(caps.mouse)
+			s << "\x1b[?1000l\x1b[?1002l\x1b[?1003l\x1b[?1006l";
+		s << "\x1b[?1004l\x1b[?2004l\x1b[?25h\x1b[?1049l";
+		return s;
+	}
+
+	Size QuerySize()
+	{
+		#ifdef PLATFORM_WIN32
+		CONSOLE_SCREEN_BUFFER_INFO info;
+		if(GetConsoleScreenBufferInfo(hout, &info)) {
+			Size s(info.srWindow.Right - info.srWindow.Left + 1,
+			       info.srWindow.Bottom - info.srWindow.Top + 1);
+			if(s.cx > 0 && s.cy > 0)
+				cellsize = s;
+		}
+		#else
+		struct winsize ws;
+		if(ioctl(out_fd, TIOCGWINSZ, &ws) == 0 && ws.ws_col > 0 && ws.ws_row > 0)
+			cellsize = Size(ws.ws_col, ws.ws_row);
+		#endif
+		return cellsize;
+	}
+
+	#ifdef PLATFORM_WIN32
+
+	// ---- Windows console records -> VT bytes ----
+
+	void CatUtf8(dword c)
+	{
+		if(c < 0x80)
+			inq.Cat((char)c);
+		else
+		if(c < 0x800) {
+			inq.Cat((char)(0xc0 | (c >> 6)));
+			inq.Cat((char)(0x80 | (c & 0x3f)));
+		}
+		else
+		if(c < 0x10000) {
+			inq.Cat((char)(0xe0 | (c >> 12)));
+			inq.Cat((char)(0x80 | ((c >> 6) & 0x3f)));
+			inq.Cat((char)(0x80 | (c & 0x3f)));
+		}
+		else {
+			inq.Cat((char)(0xf0 | (c >> 18)));
+			inq.Cat((char)(0x80 | ((c >> 12) & 0x3f)));
+			inq.Cat((char)(0x80 | ((c >> 6) & 0x3f)));
+			inq.Cat((char)(0x80 | (c & 0x3f)));
+		}
+	}
+
+	// xterm modifier parameter: 1 + shift(1) + alt(2) + ctrl(4).
+	static int ModParam(DWORD cs)
+	{
+		return 1 + ((cs & SHIFT_PRESSED) ? 1 : 0)
+		         + ((cs & (LEFT_ALT_PRESSED | RIGHT_ALT_PRESSED)) ? 2 : 0)
+		         + ((cs & (LEFT_CTRL_PRESSED | RIGHT_CTRL_PRESSED)) ? 4 : 0);
+	}
+
+	// Cursor/edit/function keys as xterm sends them. Returns false for keys that
+	// carry no VT sequence of their own (ordinary characters, bare modifiers).
+	static bool VTKey(WORD vk, const char*& final, int& tilde, bool& ss3)
+	{
+		final = NULL;
+		tilde = 0;
+		ss3   = false;
+		switch(vk) {
+		case VK_UP:     final = "A"; return true;
+		case VK_DOWN:   final = "B"; return true;
+		case VK_RIGHT:  final = "C"; return true;
+		case VK_LEFT:   final = "D"; return true;
+		case VK_HOME:   final = "H"; return true;
+		case VK_END:    final = "F"; return true;
+		case VK_F1:     final = "P"; ss3 = true; return true;
+		case VK_F2:     final = "Q"; ss3 = true; return true;
+		case VK_F3:     final = "R"; ss3 = true; return true;
+		case VK_F4:     final = "S"; ss3 = true; return true;
+		case VK_INSERT: tilde =  2; return true;
+		case VK_DELETE: tilde =  3; return true;
+		case VK_PRIOR:  tilde =  5; return true;
+		case VK_NEXT:   tilde =  6; return true;
+		case VK_F5:     tilde = 15; return true;
+		case VK_F6:     tilde = 17; return true;
+		case VK_F7:     tilde = 18; return true;
+		case VK_F8:     tilde = 19; return true;
+		case VK_F9:     tilde = 20; return true;
+		case VK_F10:    tilde = 21; return true;
+		case VK_F11:    tilde = 23; return true;
+		case VK_F12:    tilde = 24; return true;
+		default:        return false;
+		}
+	}
+
+	void EncodeKey(const KEY_EVENT_RECORD& k)
+	{
+		if(!k.bKeyDown)
+			return;                       // key-up carries no bytes
+		DWORD cs    = k.dwControlKeyState;
+		bool  alt   = (cs & (LEFT_ALT_PRESSED | RIGHT_ALT_PRESSED)) != 0;
+		bool  ctrl  = (cs & (LEFT_CTRL_PRESSED | RIGHT_CTRL_PRESSED)) != 0;
+		bool  shift = (cs & SHIFT_PRESSED) != 0;
+		int   m     = ModParam(cs);
+		int   rep   = max<int>(1, k.wRepeatCount);
+
+		const char *final;
+		int         tilde;
+		bool        ss3;
+		while(rep--) {
+			if(VTKey(k.wVirtualKeyCode, final, tilde, ss3)) {
+				if(final) {
+					if(m == 1)
+						inq << (ss3 ? "\x1bO" : "\x1b[") << final;
+					else
+						inq << "\x1b[1;" << m << final;
+				}
+				else {
+					if(m == 1)
+						inq << "\x1b[" << tilde << '~';
+					else
+						inq << "\x1b[" << tilde << ';' << m << '~';
+				}
+				continue;
+			}
+			switch(k.wVirtualKeyCode) {
+			case VK_BACK:
+				// Terminals send DEL for Backspace and BS for Ctrl+Backspace.
+				if(alt) inq.Cat('\x1b');
+				inq.Cat(ctrl ? '\x08' : '\x7f');
+				continue;
+			case VK_TAB:
+				if(shift) { inq << "\x1b[Z"; continue; }
+				if(alt) inq.Cat('\x1b');
+				inq.Cat('\t');
+				continue;
+			case VK_ESCAPE:
+				inq.Cat('\x1b');
+				continue;
+			case VK_RETURN:
+				if(alt) inq.Cat('\x1b');
+				inq.Cat('\r');
+				continue;
+			default:
+				break;
+			}
+			wchar c = k.uChar.UnicodeChar;
+			if(!c) {
+				// Alt+<key> is a system key: Windows leaves UnicodeChar empty.
+				// Reconstruct the ESC-prefixed form for the printable range.
+				if(alt && k.wVirtualKeyCode >= ' ' && k.wVirtualKeyCode < 128) {
+					int ch = k.wVirtualKeyCode;
+					if(ch >= 'A' && ch <= 'Z' && !shift)
+						ch += 'a' - 'A';
+					inq.Cat('\x1b');
+					CatUtf8(ch);
+				}
+				continue;              // bare modifier / unmapped key: no bytes
+			}
+			if(c >= 0xd800 && c < 0xdc00) {
+				pending_high = c;      // high surrogate: wait for the low half
+				continue;
+			}
+			dword u = c;
+			if(c >= 0xdc00 && c < 0xe000) {
+				if(!pending_high)
+					continue;
+				u = 0x10000 + (((dword)pending_high - 0xd800) << 10) + (c - 0xdc00);
+				pending_high = 0;
+			}
+			if(alt)
+				inq.Cat('\x1b');
+			CatUtf8(u);
+		}
+	}
+
+	// Consume every pending console record, encoding what carries bytes. Sets
+	// resized if the window changed and returns how many records were taken,
+	// so callers can tell "only noise arrived" from "the handle lied". Never
+	// blocks.
+	int Drain(bool& resized)
+	{
+		int consumed = 0;
+		for(;;) {
+			DWORD navail = 0;
+			if(!GetNumberOfConsoleInputEvents(hin, &navail) || navail == 0)
+				break;
+			INPUT_RECORD rec[64];
+			DWORD        got = 0;
+			if(!ReadConsoleInput(hin, rec, min(navail, (DWORD)64), &got) || !got)
+				break;
+			consumed += (int)got;
+			for(DWORD i = 0; i < got; i++)
+				switch(rec[i].EventType) {
+				case KEY_EVENT:
+					EncodeKey(rec[i].Event.KeyEvent);
+					break;
+				case WINDOW_BUFFER_SIZE_EVENT:
+					resized = true;
+					break;
+				default:
+					// FOCUS_EVENT / MENU_EVENT are documented as ignorable.
+					// MOUSE_EVENT: the mouse phase adds SGR 1006 encoding here;
+					// until then ENABLE_MOUSE_INPUT stays off and none arrive.
+					break;
+				}
+		}
+		if(resized)
+			QuerySize();
+		return consumed;
+	}
+
+	#endif
+
+	// ---- capability detection (order: environment, Windows build, queries) ----
+
+	static int WindowsBuild()
+	{
+		#ifdef PLATFORM_WIN32
+		static int build = -1;
+		if(build < 0) {
+			build = 0;
+			HMODULE m = LoadLibrary("ntdll.dll");
+			if(m) {
+				// RtlGetVersion fills dwBuildNumber; modern consoles gate VT
+				// behaviour on Windows 10 build numbers, old headers lack the
+				// entry point, so resolve it dynamically.
+				typedef LONG (WINAPI *Fn)(OSVERSIONINFOEX*);
+				Fn fn = (Fn)GetProcAddress(m, "RtlGetVersion");
+				OSVERSIONINFOEX vi;
+				Zero(vi);
+				vi.dwOSVersionInfoSize = sizeof(vi);
+				if(fn && fn(&vi) == 0)
+					build = (int)vi.dwBuildNumber;
+				FreeLibrary(m);
+			}
+		}
+		return build;
+		#else
+		return 0;
+		#endif
+	}
+
+	String Query(const String& q, int ms)
+	{
+		// Best-effort sequence probe: send the query, collect reply bytes for
+		// up to ms, stop early once the terminal goes quiet. Never blocks
+		// startup indefinitely.
+		Put(q);
+		Sync();
+		String ans;
+		int t0 = msecs();
+		while(msecs(t0) < ms) {
+			if(!WaitInput(20))
+				continue;
+			String r = ReadInput();
+			if(!r.GetCount())
+				continue;
+			ans.Cat(r);
+			// One probe at a time: a quiet poll after data means the reply ended.
+			if(WaitInput(40))
+				ans.Cat(ReadInput());
+			break;
+		}
+		return ans;
+	}
+
+	void DetectCapabilities()
+	{
+		// CtrlCoreTUI 06/02: Ctrl always wants mouse events, so tracking is
+		// on for the app's lifetime by default (plan doc's own "in practice
+		// tracking is on... document the Shift bypass") -- UPP_TUI_MOUSE=0
+		// is the opt-out for a terminal with no such bypass. Was left at
+		// TuiCapabilities' own default (false, i.e. opt-in) through phase
+		// 01/02, backwards from this task's intent; ApplyOverrides() below
+		// still lets UPP_TUI_MOUSE override either way.
+		caps.mouse = true;
+
+		String t = GetEnv("COLORTERM");
+		if(t == "truecolor" || t == "24bit")
+			caps.colors = 1 << 24;
+		t = GetEnv("TERM_PROGRAM");
+		if(t == "iTerm.app" || t == "WezTerm" || t == "ghostty")
+			caps.colors = 1 << 24;
+		if(GetEnv("WT_SESSION").GetCount()) {
+			caps.colors      = 1 << 24;
+			caps.win32_input = true;
+			caps.sync_output = true; // Windows Terminal has honored mode 2026 since 1.18
+		}
+		if(GetEnv("KITTY_WINDOW_ID").GetCount()) {
+			caps.colors      = 1 << 24;
+			caps.kitty_keys  = true;
+			caps.kitty_gfx   = true;
+			caps.sync_output = true;
+		}
+		if(Atoi(GetEnv("VTE_VERSION")) > 0) {
+			caps.colors     = 1 << 24;
+			caps.blocks_2x3 = true;
+		}
+		if(t == "WezTerm" || t == "ghostty")
+			caps.sync_output = true;
+		if(WindowsBuild() >= 10000)
+			caps.colors = max(caps.colors, 1 << 24); // Win10 conhost: 24-bit
+		// Unsupported terminals treat CSI ?2026h/l as an unknown private mode
+		// and ignore it, so a false positive here costs nothing; only a
+		// probe-based DECRQM check would be able to raise a false negative,
+		// and that is not worth a round trip for a purely cosmetic guard.
+
+		// Probes only for what the environment has not already resolved.
+		// The terminal may leave them unanswered; we degrade to the guess.
+		if(!caps.osc11_query) {
+			String ans = Query("\x1b]11;?\x07", 100);
+			if(ans.Find("rgb:") >= 0) {
+				caps.osc11_query = true;
+				caps.osc11_bg = ParseOsc11Bg(ans);
+			}
+		}
+		if(!caps.kitty_keys && Query("\x1b[?u", 100).Find("\x1b[?") >= 0)
+			caps.kitty_keys = true;
+
+		ApplyOverrides();
+	}
+
+	static Color ParseOsc11Bg(const String& ans)
+	{
+		int q = ans.Find("rgb:");
+		if(q < 0)
+			return Null;
+		const char *s = ans.Begin() + q + 4;
+		int r = 0, g = 0, b = 0;
+		auto ParseComp = [&](int& val) {
+			val = 0;
+			int digits = 0;
+			while(IsXDigit(*s)) {
+				int h = ctoi(*s++);
+				if(digits < 2)
+					val = (val << 4) | h;
+				digits++;
+			}
+			if(digits == 1)
+				val = (val << 4) | val;
+			if(*s == '/' || *s == '\x07' || *s == '\x1b' || *s == '\0') {
+				if(*s == '/') s++;
+				return true;
+			}
+			return false;
+		};
+		if(ParseComp(r) && ParseComp(g) && ParseComp(b))
+			return Color(r, g, b);
+		return Null;
+	}
+
+	void ApplyOverrides()
+	{
+		String o;
+		if((o = GetEnv("UPP_TUI_COLORS")).GetCount()) {
+			if(o == "truecolor" || o == "24bit") caps.colors = 1 << 24;
+			else if(Atoi(o) == 256)              caps.colors = 256;
+			else if(Atoi(o) == 16)               caps.colors = 16;
+		}
+		if((o = GetEnv("UPP_TUI_MOUSE")).GetCount())         caps.mouse        = o != "0";
+		if((o = GetEnv("UPP_TUI_MOUSE_PIXELS")).GetCount())  caps.mouse_pixels = o != "0";
+		if((o = GetEnv("UPP_TUI_KITTY_KEYS")).GetCount())    caps.kitty_keys   = o != "0";
+		if((o = GetEnv("UPP_TUI_OSC52")).GetCount())         caps.osc52_write  = o != "0";
+		if((o = GetEnv("UPP_TUI_OSC11")).GetCount())         caps.osc11_query  = o != "0";
+		if((o = GetEnv("UPP_TUI_OSC11_BG")).GetCount())      caps.osc11_bg     = ParseOsc11Bg(o);
+		if((o = GetEnv("UPP_TUI_SYNC_OUTPUT")).GetCount())   caps.sync_output  = o != "0";
+	}
+
+	void LogCapabilities()
+	{
+		RLOG("TuiTerminalVT: " << (int)cellsize.cx << 'x' << (int)cellsize.cy
+			<< " cells, " << caps.colors << " colors, mouse=" << (int)!!caps.mouse
+			<< " mouse_pixels=" << (int)!!caps.mouse_pixels << " kitty_keys=" << (int)!!caps.kitty_keys
+			<< " win32_input=" << (int)!!caps.win32_input << " osc52=" << (int)!!caps.osc52_write
+			<< " osc11=" << (int)!!caps.osc11_query << " sixel=" << (int)!!caps.sixel
+			<< " kitty_gfx=" << (int)!!caps.kitty_gfx << " blocks=" << (int)!!caps.blocks_2x2
+			<< '/' << (int)!!caps.blocks_2x3 << '/' << (int)!!caps.blocks_2x4
+			<< " sync_output=" << (int)!!caps.sync_output);
+	}
+
+	// ---- TuiTerminal interface ----
+public:
+	bool Start() override
+	{
+		if(started) return true;
+		#ifdef PLATFORM_WIN32
+		if(!_isatty(0) || !_isatty(1))
+			return false;
+		hin  = GetStdHandle(STD_INPUT_HANDLE);
+		hout = GetStdHandle(STD_OUTPUT_HANDLE);
+		if(!GetConsoleMode(hout, &saved_out_mode))
+			return false;
+		if(!SetConsoleMode(hout, saved_out_mode | ENABLE_VIRTUAL_TERMINAL_PROCESSING
+		                                          | DISABLE_NEWLINE_AUTO_RETURN)) {
+			// VT not available on this console; the legacy implementation
+			// (phase 11) covers this. Fail rather than draw escape garbage.
+			return false;
+		}
+		if(!GetConsoleMode(hin, &saved_in_mode)) {
+			SetConsoleMode(hout, saved_out_mode);
+			return false;
+		}
+		// Raw input: no line editing, no echo, and -- decisively -- no
+		// ENABLE_PROCESSED_INPUT, so Ctrl+C is delivered as a 0x03 key record
+		// instead of a CTRL_C_EVENT that would take the process down. QUICK_EDIT
+		// off stops a stray selection from blocking our writes; WINDOW_INPUT on
+		// gives us resize records; VIRTUAL_TERMINAL_INPUT stays off because we
+		// encode records ourselves (see Drain()).
+		DWORD in_mode = (saved_in_mode | ENABLE_EXTENDED_FLAGS | ENABLE_WINDOW_INPUT)
+		              & ~(DWORD)(ENABLE_LINE_INPUT | ENABLE_ECHO_INPUT | ENABLE_PROCESSED_INPUT
+		                       | ENABLE_QUICK_EDIT_MODE | ENABLE_INSERT_MODE
+		                       | ENABLE_MOUSE_INPUT | ENABLE_VIRTUAL_TERMINAL_INPUT);
+		if(!SetConsoleMode(hin, in_mode)) {
+			RLOG("TuiTerminalVT: SetConsoleMode(stdin) failed, error " << (int)GetLastError());
+			SetConsoleMode(hout, saved_out_mode);
+			return false;
+		}
+		if(!hwake)   // process-lifetime handle: Stop() can run on another thread
+			hwake = CreateEvent(NULL, FALSE, FALSE, NULL);
+		saved_cp_in  = GetConsoleCP();
+		saved_cp_out = GetConsoleOutputCP();
+		SetConsoleOutputCP(CP_UTF8);
+		SetConsoleCP(CP_UTF8);
+		// Exit path 5: the ctrl handler covers window close / logoff / Ctrl+Break
+		// (Ctrl+C no longer reaches it, see the input mode above). The unhandled
+		// exception filter covers crashes; the vectored handler exists only for
+		// stack overflow, which can leave no stack for that filter.
+		SetConsoleCtrlHandler(TuiConsoleCtrlHandler, TRUE);
+		saved_exfilter = SetUnhandledExceptionFilter(TuiUnhandledExceptionFilter);
+		exc_token = AddVectoredExceptionHandler(0, TuiVectoredHandler);
+		#else
+		if(!isatty(in_fd) || !isatty(out_fd))
+			return false;
+		if(pipe(selfpipe) != 0 || fcntl(selfpipe[0], F_SETFL, O_NONBLOCK) != 0 || fcntl(selfpipe[1], F_SETFL, O_NONBLOCK) != 0)
+			return false;
+		if(tcgetattr(in_fd, &saved_term) != 0)
+			return false;
+		struct termios raw = saved_term;
+		cfmakeraw(&raw);
+		raw.c_cc[VMIN]  = 0;   // WaitInput polls; read() must not block
+		raw.c_cc[VTIME] = 0;
+		tcsetattr(in_fd, TCSAFLUSH, &raw);
+		s_instance = this;
+		signal(SIGWINCH, sWinchHandler);
+		// Exit path 4: restore then die with the default disposition. The
+		// SIGABRT row matters after Panic: abort() raises it, and although
+		// Stop() already ran through InstallPanicBox, the idempotent no-op
+		// keeps the terminal clean even if the panic hook was never installed.
+		signal(SIGSEGV, sFatalHandler);
+		signal(SIGABRT, sFatalHandler);
+		signal(SIGBUS,  sFatalHandler);
+		signal(SIGTERM, sFatalHandler);
+		signal(SIGHUP,  sFatalHandler);
+		signal(SIGINT,  sFatalHandler);
+		#endif
+		QuerySize();
+		started = true;          // capability probes below must be able to
+		DetectCapabilities();    // WaitInput()/ReadInput(), which need 'started'
+		// Late probe replies (and whatever the shell left behind when it handed
+		// us the console) would otherwise surface as a phantom first keypress.
+		#ifdef PLATFORM_WIN32
+		inq.Clear();
+		FlushConsoleInputBuffer(hin);
+		#else
+		tcflush(in_fd, TCIFLUSH);
+		#endif
+		SetRestoreBytes(LeaveSequence());
+		Put(EnterSequence());
+		Sync();
+		LogCapabilities();
+		return true;
+	}
+
+	void SetRestoreBytes(const String& s)
+	{
+		restore_len = min(s.GetCount(), (int)sizeof(restore_buf));
+		memcpy(restore_buf, ~s, restore_len);
+		ASSERT(restore_len == s.GetCount());   // grow restore_buf if this trips
+	}
+
+public:
+	// atexit only, never from a signal or ctrl handler: frees the decoded-input
+	// buffer so the never-destroyed object holds no heap at process exit.
+	void ReleaseBuffers()
+	{
+		#ifdef PLATFORM_WIN32
+		inq = String();
+		#endif
+	}
+
+private:
+
+	void Stop() override
+	{
+		if(!started) return;
+		started = false;
+		#ifdef PLATFORM_WIN32
+		_write(1, restore_buf, restore_len);
+		SetConsoleMode(hin,  saved_in_mode);
+		SetConsoleMode(hout, saved_out_mode);
+		SetConsoleCP(saved_cp_in);
+		SetConsoleOutputCP(saved_cp_out);
+		if(exc_token)
+			RemoveVectoredExceptionHandler(exc_token);
+		exc_token = NULL;
+		SetUnhandledExceptionFilter(saved_exfilter);
+		saved_exfilter = NULL;
+		SetConsoleCtrlHandler(TuiConsoleCtrlHandler, FALSE);
+		#else
+		write(out_fd, restore_buf, restore_len);
+		tcsetattr(in_fd, TCSAFLUSH, &saved_term);
+		s_instance = NULL;
+		signal(SIGWINCH, SIG_DFL);
+		signal(SIGSEGV, SIG_DFL);
+		signal(SIGABRT, SIG_DFL);
+		signal(SIGBUS,  SIG_DFL);
+		signal(SIGTERM, SIG_DFL);
+		signal(SIGHUP,  SIG_DFL);
+		signal(SIGINT,  SIG_DFL);
+		#endif
+	}
+
+	const TuiCapabilities& GetCapabilities() const override
+	{
+		return caps;
+	}
+
+	Size GetCellSize() override
+	{
+		return cellsize;
+	}
+
+	void Put(const String& bytes) override
+	{
+		if(started && bytes.GetCount()) {
+			#ifdef PLATFORM_WIN32
+			_write(1, ~bytes, (int)bytes.GetCount());
+			#else
+			write(out_fd, ~bytes, (int)bytes.GetCount());
+			#endif
+		}
+	}
+
+	void Sync() override
+	{
+		// Write-through: nothing buffered. Phase 02 wraps flushes in
+		// CSI ?2026h/l (synchronised output) where caps allow.
+	}
+
+	void SetCursor(Point cell, bool visible) override
+	{
+		if(!started) return;
+		String s;
+		s << "\x1b[" << (cell.y + 1) << ';' << (cell.x + 1) << 'H';
+		if(visible) s << "\x1b[?25h";
+		else        s << "\x1b[?25l";
+		Put(s);
+	}
+
+	bool WaitInput(int ms) override
+	{
+		if(!started) return false;
+		#ifdef PLATFORM_WIN32
+		if(inq.GetCount())
+			return true;
+		int t0 = msecs();
+		for(;;) {
+			HANDLE h[2] = { hin, hwake };
+			DWORD  wait = INFINITE;
+			if(ms >= 0) {
+				int left = ms - msecs(t0);
+				if(left <= 0)
+					return false;
+				wait = (DWORD)left;
+			}
+			DWORD r = WaitForMultipleObjects(hwake ? 2 : 1, h, FALSE, wait);
+			if(r == WAIT_OBJECT_0 + 1)
+				return false;              // WakeUp()
+			if(r != WAIT_OBJECT_0)
+				return false;              // timeout or failure
+			// hin is signalled by any record, including ones that carry no
+			// bytes (key-up, focus). Drain decides; if it was only noise, keep
+			// waiting instead of reporting readiness ReadInput cannot honour.
+			bool resized = false;
+			int  n = Drain(resized);
+			if(inq.GetCount() || resized)
+				return true;               // GetCellSize() is fresh on resize
+			if(n == 0)
+				Sleep(10);                 // signalled but unreadable: no hot spin
+		}
+		#else
+		struct pollfd fds[2] = { { in_fd, POLLIN, 0 }, { selfpipe[0], POLLIN, 0 } };
+		if(poll(fds, 2, ms) < 0)
+			return false;
+		if(fds[1].revents & POLLIN) {
+			char c[16];
+			while(read(selfpipe[0], c, sizeof(c)) > 0) ;   // drain
+			if(winch) {
+				winch = 0;
+				QuerySize();
+				return true;
+			}
+			return false;                                  // plain WakeUp
+		}
+		return (fds[0].revents & POLLIN) != 0;
+		#endif
+	}
+
+	String ReadInput() override
+	{
+		if(!started) return String();
+		String s;
+		#ifdef PLATFORM_WIN32
+		bool resized = false;
+		Drain(resized);                // non-blocking; ReadInput() never waits
+		s = inq;
+		inq.Clear();
+		#else
+		char buf[4096];
+		int  n = read(in_fd, buf, sizeof(buf));
+		if(n > 0)
+			s = String(buf, n);
+		#endif
+		return s;
+	}
+
+	void WakeUp() override
+	{
+		#ifdef PLATFORM_WIN32
+		if(hwake)
+			SetEvent(hwake);
+		#else
+		wakeup = true;
+		write(selfpipe[1], "W", 1);       // non-blocking; full pipe is fine
+		#endif
+	}
+};
+
+#ifdef PLATFORM_WIN32
+
+// Exit path 5a. Runs on a dedicated thread created for this purpose, so
+// SetConsoleMode/SetConsoleCP are legal here. Returning FALSE means "not
+// handled": Windows then runs the default action (typically process exit),
+// which is what we want -- this handler only restores first. Ctrl+C does not
+// arrive here any more now that ENABLE_PROCESSED_INPUT is off; window close,
+// logoff, shutdown and Ctrl+Break still do.
+static BOOL WINAPI TuiConsoleCtrlHandler(DWORD)
+{
+	TheTuiTerminal().Stop();
+	return FALSE;
+}
+
+// Exit path 5b. Only genuinely unhandled exceptions reach a top-level filter,
+// so the terminal survives the SEH and C++ throws that normal code recovers
+// from. EXCEPTION_CONTINUE_SEARCH keeps the default post-mortem behaviour.
+static LONG WINAPI TuiUnhandledExceptionFilter(EXCEPTION_POINTERS*)
+{
+	TheTuiTerminal().Stop();
+	return EXCEPTION_CONTINUE_SEARCH;
+}
+
+// Exit path 5c. A vectored handler sees every exception first-chance, so it is
+// deliberately narrowed to stack overflow: that one can leave no usable stack
+// for the top-level filter above. Everything else is left to 5b.
+static LONG WINAPI TuiVectoredHandler(EXCEPTION_POINTERS *p)
+{
+	if(p && p->ExceptionRecord && p->ExceptionRecord->ExceptionCode == EXCEPTION_STACK_OVERFLOW)
+		TheTuiTerminal().Stop();
+	return EXCEPTION_CONTINUE_SEARCH;
+}
+
+#else
+
+TuiTerminalVT *TuiTerminalVT::s_instance;
+
+void TuiTerminalVT::sWinchHandler(int)
+{
+	TuiTerminalVT *t = s_instance;
+	if(t) {
+		t->winch = 1;
+		write(t->selfpipe[1], "W", 1);    // async-signal-safe: sig_atomic_t + write
+	}
+}
+
+// Exit path 4: SIGSEGV/SIGABRT/SIGBUS/SIGTERM/SIGHUP/SIGINT. Restore the
+// terminal, then die with the default disposition so exit status / core dumps
+// are preserved. Stop() and raise() are async-signal-safe.
+void TuiTerminalVT::sFatalHandler(int sig)
+{
+	TuiTerminalVT *t = s_instance;
+	if(t)
+		t->Stop();
+	signal(sig, SIG_DFL);
+	raise(sig);
+}
+
+#endif
+
+TuiTerminalVT& GetTuiTerminalVT()
+{
+	alignas(TuiTerminalVT) static byte storage[sizeof(TuiTerminalVT)];
+	static TuiTerminalVT *term;
+	if(!term)
+		term = new(storage) TuiTerminalVT;
+	return *term;
+}
+
+// Dispatcher that selects between VT and Windows Console API implementations.
+// Controlled via UPP_TUI_BACKEND=vt|console, with automatic fallback from VT
+// to Windows Console API on failure (e.g. legacy Windows hosts where
+// ENABLE_VIRTUAL_TERMINAL_PROCESSING is rejected).
+class TuiTerminalDispatcher : public TuiTerminal {
+private:
+	TuiTerminal *active = nullptr;
+
+	TuiTerminal* GetActive()
+	{
+		TuiTerminal *ov = GetTuiTerminalOverride();
+		if(ov) {
+			if(active != ov) {
+				if(active) active->Stop();
+				active = ov;
+				active->Start();
+			}
+			return active;
+		}
+		if(active)
+			return active;
+		Start();
+		return active;
+	}
+
+public:
+	bool Start() override
+	{
+		TuiTerminal *ov = GetTuiTerminalOverride();
+		if(ov) {
+			if(active != ov) {
+				if(active) active->Stop();
+				active = ov;
+			}
+			return active->Start();
+		}
+
+		if(active)
+			return true;
+
+		String backend = ToLower(GetEnv("UPP_TUI_BACKEND"));
+		if(backend == "headless") {
+			if(GetTuiTerminalHeadless().Start()) {
+				active = &GetTuiTerminalHeadless();
+				return true;
+			}
+			return false;
+		}
+		if(backend == "console" || backend == "wincon") {
+			if(GetTuiTerminalWinConsole().Start()) {
+				active = &GetTuiTerminalWinConsole();
+				return true;
+			}
+			return false;
+		}
+		if(backend == "vt") {
+			if(GetTuiTerminalVT().Start()) {
+				active = &GetTuiTerminalVT();
+				return true;
+			}
+			return false;
+		}
+
+		// Default: try VT first
+		if(GetTuiTerminalVT().Start()) {
+			active = &GetTuiTerminalVT();
+			return true;
+		}
+
+		// Fallback to legacy Windows Console API driver
+		if(GetTuiTerminalWinConsole().Start()) {
+			active = &GetTuiTerminalWinConsole();
+			return true;
+		}
+
+		// Fallback to headless in-memory terminal driver (e.g. non-tty, pipe, background execution)
+		if(GetTuiTerminalHeadless().Start()) {
+			active = &GetTuiTerminalHeadless();
+			return true;
+		}
+
+		return false;
+	}
+
+	void Stop() override
+	{
+		if(active) {
+			active->Stop();
+			active = nullptr;
+		}
+	}
+
+	const TuiCapabilities& GetCapabilities() const override
+	{
+		static TuiCapabilities defcaps;
+		TuiTerminal *a = const_cast<TuiTerminalDispatcher*>(this)->GetActive();
+		return a ? a->GetCapabilities() : defcaps;
+	}
+
+	Size GetCellSize() override
+	{
+		TuiTerminal *a = GetActive();
+		return a ? a->GetCellSize() : Size(80, 25);
+	}
+
+	void Put(const String& bytes) override
+	{
+		TuiTerminal *a = GetActive();
+		if(a) a->Put(bytes);
+	}
+
+	void Sync() override
+	{
+		TuiTerminal *a = GetActive();
+		if(a) a->Sync();
+	}
+
+	void SetCursor(Point cell, bool visible) override
+	{
+		TuiTerminal *a = GetActive();
+		if(a) a->SetCursor(cell, visible);
+	}
+
+	bool WaitInput(int ms) override
+	{
+		TuiTerminal *a = GetActive();
+		return a ? a->WaitInput(ms) : false;
+	}
+
+	String ReadInput() override
+	{
+		TuiTerminal *a = GetActive();
+		return a ? a->ReadInput() : String();
+	}
+
+	void WakeUp() override
+	{
+		TuiTerminal *a = GetActive();
+		if(a) a->WakeUp();
+	}
+
+	bool PutCells(const TuiScreen& screen, const Vector<Rect>& dirty) override
+	{
+		TuiTerminal *a = GetActive();
+		return a ? a->PutCells(screen, dirty) : false;
+	}
+
+	TuiTerminal* GetActive() const { return active; }
+};
+
+static TuiTerminalDispatcher *sDispatcher;
+
+TuiTerminal& TheTuiTerminal()
+{
+	alignas(TuiTerminalDispatcher) static byte storage[sizeof(TuiTerminalDispatcher)];
+	if(!sDispatcher)
+		sDispatcher = new(storage) TuiTerminalDispatcher;
+	return *sDispatcher;
+}
+
+// Exit paths 1 + 2 (normal exit, Ctrl::EndSession / Exit()): both wind up in
+// main() returning, which runs atexit() handlers. Stop() is a no-op if never
+// started, so a GUI-less/backend-less binary never notices.
+static void TuiTerminalAtexitExit()
+{
+	if(!sDispatcher)
+		return;
+	sDispatcher->Stop();
+	GetTuiTerminalVT().ReleaseBuffers();
+	GetTuiTerminalWinConsole().ReleaseBuffers();
+}
+
+EXITBLOCK {
+	TuiTerminalAtexitExit();
+}
+
+END_UPP_NAMESPACE
+
+#endif
