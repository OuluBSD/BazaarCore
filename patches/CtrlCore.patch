+// CtrlCoreTUI 06/01 (gate_input, keyboard half): decode terminal input bytes
+// into U++ K_* key codes and dispatch them. Declarations shared with
+// TuiWnd.cpp (the event loop calls in here once per turn).
+
+#ifndef _CtrlCore_TuiKbd_h_
+#define _CtrlCore_TuiKbd_h_
+
+NAMESPACE_UPP
+
+// Decodes and dispatches whatever TheTuiTerminal() has buffered. Called once
+// per event-loop turn from Ctrl::ProcessEvent (TuiWnd.cpp). Returns true if
+// anything was dispatched (key, paste, focus change) or a pending escape
+// timed out.
+bool TuiProcessInput();
+
+// Milliseconds remaining before a currently-pending, ambiguous lone ESC must
+// be resolved (delivered as K_ESCAPE) if nothing else arrives; -1 if nothing
+// is pending. Ctrl::GuiSleep (TuiWnd.cpp) shortens its wait to this so Esc
+// does not feel laggier than UPP_TUI_ESC_DELAY promises.
+int TuiPendingEscDeadlineMs();
+
+// CSI ?1004h focus reporting (CSI I / CSI O): whether the terminal emulator
+// itself currently has OS focus. Distinct from Ctrl::IsWndForeground (phase
+// 05, which is about which *internal* window/popup is topmost) -- this is
+// about the host terminal window, and Ctrl::DoPaint (TuiCtrl.cpp) uses it to
+// stop the caret blinking (force it hidden) when the terminal is unfocused,
+// same as any native backend does.
+bool TuiTerminalHasFocus();
+
+// Feeds raw VT bytes directly into the parser (for testing / simulated input).
+void TuiFeedInput(const String& bytes);
+
+// Feeds a key event directly into dispatch (for testing / simulated input).
+void TuiFeedKey(dword key);
+
+END_UPP_NAMESPACE
+
+#endif
