+void TuiPaintBoxBorder(Draw& w, const Rect& r, Color color)
+{
+	if(IsNull(color))
+		return;
+	Size cell = TuiCellSize();
+	int cols = r.GetWidth() / cell.cx;
+	int rows = r.GetHeight() / cell.cy;
+	if(cols < 1 || rows < 1)
+		return;
+
+	int x1 = r.left;
+	int y1 = r.top;
+	int x2 = r.left + (cols - 1) * cell.cx;
+	int y2 = r.top + (rows - 1) * cell.cy;
+	Font fnt = StdFont();
+
+	if(cols == 1 && rows == 1) {
+		w.DrawText(x1, y1, WString((wchar)0x25A1, 1), fnt, color); // □
+		return;
+	}
+	if(cols == 1) {
+		for(int y = y1; y <= y2; y += cell.cy)
+			w.DrawText(x1, y, WString((wchar)0x2502, 1), fnt, color);
+		return;
+	}
+	if(rows == 1) {
+		w.DrawText(x1, y1, WString((wchar)0x2500, cols), fnt, color);
+		return;
+	}
+
+	// 4 corners
+	w.DrawText(x1, y1, WString((wchar)0x250C, 1), fnt, color); // ┌
+	w.DrawText(x2, y1, WString((wchar)0x2510, 1), fnt, color); // ┐
+	w.DrawText(x1, y2, WString((wchar)0x2514, 1), fnt, color); // └
+	w.DrawText(x2, y2, WString((wchar)0x2518, 1), fnt, color); // ┘
+
+	// top and bottom horizontal runs
+	if(cols > 2) {
+		WString horiz((wchar)0x2500, cols - 2);
+		w.DrawText(x1 + cell.cx, y1, horiz, fnt, color);
+		w.DrawText(x1 + cell.cx, y2, horiz, fnt, color);
+	}
+
+	// left and right vertical edges
+	for(int y = y1 + cell.cy; y < y2; y += cell.cy) {
+		w.DrawText(x1, y, WString((wchar)0x2502, 1), fnt, color);
+		w.DrawText(x2, y, WString((wchar)0x2502, 1), fnt, color);
+	}
+}
