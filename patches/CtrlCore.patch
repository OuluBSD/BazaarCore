+// CtrlCoreTUI 06/01: real VT input decoding lives in TuiKbd.cpp
+// (TuiProcessInput), applied to a persistent VTInStream so a multi-byte
+// character or escape sequence split across two ReadInput() calls just
+// carries over in the parser's own state.
+//
+// Ctrl+C policy (superseding phase 05's interim placeholder, which said
+// explicitly that this was expected): Ctrl+C (0x03) is now dispatched as an
+// ordinary K_CTRL|'C' key event to the focused Ctrl -- GUI semantics, per
+// this task's plan doc's own recommendation ("deliver Ctrl+C to the app...
+// do not silently swallow it"). It no longer force-quits a loop level by
+// itself. The escape hatch for a hung app is the panic key (TuiKbd.cpp,
+// default Ctrl+Alt+Q), which calls Ctrl::EndSession() -- made real in
+// TuiCtrl.h for exactly this -- ending every nested Ctrl::EventLoop.
+bool Ctrl::ProcessEvent(bool *quit)
+{
+	ASSERT(IsMainThread());
+	bool did = TuiSyncResize();
+	if(TuiProcessInput())
+		did = true;
+	return did;
+}
+
+bool Ctrl::ProcessEvents(bool *quit)
+{
+	bool any = false;
+	if(ProcessEvent(quit)) {
+		any = true;
+		while(ProcessEvent(quit) && (!LoopCtrl || LoopCtrl->InLoop()))
+			;
+	}
+	TimerProc(msecs());
+	SweepMkImageCache();
+	DoPaint(); // paint (if invalid) + caret sync + exactly one Flush() per turn
+	static bool sFirstDump = false;
+	if(!sFirstDump) {
+		sFirstDump = true;
+		TuiDumpPeriodicSnapshot();
+	}
+	return any;
+}
+
+Ctrl::EventLoopContext Ctrl::EventLoopBegin(Ctrl *ctrl)
+{
+	GuiLock __;
+	ASSERT(IsMainThread());
+	ASSERT(LoopLevel == 0 || ctrl);
+
+	EventLoopContext ctx;
+	ctx.ctrl = ctrl;
+	ctx.quit = false;
+
+	LoopLevel++;
+	LLOG("Entering event loop at level " << LoopLevel);
+
+	if(ctrl) {
+		ctx.prev_loop_ctrl = LoopCtrl;
+		LoopCtrl = ctrl;
+		ctrl->inloop = true;
+	}
+
+	ctx.loop_no = ++EventLoopNo;
+	return ctx;
+}
+
+bool Ctrl::EventLoopIteration(EventLoopContext& ctx)
+{
+	GuiLock __;
+
+	if(ctx.loop_no <= EndSessionLoopNo || ctx.quit)
+		return false;
+
+	if(ctx.ctrl && (!ctx.ctrl->IsOpen() || !ctx.ctrl->InLoop()))
+		return false;
+
+	if(!ctx.ctrl && GetTopCtrls().GetCount() == 0)
+		return false;
+
+	SyncCaret();
+	AnimateCaret();
+	GuiSleep(20);
+	ProcessEvents(&ctx.quit);
+
+	static int64 sLastDumpTime = 0;
+	int64 now = msecs();
+	int interval = Ctrl::TuiGetDumpInterval();
+	if(now - sLastDumpTime >= interval) {
+		sLastDumpTime = now;
+		TuiDumpPeriodicSnapshot();
+	}
+
+	return true;
+}
+
+void Ctrl::EventLoopEnd(EventLoopContext& ctx)
+{
+	GuiLock __;
+
+	if(ctx.ctrl)
+		LoopCtrl = ctx.prev_loop_ctrl;
+
+	LoopLevel--;
+	LLOG("Leaving event loop ");
+}
+
+void Ctrl::EventLoop(Ctrl *ctrl)
+{
+	EventLoopContext ctx = EventLoopBegin(ctrl);
+	ProcessEvents(&ctx.quit);
+	while(EventLoopIteration(ctx))
+		;
+	EventLoopEnd(ctx);
+}
+
+void Ctrl::GuiSleep(int ms)
+{
+	GuiLock __;
+	// The same source EventLoopIteration's caller would use for a timer-
+	// accurate deadline (TimeCallback's own queue) is not consulted here --
+	// a flat poll bound instead, same simplification VirtualGui's own
+	// Skeleton model makes (GuiSleep(1000) there, ours is finer at 20ms
+	// since terminal input is cheap to poll and 20ms is imperceptible for a
+	// TUI). Documented risk (plan's own "Timer accuracy vs. blocking input"),
+	// not silently cut: a busy TimeCallback loop degrades to ~20ms latency,
+	// it does not stall.
+	//
+	// One exception: a pending, ambiguous lone ESC (TuiKbd.cpp) must not
+	// wait the full 20ms if UPP_TUI_ESC_DELAY asked for less, or Esc would
+	// feel laggier than documented.
+	int esc = TuiPendingEscDeadlineMs();
+	if(esc >= 0)
+		ms = min(ms, esc);
+	TheTuiTerminal().WaitInput(ms);
+}
