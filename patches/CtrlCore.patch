+void Ctrl::WndSetPos(const Rect& rect)
+{
+	GuiLock __;
+	// Snapping (plan's own "Snapping" section): a window at an odd pixel
+	// offset would put every child half a cell off, and phase 04's rounding
+	// policy would then round inconsistently across siblings.
+	Size cs = TuiCellSize();
+	Rect snapped(
+		FloorDiv(rect.left, cs.cx) * cs.cx, FloorDiv(rect.top, cs.cy) * cs.cy,
+		CeilDiv(rect.right, cs.cx) * cs.cx, CeilDiv(rect.bottom, cs.cy) * cs.cy);
+	Invalidate();
+	SetWndRect(snapped);
+}
