diff -uNr -x '*.o' -x '*.a' -x '*.obj' CtrlCore_a/TuiKbd.cpp CtrlCore_b/TuiKbd.cpp
--- a/TuiKbd.cpp	1970-01-01 02:00:00.000000000 +0200
+++ b/TuiKbd.cpp	2026-09-15 19:01:43.552590200 +0300
@@ -0,0 +1,510 @@
+#include <CtrlCore/CtrlCore.h>
+
+#if defined(PLATFORM_TUI) && !defined(VIRTUALGUI)
+
+#include "TuiTerminal.h"
+#include "TuiKbd.h"
+#include "TuiMouse.h"
+#include <TerminalCore/TerminalCore.h>
+
+#define LLOG(x) // LOG(x)
+
+NAMESPACE_UPP
+
+// CtrlCoreTUI 06/01 (gate_input, keyboard half): decode VT bytes into K_*
+// dispatch. VTInStream (TerminalCore, phase 02/01) is the same state machine
+// TerminalCtrl uses on a child process's output, applied here to what the
+// terminal writes back to us; its internal FSM state persists across Parse()
+// calls, which is what makes "a multi-byte UTF-8 character or an escape
+// sequence split across two ReadInput() calls" a non-issue for free -- see
+// the plan doc's own "UTF-8 split across reads" risk.
+//
+// What VTInStream does *not* solve is the escape-key/unfinished-sequence
+// ambiguity (a lone 0x1B is indistinguishable from the start of a sequence
+// until either more bytes arrive or a timeout elapses) -- that is a timing
+// decision, not a parsing-state one, and VTInStream exposes no "am I
+// mid-sequence" query. Handled here by holding back a trailing lone ESC
+// ourselves (never even handing it to the parser) until either more bytes
+// arrive (prepended back on) or UPP_TUI_ESC_DELAY elapses (delivered
+// directly as K_ESCAPE, bypassing the parser for that byte entirely).
+//
+// SS3 (ESC O <letter>, unmodified F1-F4 -- TuiTermVT.cpp's own encoder uses
+// it) is not a distinct state in the classic DEC STD-070 parser this file's
+// state machine implements: 'O' (0x4F) falls in the Escape state's own
+// dispatch range, so "ESC O" fires WhenEsc(opcode='O') immediately, and the
+// following letter arrives as a *separate* WhenChr. Handled with a one-shot
+// "expecting an SS3 final byte" flag rather than fighting the parser.
+
+namespace {
+
+// ---- task 4: modifier reporting, decayed --------------------------------
+// GetShift()/GetCtrl()/GetAlt() can only ever report the modifiers carried
+// by the most recently decoded key event -- a VT byte stream has no notion
+// of "shift is currently held with nothing else pressed" the way a native
+// backend's OS event carries live modifier state. Decayed after
+// MOD_DECAY_MS so a modifier from minutes ago doesn't read as still held;
+// this is a documented limitation (plan's "no modifier *state*"), not a
+// bug -- a TUI app must not rely on these for anything beyond "was the key
+// just dispatched modified".
+const int MOD_DECAY_MS = 400;
+
+dword sMods;
+int64 sModsTime;
+bool  sTerminalFocused = true;
+
+void NoteMods(dword mods)
+{
+	sMods = mods;
+	sModsTime = msecs();
+}
+
+dword CurrentMods()
+{
+	return sMods && msecs() - sModsTime < MOD_DECAY_MS ? sMods : 0;
+}
+
+int EscDelayMs()
+{
+	static int ms;
+	ONCELOCK {
+		ms = Atoi(GetEnv("UPP_TUI_ESC_DELAY"));
+		if(ms <= 0)
+			ms = 25;
+	}
+	return ms;
+}
+
+int PanicKeyMods()
+{
+	// UPP_TUI_PANIC_KEY="ctrl+alt+<letter>" overrides the letter only (the
+	// modifier combination itself is fixed -- it exists specifically to be
+	// a combination unlikely to collide with any app accelerator).
+	return K_CTRL | K_ALT;
+}
+
+dword PanicKeyLetter()
+{
+	static dword letter;
+	ONCELOCK {
+		String o = GetEnv("UPP_TUI_PANIC_KEY");
+		letter = o.GetCount() ? (dword)ToUpper(o[0]) : (dword)'Q';
+	}
+	return letter;
+}
+
+#ifdef PLATFORM_POSIX
+static void sTuiSuspend()
+{
+	TheTuiTerminal().Stop();
+	signal(SIGTSTP, SIG_DFL);
+	raise(SIGTSTP);
+	TheTuiTerminal().Start();
+	Ctrl::TuiSyncResize();
+	Ctrl::Invalidate();
+}
+#endif
+
+void Dispatch(dword keycode, dword mods, bool synth_keyup = true)
+{
+	dword full = keycode | mods;
+	NoteMods(mods);
+	if(mods == PanicKeyMods() && keycode == PanicKeyLetter()) {
+		// Escape hatch for a hung app
+		Ctrl::EndSession();
+		return;
+	}
+#ifdef PLATFORM_POSIX
+	if(full == K_CTRL_Z) {
+		sTuiSuspend();
+		return;
+	}
+#endif
+	if(full == K_CTRL_Q) {
+		// Universal terminal quit shortcut: if unhandled by app, exit session
+		if(!Ctrl::TuiDispatchKey(full, 1, synth_keyup)) {
+			Ctrl::EndSession();
+			return;
+		}
+		return;
+	}
+	Ctrl::TuiDispatchKey(full, 1, synth_keyup);
+}
+
+// ---- bracketed paste (CSI ?2004h wraps CSI 200~ ... CSI 201~) -----------
+
+bool    sPasting;
+WString sPasteBuf;
+
+void FinishPaste()
+{
+	sPasting = false;
+	if(sPasteBuf.GetCount()) {
+		// Same path a real Ctrl+V takes (clipboard + the accelerator), so
+		// whichever focused widget handles paste doesn't need a second
+		// code path for "pasted text arrived as bytes instead of via the
+		// system clipboard". Delivered as one operation, not per-character,
+		// so auto-indent/auto-complete don't mangle it (plan's own point).
+		// Suppress OSC 52 write so pasted text is not echoed back out to terminal.
+		TuiSuppressOsc52(true);
+		WriteClipboardUnicodeText(sPasteBuf);
+		if(IsTuiPasteFileDropEnabled()) {
+			String text = TrimBoth(sPasteBuf.ToString());
+			if(text.StartsWith("'") && text.EndsWith("'"))
+				text = text.Mid(1, text.GetCount() - 2);
+			else if(text.StartsWith("\"") && text.EndsWith("\""))
+				text = text.Mid(1, text.GetCount() - 2);
+			if(FileExists(text) || DirectoryExists(text)) {
+				String h = String("file://") + UrlEncode(text) + "\n";
+				AppendClipboard("files", h);
+			}
+		}
+		TuiSuppressOsc52(false);
+		Dispatch(K_CTRL_V, 0);
+	}
+	sPasteBuf.Clear();
+}
+
+// ---- the decoder itself --------------------------------------------------
+
+VTInStream sParser;
+bool       sExpectSS3Final;
+bool       sHavePendingEsc;
+int64      sPendingEscTime;
+
+dword ModBitsFromXtermParam(int m)
+{
+	dword mods = 0;
+	if(m > 1) {
+		int bits = m - 1;
+		if(bits & 1) mods |= K_SHIFT;
+		if(bits & 2) mods |= K_ALT;
+		if(bits & 4) mods |= K_CTRL;
+	}
+	return mods;
+}
+
+void OnChr(int chr)
+{
+	if(sExpectSS3Final) {
+		sExpectSS3Final = false;
+		switch(chr) {
+		case 'P': Dispatch(K_F1, 0); return;
+		case 'Q': Dispatch(K_F2, 0); return;
+		case 'R': Dispatch(K_F3, 0); return;
+		case 'S': Dispatch(K_F4, 0); return;
+		default: break; // not actually an SS3 final; fall through as a plain char
+		}
+	}
+	if(sPasting) {
+		sPasteBuf.Cat(chr);
+		return;
+	}
+	// Baseline table: "Printable UTF-8 -> the Unicode codepoint". Shift is
+	// already baked into the character by the terminal (Shift+a arrives as
+	// 'A'), so no modifier bits are added here.
+	Dispatch((dword)chr, 0);
+}
+
+void OnCtl(byte c)
+{
+	if(sPasting) {
+		if(c == '\r' || c == '\n')
+			sPasteBuf.Cat('\n');
+		return; // drop other control bytes inside a paste rather than guess
+	}
+	switch(c) {
+	case 0x0D: Dispatch(K_ENTER, 0); return;
+	case 0x09: Dispatch(K_TAB, 0); return;
+	case 0x7F:
+	case 0x08: Dispatch(K_BACKSPACE, 0); return;
+	default:
+		if(c >= 1 && c <= 26) { // Ctrl+A..Z (baseline table)
+			Dispatch(K_A + c - 1, K_CTRL);
+			return;
+		}
+		// Other C0 controls (NUL, etc.): nothing sensible to deliver.
+		break;
+	}
+}
+
+void OnEsc(const VTInStream::Sequence& seq)
+{
+	if(seq.opcode == 'O') {
+		sExpectSS3Final = true;
+		return;
+	}
+	// "ESC <char>" -> Alt+char (baseline table). Alt vs Meta vs ESC-prefix
+	// (plan's own Risk note): this backend's paired encoder (TuiTermVT.cpp)
+	// always uses the ESC-prefix form, so that is what is handled as
+	// primary; a terminal that instead sets the high bit would arrive as a
+	// single byte >= 0x80, which OnChr's UTF-8 decoding already turns into
+	// the intended codepoint (accepting "the other form" without special-
+	// casing it).
+	if(seq.opcode >= 'a' && seq.opcode <= 'z')
+		Dispatch(K_A + (seq.opcode - 'a'), K_ALT);
+	else if(seq.opcode >= 'A' && seq.opcode <= 'Z')
+		Dispatch(K_A + (seq.opcode - 'A'), K_ALT);
+	else if(seq.opcode >= '0' && seq.opcode <= '9')
+		Dispatch(K_0 + (seq.opcode - '0'), K_ALT);
+	else if(seq.opcode >= 0x20 && seq.opcode < 0x7F)
+		Dispatch((dword)seq.opcode, K_ALT);
+}
+
+void TuiHandleWin32KeyCsi(const VTInStream::Sequence& seq)
+{
+	// win32-input-mode: CSI vk ; sc ; uc ; kd ; cs ; rc _
+	int vk = StrInt(seq.GetStr(1));
+	int sc = StrInt(seq.GetStr(2));
+	int uc = StrInt(seq.GetStr(3));
+	int kd = StrInt(seq.GetStr(4));
+	int cs = StrInt(seq.GetStr(5));
+	int rc = StrInt(seq.GetStr(6));
+	if(rc < 1) rc = 1;
+
+	dword mods = 0;
+	if(cs & 0x0010) mods |= K_SHIFT;
+	if(cs & (0x0004 | 0x0008)) mods |= K_CTRL;
+	if(cs & (0x0001 | 0x0002)) mods |= K_ALT;
+
+	dword key = 0;
+	// Modifiers alone
+	if(vk == 0x10 || vk == 0xA0 || vk == 0xA1)      key = K_SHIFT_KEY;
+	else if(vk == 0x11 || vk == 0xA2 || vk == 0xA3) key = K_CTRL_KEY;
+	else if(vk == 0x12 || vk == 0xA4 || vk == 0xA5) key = K_ALT_KEY;
+	else if(vk == 0x14)                             key = K_CAPSLOCK;
+	// Special keys
+	else if(vk == 0x08) key = K_BACKSPACE;
+	else if(vk == 0x09) key = K_TAB;
+	else if(vk == 0x0D) key = K_ENTER;
+	else if(vk == 0x1B) key = K_ESCAPE;
+	else if(vk == 0x20) key = K_SPACE;
+	else if(vk == 0x21) key = K_PAGEUP;
+	else if(vk == 0x22) key = K_PAGEDOWN;
+	else if(vk == 0x23) key = K_END;
+	else if(vk == 0x24) key = K_HOME;
+	else if(vk == 0x25) key = K_LEFT;
+	else if(vk == 0x26) key = K_UP;
+	else if(vk == 0x27) key = K_RIGHT;
+	else if(vk == 0x28) key = K_DOWN;
+	else if(vk == 0x2D) key = K_INSERT;
+	else if(vk == 0x2E) key = K_DELETE;
+	// Function keys
+	else if(vk >= 0x70 && vk <= 0x7B) key = K_F1 + (vk - 0x70);
+	// Numpad
+	else if(vk >= 0x60 && vk <= 0x69) key = K_NUMPAD0 + (vk - 0x60);
+	else if(vk == 0x6A) key = K_MULTIPLY;
+	else if(vk == 0x6B) key = K_ADD;
+	else if(vk == 0x6C) key = K_SEPARATOR;
+	else if(vk == 0x6D) key = K_SUBTRACT;
+	else if(vk == 0x6E) key = K_DECIMAL;
+	else if(vk == 0x6F) key = K_DIVIDE;
+	// Characters
+	else {
+		if(mods & (K_CTRL | K_ALT)) {
+			if(vk >= 'A' && vk <= 'Z')
+				key = K_A + (vk - 'A');
+			else if(vk >= '0' && vk <= '9')
+				key = K_0 + (vk - '0');
+			else if(uc > 0 && uc < 128) {
+				char u = ToUpper((int)uc);
+				if(u >= 'A' && u <= 'Z')
+					key = K_A + (u - 'A');
+				else if(u >= '0' && u <= '9')
+					key = K_0 + (u - '0');
+				else
+					key = u;
+			}
+			else
+				key = vk;
+		}
+		else {
+			if(uc > 0)
+				key = uc;
+			else if(vk >= 'A' && vk <= 'Z')
+				key = (mods & K_SHIFT) ? vk : ToLower(vk);
+			else if(vk >= '0' && vk <= '9')
+				key = vk;
+			else
+				key = vk;
+		}
+	}
+
+	if(!key)
+		return;
+
+	if(sPasting) {
+		if(kd && uc > 0)
+			sPasteBuf.Cat((wchar)uc);
+		return;
+	}
+
+	if(kd == 0) {
+		Dispatch(key | K_KEYUP, mods, false);
+	}
+	else {
+		for(int i = 0; i < rc; i++)
+			Dispatch(key, mods, false);
+	}
+}
+
+void OnCsi(const VTInStream::Sequence& seq)
+{
+	if(seq.mode == '<') {
+		// SGR mouse report (CSI ?1006h) -- TuiMouse.cpp owns decoding;
+		// TuiKbd.cpp owns the one VTInStream both keyboard and mouse
+		// decoding share.
+		TuiHandleMouseCsi(seq);
+		return;
+	}
+	if(seq.opcode == '_') {
+		TuiHandleWin32KeyCsi(seq);
+		return;
+	}
+	dword mods = ModBitsFromXtermParam(seq.GetInt(2, 1));
+	dword key = 0;
+	switch(seq.opcode) {
+	case 'A': key = K_UP; break;
+	case 'B': key = K_DOWN; break;
+	case 'C': key = K_RIGHT; break;
+	case 'D': key = K_LEFT; break;
+	case 'H': key = K_HOME; break;
+	case 'F': key = K_END; break;
+	case 'P': key = K_F1; break;
+	case 'Q': key = K_F2; break;
+	case 'R': key = K_F3; break;
+	case 'S': key = K_F4; break;
+	case 'I': sTerminalFocused = true; return;  // CSI ?1004h focus in
+	case 'O': sTerminalFocused = false; return; // CSI ?1004h focus out
+	case 'Z': Dispatch(K_TAB, K_SHIFT); return; // CSI Z, Shift+Tab
+	case '~': {
+		int n = seq.GetInt(1, 0);
+		if(n == 200) { sPasting = true; sPasteBuf.Clear(); return; }
+		if(n == 201) { FinishPaste(); return; }
+		switch(n) {
+		case 1: case 7: key = K_HOME; break;
+		case 4: case 8: key = K_END; break;
+		case 2: key = K_INSERT; break;
+		case 3: key = K_DELETE; break;
+		case 5: key = K_PAGEUP; break;
+		case 6: key = K_PAGEDOWN; break;
+		case 15: key = K_F5; break;
+		case 17: key = K_F6; break;
+		case 18: key = K_F7; break;
+		case 19: key = K_F8; break;
+		case 20: key = K_F9; break;
+		case 21: key = K_F10; break;
+		case 23: key = K_F11; break;
+		case 24: key = K_F12; break;
+		default: return; // unrecognised tilde code: drop, don't guess
+		}
+		break;
+	}
+	default: return; // unrecognised CSI final: drop
+	}
+	if(sPasting)
+		return; // a real terminal never interleaves other CSI inside 200~/201~; defensive only
+	Dispatch(key, mods);
+}
+
+void OnOsc(const VTInStream::Sequence& seq)
+{
+	if(seq.payload.StartsWith("52;")) {
+		int pos = seq.payload.Find(';', 3);
+		if(pos >= 0) {
+			String b64 = seq.payload.Mid(pos + 1);
+			String decoded = Base64Decode(b64);
+			TuiSetOsc52ReadResponse(decoded);
+		}
+	}
+}
+
+bool sInit;
+
+void InitParser()
+{
+	if(sInit)
+		return;
+	sInit = true;
+	sParser.WhenChr = OnChr;
+	sParser.WhenCtl = OnCtl;
+	sParser.WhenEsc = OnEsc;
+	sParser.WhenCsi = OnCsi;
+	sParser.WhenOsc = OnOsc;
+}
+
+} // anonymous namespace
+
+bool TuiProcessInput()
+{
+	InitParser();
+	bool did = false;
+
+	if(TheTuiTerminal().WaitInput(0)) {
+		String in = TheTuiTerminal().ReadInput();
+		if(in.GetCount()) {
+			did = true;
+			if(sHavePendingEsc) {
+				sHavePendingEsc = false;
+				in = String("\x1b") + in; // reunite with what arrives next
+			}
+			if((byte)in[in.GetCount() - 1] == 0x1b) {
+				// Trailing lone ESC: withhold it, don't hand it to the
+				// parser yet -- it would sit in EscEntry state with no way
+				// to ask "are you stuck". Everything before it is safe to
+				// parse now.
+				in.Trim(in.GetCount() - 1);
+				sHavePendingEsc = true;
+				sPendingEscTime = msecs();
+			}
+			if(in.GetCount())
+				sParser.Parse(in, true);
+		}
+	}
+
+	if(sHavePendingEsc && msecs() - sPendingEscTime >= EscDelayMs()) {
+		sHavePendingEsc = false;
+		Dispatch(K_ESCAPE, 0);
+		did = true;
+	}
+
+	// CtrlCoreTUI 06/02: coalesced mouse motion (any-event tracking can
+	// report once per cell of movement) flushes at most once per turn, same
+	// as this whole function being called once per turn.
+	if(TuiFlushPendingMotion())
+		did = true;
+
+	return did;
+}
+
+int TuiPendingEscDeadlineMs()
+{
+	if(!sHavePendingEsc)
+		return -1;
+	return max(0, EscDelayMs() - (int)(msecs() - sPendingEscTime));
+}
+
+bool TuiTerminalHasFocus()
+{
+	return sTerminalFocused;
+}
+
+bool  GetShift()    { return CurrentMods() & K_SHIFT; }
+bool  GetCtrl()     { return CurrentMods() & K_CTRL; }
+bool  GetAlt()      { return CurrentMods() & K_ALT; }
+bool  GetCapsLock() { return false; } // no portable VT signal for caps-lock state
+
+void TuiFeedInput(const String& bytes)
+{
+	InitParser();
+	sParser.Parse(bytes, true);
+	TuiFlushPendingMotion();
+}
+
+void TuiFeedKey(dword key)
+{
+	Ctrl::TuiDispatchKey(key, 1);
+}
+
+END_UPP_NAMESPACE
+
+#endif
