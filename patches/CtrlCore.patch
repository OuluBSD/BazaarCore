diff -uNr -x '*.o' -x '*.a' -x '*.obj' CtrlCore_a/TuiFontSys.h CtrlCore_b/TuiFontSys.h
--- a/TuiFontSys.h	1970-01-01 02:00:00.000000000 +0200
+++ b/TuiFontSys.h	2026-09-10 13:29:55.123285900 +0300
@@ -0,0 +1,41 @@
+// CtrlCoreTUI 03/01 (gate_metrics): the synthetic 8x16 monospace font system.
+// Declarations shared across TUI backend files -- TuiFontSys.cpp implements
+// all of this; TuiDraw.cpp (phase 04) is the classifier's first real caller.
+
+#ifndef _CtrlCore_TuiFontSys_h_
+#define _CtrlCore_TuiFontSys_h_
+
+NAMESPACE_UPP
+
+// The logical cell size CtrlLib layout measures against -- NOT the host
+// terminal's real pixel-per-cell size (that is TuiTerminal::GetCellSize(),
+// used for image scaling). Default 8x16; overridable once, at first use, via
+// UPP_TUI_CELL="WxH" (e.g. "10x20", or "1x1" to reproduce a "low resolution"
+// model for experiments). This is the one place in the codebase that knows
+// the cell size -- everything else (TuiFontSys.cpp's metrics, a future
+// TuiDraw.cpp) must derive from it rather than hard-coding 8 or 16.
+Size TuiCellSize();
+
+// Whether a requested Font can be drawn as terminal text. Only face and
+// height can push a font out of CELL_TEXT (attributes -- bold/italic/
+// underline -- map to SGR and never leave it); see the phase 03/01 plan doc.
+enum TuiFontBucket {
+	TUI_FONT_CELL_TEXT, // synthetic face, height == cell height: draw as characters
+	TUI_FONT_RASTER,    // reserved for phase 09's opt-in "super-size" rasterisation;
+	                    // nothing can select this bucket yet, since the opt-in
+	                    // mechanism does not exist until that phase
+	TUI_FONT_ERROR,     // misconfigured for a TUI build: paint as error graphics
+	                    // (or, under UPP_TUI_STRICT_FONTS=0, snap to CELL_TEXT and log)
+};
+
+TuiFontBucket ClassifyTuiFont(Font font);
+
+// Sets Font::AStdFont to the synthetic monospace font and locks it in via
+// Font::SetStdFont (not SetDefaultFont, so std_font_override sticks). Must
+// run before anything touches a Font -- called from GUI_APP_MAIN (TuiGuiA.h),
+// the same point Win32Gui/X11Gui/Gtk/Coco run their own backend init from.
+void TuiInitFontSys();
+
+END_UPP_NAMESPACE
+
+#endif
