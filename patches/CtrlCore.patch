+		if(!m.IsEmpty())
+			TuiRegisterIconGlyph(m.GetSerialId(), glyph, ink);
+	}
+}
+
+void TuiRegisterIconGlyph(const char *iml_name, int i, const char *glyph_utf8, Color ink)
+{
+	TuiRegisterIconGlyph(iml_name, i, ToUtf32(glyph_utf8), ink);
+}
+
+void TuiRegisterNerdFontGlyph(int64 serial, const WString& glyph, Color ink)
+{
+	if(serial == 0 || glyph.IsEmpty())
+		return;
+	TuiIconRecord& rec = s_icon_registry().GetAdd(serial);
+	rec.nerd_glyph.glyph = glyph;
+	rec.nerd_glyph.ink = ink;
