+
+// ---------------------------------------------------------------------------
+// Sub-cell pixel sampling & downsampler
+// ---------------------------------------------------------------------------
+
+static RGBA SampleSubRect(const Image& img, const Rect& r)
+{
+	int left = max(0, min(r.left, img.GetWidth() - 1));
+	int right = max(left + 1, min(r.right, img.GetWidth()));
+	int top = max(0, min(r.top, img.GetHeight() - 1));
+	int bottom = max(top + 1, min(r.bottom, img.GetHeight()));
+
+	int w = right - left;
+	int h = bottom - top;
+
+	int step_x = max(1, w / 4);
+	int step_y = max(1, h / 4);
+
+	int sum_r = 0, sum_g = 0, sum_b = 0, sum_a = 0, count = 0;
+	for(int y = top; y < bottom; y += step_y) {
+		const RGBA *row = img[y];
+		for(int x = left; x < right; x += step_x) {
+			const RGBA& px = row[x];
+			sum_r += px.r;
+			sum_g += px.g;
+			sum_b += px.b;
+			sum_a += px.a;
+			count++;
+		}
+	}
+	if(count == 0)
+		return RGBAZero();
+
+	RGBA res;
+	res.r = sum_r / count;
+	res.g = sum_g / count;
+	res.b = sum_b / count;
+	res.a = sum_a / count;
+	return res;
+}
+
+bool TuiSampleCell(const Image& img, const Rect& src_rect, const Rect& cell_px,
+                   const Rect& dest_px, Color color_tint, int block_mode,
+                   Color background, VTCell& out_cell)
+{
+	int mx = 2, my = 2; // default L2 (2x2)
+	if(block_mode == TUI_BLOCKS_L0) {
+		mx = 1; my = 1;
+	}
+	else if(block_mode == TUI_BLOCKS_L1) {
+		mx = 1; my = 2;
+	}
+	else if(block_mode == TUI_BLOCKS_L3) {
+		mx = 2; my = 3;
+	}
+	else if(block_mode == TUI_BLOCKS_L4 || block_mode == TUI_BLOCKS_BRAILLE) {
+		mx = 2; my = 4;
+	}
+
+	int n_samples = mx * my;
+	RGBA samples[8];
+	int opaque_count = 0;
+	int sum_r = 0, sum_g = 0, sum_b = 0;
+	int min_r = 255, max_r = 0;
+	int min_g = 255, max_g = 0;
+	int min_b = 255, max_b = 0;
+
+	for(int sy = 0; sy < my; sy++) {
+		for(int sx = 0; sx < mx; sx++) {
+			int idx = sy * mx + sx;
+			int qx0 = cell_px.left + sx * cell_px.GetWidth() / mx;
+			int qx1 = cell_px.left + (sx + 1) * cell_px.GetWidth() / mx;
+			int qy0 = cell_px.top + sy * cell_px.GetHeight() / my;
+			int qy1 = cell_px.top + (sy + 1) * cell_px.GetHeight() / my;
+
+			int sx0 = src_rect.left + (int64)(qx0 - dest_px.left) * src_rect.GetWidth() / dest_px.GetWidth();
+			int sx1 = src_rect.left + (int64)(qx1 - dest_px.left) * src_rect.GetWidth() / dest_px.GetWidth();
+			int sy0 = src_rect.top + (int64)(qy0 - dest_px.top) * src_rect.GetHeight() / dest_px.GetHeight();
+			int sy1 = src_rect.top + (int64)(qy1 - dest_px.top) * src_rect.GetHeight() / dest_px.GetHeight();
+
+			RGBA c = SampleSubRect(img, Rect(sx0, sy0, max(sx0 + 1, sx1), max(sy0 + 1, sy1)));
+
+			if(!IsNull(color_tint)) {
+				c.r = (c.r * color_tint.GetR()) / 255;
+				c.g = (c.g * color_tint.GetG()) / 255;
+				c.b = (c.b * color_tint.GetB()) / 255;
+			}
+
+			if(c.a < 255) {
+				if(!IsNull(background)) {
+					c.r = (c.r * c.a + background.GetR() * (255 - c.a)) / 255;
+					c.g = (c.g * c.a + background.GetG() * (255 - c.a)) / 255;
+					c.b = (c.b * c.a + background.GetB() * (255 - c.a)) / 255;
+				}
+			}
+
+			if(c.a >= 24)
+				opaque_count++;
+
+			samples[idx] = c;
+			sum_r += c.r; sum_g += c.g; sum_b += c.b;
+			min_r = min(min_r, (int)c.r); max_r = max(max_r, (int)c.r);
+			min_g = min(min_g, (int)c.g); max_g = max(max_g, (int)c.g);
+			min_b = min(min_b, (int)c.b); max_b = max(max_b, (int)c.b);
+		}
+	}
+
+	if(opaque_count == 0)
+		return false;
+
+	int avg_r = sum_r / n_samples;
+	int avg_g = sum_g / n_samples;
+	int avg_b = sum_b / n_samples;
+
+	// Fast path: flat fill
+	if(max_r - min_r <= 12 && max_g - min_g <= 12 && max_b - min_b <= 12) {
+		out_cell.chr = ' ';
+		out_cell.paper = Color(avg_r, avg_g, avg_b);
+		out_cell.ink = out_cell.paper;
+		out_cell.sgr = 0;
+		return true;
+	}
+
+	if(block_mode == TUI_BLOCKS_L0) {
+		out_cell.chr = ' ';
+		out_cell.paper = Color(avg_r, avg_g, avg_b);
+		out_cell.ink = out_cell.paper;
+		out_cell.sgr = 0;
+		return true;
+	}
+
+	if(block_mode == TUI_BLOCKS_L1) {
+		out_cell.chr = 0x2580; // ▀
+		out_cell.ink = Color(samples[0].r, samples[0].g, samples[0].b);
+		out_cell.paper = Color(samples[1].r, samples[1].g, samples[1].b);
+		out_cell.sgr = 0;
+		return true;
+	}
+
+	if(block_mode == TUI_BLOCKS_BRAILLE) {
+		int lum_avg = 0;
+		for(int i = 0; i < 8; i++)
+			lum_avg += (2 * samples[i].r + 5 * samples[i].g + samples[i].b) >> 3;
+		lum_avg /= 8;
+
+		static const byte s_dot_bits[8] = {
+			0x01, 0x08, // (0,0)=1, (1,0)=4
+			0x02, 0x10, // (0,1)=2, (1,1)=5
+			0x04, 0x20, // (0,2)=3, (1,2)=6
+			0x40, 0x80  // (0,3)=7, (1,3)=8
+		};
+
+		int mask = 0;
+		int dot_r = 0, dot_g = 0, dot_b = 0, dot_cnt = 0;
+		int bg_r = 0, bg_g = 0, bg_b = 0, bg_cnt = 0;
+		for(int i = 0; i < 8; i++) {
+			int lum = (2 * samples[i].r + 5 * samples[i].g + samples[i].b) >> 3;
+			if(lum > lum_avg) {
+				mask |= s_dot_bits[i];
+				dot_r += samples[i].r; dot_g += samples[i].g; dot_b += samples[i].b;
+				dot_cnt++;
+			}
+			else {
+				bg_r += samples[i].r; bg_g += samples[i].g; bg_b += samples[i].b;
+				bg_cnt++;
+			}
+		}
+		out_cell.chr = 0x2800 + mask;
+		out_cell.ink = dot_cnt ? Color(dot_r / dot_cnt, dot_g / dot_cnt, dot_b / dot_cnt) : White();
+		out_cell.paper = bg_cnt ? Color(bg_r / bg_cnt, bg_g / bg_cnt, bg_b / bg_cnt) : Black();
+		out_cell.sgr = 0;
+		return true;
+	}
+
+	if(block_mode == TUI_BLOCKS_L3) {
+		int lum_avg = 0;
+		for(int i = 0; i < 6; i++)
+			lum_avg += (2 * samples[i].r + 5 * samples[i].g + samples[i].b) >> 3;
+		lum_avg /= 6;
+
+		int mask = 0;
+		int dot_r = 0, dot_g = 0, dot_b = 0, dot_cnt = 0;
+		int bg_r = 0, bg_g = 0, bg_b = 0, bg_cnt = 0;
+		for(int i = 0; i < 6; i++) {
+			int lum = (2 * samples[i].r + 5 * samples[i].g + samples[i].b) >> 3;
+			if(lum > lum_avg) {
+				mask |= (1 << i);
+				dot_r += samples[i].r; dot_g += samples[i].g; dot_b += samples[i].b;
+				dot_cnt++;
+			}
+			else {
+				bg_r += samples[i].r; bg_g += samples[i].g; bg_b += samples[i].b;
+				bg_cnt++;
+			}
+		}
+		out_cell.chr = s_L3_glyph[mask & 63];
+		out_cell.ink = dot_cnt ? Color(dot_r / dot_cnt, dot_g / dot_cnt, dot_b / dot_cnt) : White();
+		out_cell.paper = bg_cnt ? Color(bg_r / bg_cnt, bg_g / bg_cnt, bg_b / bg_cnt) : Black();
+		out_cell.sgr = 0;
+		return true;
+	}
+
+	// Universal default: L2 (2x2 quadrants)
+	// Evaluates all 7 non-trivial bipartitions to find optimal 2-means clustering
+	static const byte s_masks[7] = { 1, 2, 4, 8, 3, 5, 6 };
+	int best_mask = 3;
+	int64 min_err = 0x7fffffffffffffffLL;
+	Color best_c1 = White(), best_c0 = Black();
+
+	for(int m_idx = 0; m_idx < 7; m_idx++) {
+		int mask = s_masks[m_idx];
+		int c1_r = 0, c1_g = 0, c1_b = 0, c1_cnt = 0;
+		int c0_r = 0, c0_g = 0, c0_b = 0, c0_cnt = 0;
+		for(int i = 0; i < 4; i++) {
+			if(mask & (1 << i)) {
+				c1_r += samples[i].r; c1_g += samples[i].g; c1_b += samples[i].b;
+				c1_cnt++;
+			}
+			else {
+				c0_r += samples[i].r; c0_g += samples[i].g; c0_b += samples[i].b;
+				c0_cnt++;
+			}
+		}
+		int m1_r = c1_r / c1_cnt, m1_g = c1_g / c1_cnt, m1_b = c1_b / c1_cnt;
+		int m0_r = c0_r / c0_cnt, m0_g = c0_g / c0_cnt, m0_b = c0_b / c0_cnt;
+
+		int64 err = 0;
+		for(int i = 0; i < 4; i++) {
+			if(mask & (1 << i)) {
+				int dr = samples[i].r - m1_r, dg = samples[i].g - m1_g, db = samples[i].b - m1_b;
+				err += dr * dr + dg * dg + db * db;
+			}
+			else {
+				int dr = samples[i].r - m0_r, dg = samples[i].g - m0_g, db = samples[i].b - m0_b;
+				err += dr * dr + dg * dg + db * db;
+			}
+		}
+		if(err < min_err) {
+			min_err = err;
+			best_mask = mask;
+			best_c1 = Color(m1_r, m1_g, m1_b);
+			best_c0 = Color(m0_r, m0_g, m0_b);
+		}
+	}
+
+	int lum1 = (2 * best_c1.GetR() + 5 * best_c1.GetG() + best_c1.GetB()) >> 3;
+	int lum0 = (2 * best_c0.GetR() + 5 * best_c0.GetG() + best_c0.GetB()) >> 3;
+	if(lum1 < lum0) {
+		best_mask = (~best_mask) & 0xF;
+		Swap(best_c1, best_c0);
+	}
+
+	out_cell.chr = s_L2_glyph[best_mask];
+	out_cell.ink = best_c1;
+	out_cell.paper = best_c0;
+	out_cell.sgr = 0;
+	return true;
+}
+
+void TuiRasteriseImage(TuiDraw& w, const Rect& dest_pixel_rect, const Image& img,
+                       const Rect& src, Color color)
+{
+	if(img.IsEmpty() || dest_pixel_rect.IsEmpty())
+		return;
+
+	Rect dest = dest_pixel_rect;
+	Rect clip = w.GetClip();
+	if(!dest.Intersects(clip))
+		return;
+
+	Size cell = TuiCellSize();
+	Rect cell_bounds = w.OutwardCellRect(dest);
+	Size cell_count = cell_bounds.GetSize();
+	if(cell_count.cx <= 0 || cell_count.cy <= 0)
+		return;
+
+	int64 serial = img.GetSerialId();
+
+	// Check if this icon has a registered glyph substitution (Phase 09/02)
+	const TuiIconGlyph *icon_glyph = TuiFindIconGlyph(serial);
+	if(icon_glyph && !icon_glyph->glyph.IsEmpty()) {
+		int width = cell_bounds.GetWidth();
+		int count = icon_glyph->glyph.GetLength();
+		int start_x = cell_bounds.left + max(0, (width - count) / 2);
+		int cy = cell_bounds.top + max(0, (cell_bounds.GetHeight() - 1) / 2);
+		Color ink = !IsNull(icon_glyph->ink) ? icon_glyph->ink : (!IsNull(color) ? color : SColorText());
+		for(int i = 0; i < count; i++) {
+			int cx = start_x + i;
+			w.PutGlyph(cx, cy, (dword)icon_glyph->glyph[i], ink);
+		}
+		return;
+	}
+
+	int mode = GetTuiBlockMode();
+	bool full_image = (src == Rect(img.GetSize()));
+
+	TuiImageBlockKey key;
+	key.serial = serial;
+	key.cell_cx = cell_count.cx;
+	key.cell_cy = cell_count.cy;
+	key.color_hash = (int)color.GetRaw();
+	key.mode = mode;
+
+	int hit = full_image ? s_block_cache.Find(key) : -1;
+	if(hit >= 0) {
+		s_cache_hits++;
+		const TuiCellBlock& block = s_block_cache[hit];
+		TuiScreen& screen = TheTuiScreen();
+		Size ssz = screen.GetSize();
+		for(int y = 0; y < cell_count.cy; y++) {
+			int cy = cell_bounds.top + y;
+			if(cy < 0 || cy >= ssz.cy) continue;
+			for(int x = 0; x < cell_count.cx; x++) {
+				int cx = cell_bounds.left + x;
+				if(cx < 0 || cx >= ssz.cx) continue;
+				Rect cellpx(cx * cell.cx, cy * cell.cy, cx * cell.cx + cell.cx, cy * cell.cy + cell.cy);
+				if(w.CellVisible(cellpx)) {
+					const VTCell& c = block.cells[y * cell_count.cx + x];
+					if(c.chr != 0 || !IsNull(c.paper))
+						screen.At(cx, cy) = c;
+				}
+			}
+		}
+		return;
+	}
+
+	if(full_image)
+		s_cache_misses++;
+
+	TuiCellBlock block;
+	block.sz = cell_count;
+	block.cells.SetCount(cell_count.cx * cell_count.cy);
+
+	TuiScreen& screen = TheTuiScreen();
+	Size ssz = screen.GetSize();
+
+	for(int y = 0; y < cell_count.cy; y++) {
+		int cy = cell_bounds.top + y;
+		for(int x = 0; x < cell_count.cx; x++) {
+			int cx = cell_bounds.left + x;
+			int idx = y * cell_count.cx + x;
+			VTCell& c = block.cells[idx];
+			c.chr = 0;
+			c.paper = Null;
+			c.ink = Null;
+			c.sgr = 0;
+
+			Rect cellpx(cx * cell.cx, cy * cell.cy, cx * cell.cx + cell.cx, cy * cell.cy + cell.cy);
+			Color bg = SColorFace();
+			if(cx >= 0 && cx < ssz.cx && cy >= 0 && cy < ssz.cy)
+				bg = screen.At(cx, cy).paper;
+
+			if(TuiSampleCell(img, src, cellpx, dest, color, mode, bg, c)) {
+				if(cx >= 0 && cx < ssz.cx && cy >= 0 && cy < ssz.cy && w.CellVisible(cellpx)) {
+					screen.At(cx, cy) = c;
+				}
+			}
+		}
+	}
+
+	if(full_image) {
+		if(s_block_cache.GetCount() > 128)
+			s_block_cache.Remove(0);
+		s_block_cache.Add(key, pick(block));
+	}
+}
+
+void TuiDrawRasterText(TuiDraw& w, int x, int y, const wchar *text, Font font,
+                       Color ink, int n, const int *dx)
+{
+	Size cell = TuiCellSize();
+	int px = x + w.GetOffset().x;
+	int py = y + w.GetOffset().y;
+
+	int scale = max(2, (font.GetHeight() + cell.cy / 2) / cell.cy);
+	int char_cy = scale * cell.cy;
+	int char_cx = scale * cell.cx;
+
+	int cur_x = px;
+	for(int i = 0; i < n; i++) {
+		wchar ch = text[i];
+		int adv = dx ? dx[i] : char_cx;
+		if(ch < 0 || ch >= 128)
+			ch = '?';
+
+		ImageDraw iw(char_cx, char_cy);
+		iw.Alpha().DrawRect(0, 0, char_cx, char_cy, Black());
+		iw.DrawRect(0, 0, char_cx, char_cy, Black());
+
+		for(int ry = 0; ry < 8; ry++) {
+			byte b = s_font8x8[ch][ry];
+			for(int rx = 0; rx < 8; rx++) {
+				if(b & (1 << rx)) {
+					Rect r_bit(rx * char_cx / 8, ry * char_cy / 8,
+					           (rx + 1) * char_cx / 8, (ry + 1) * char_cy / 8);
+					iw.DrawRect(r_bit, ink);
+					iw.Alpha().DrawRect(r_bit, White());
+				}
+			}
+		}
+
+		Image char_img = iw;
+		Rect dest_rect(cur_x, py, cur_x + char_cx, py + char_cy);
+		TuiRasteriseImage(w, dest_rect, char_img, Rect(char_img.GetSize()), Null);
+
+		cur_x += adv;
+	}
+}
+
+END_UPP_NAMESPACE
+
+#endif
diff -uNr -x '*.o' -x '*.a' -x '*.obj' CtrlCore_a/TuiRaster.h CtrlCore_b/TuiRaster.h
--- a/TuiRaster.h	1970-01-01 02:00:00.000000000 +0200
+++ b/TuiRaster.h	2026-09-14 23:17:06.516097500 +0300
@@ -0,0 +1,45 @@
+// CtrlCoreTUI 09/01 (gate_raster): Rasterising graphics into terminal cells.
+// Sub-cell resolution ladder (L0..L4, Braille), two-colour downsampling,
+// block cache, and oversized text rendering.
+
+#ifndef _CtrlCore_TuiRaster_h_
+#define _CtrlCore_TuiRaster_h_
+
+NAMESPACE_UPP
+
+enum TuiBlockMode {
+	TUI_BLOCKS_L0      = 0, // 1x1 flat cells (space with paper)
+	TUI_BLOCKS_L1      = 1, // 2x1 half blocks (▀ ▄)
+	TUI_BLOCKS_L2      = 2, // 2x2 quadrants (▘▝▖▗▙▛▜▟▚▞█) - universal default
+	TUI_BLOCKS_L3      = 3, // 2x3 sextants (Unicode 13 U+1FB00..)
+	TUI_BLOCKS_L4      = 4, // 2x4 octants (Unicode 16 U+1CD00..)
+	TUI_BLOCKS_BRAILLE = 5, // 2x4 braille (U+2800..U+28FF, monochrome)
+};
+
+int  GetTuiBlockMode();
+void SetTuiBlockMode(int mode);
+
+// Samples a single cell's worth of pixel data from img.
+// Returns false if the cell is completely transparent.
+bool TuiSampleCell(const Image& img, const Rect& src_rect, const Rect& cell_px,
+                   const Rect& dest_px, Color color_tint, int block_mode,
+                   Color background, VTCell& out_cell);
+
+class TuiDraw;
+
+// Rasterises an Image into destination pixel bounds on TuiDraw.
+void TuiRasteriseImage(TuiDraw& w, const Rect& dest_pixel_rect, const Image& img,
+                       const Rect& src, Color color);
+
+// Renders oversized styled text using the built-in block-glyph alphabet.
+void TuiDrawRasterText(TuiDraw& w, int x, int y, const wchar *text, Font font,
+                       Color ink, int n, const int *dx);
+
+// Cache inspection for testing / gates
+int  GetTuiBlockCacheHits();
+int  GetTuiBlockCacheMisses();
+void ClearTuiBlockCache();
+
+END_UPP_NAMESPACE
+
+#endif
diff -uNr -x '*.o' -x '*.a' -x '*.obj' CtrlCore_a/TuiScreen.cpp CtrlCore_b/TuiScreen.cpp
--- a/TuiScreen.cpp	1970-01-01 02:00:00.000000000 +0200
+++ b/TuiScreen.cpp	2026-09-15 13:12:23.523213600 +0300
@@ -0,0 +1,510 @@
+#include <CtrlCore/CtrlCore.h>
+
+#ifdef PLATFORM_TUI
+
+#include "TuiScreen.h"
+#include "TuiTerminal.h"
+
+NAMESPACE_UPP
+
+TuiScreen::TuiScreen()
+: full_repaint(true)
+, policy(COLOR_RGB)
+, caret_visible(false)
+, shown_caret_visible(false)
+, audit_enabled(false)
+, current_writer(nullptr)
+{
+}
+
+void TuiScreen::SetAudit(bool enable)
+{
+	audit_enabled = enable;
+	if(audit_enabled) {
+		cell_audits.SetCount(size.cx * size.cy);
+		ClearAudit();
+	}
+	else
+		ClearAudit();
+}
+
+void TuiScreen::ClearAudit()
+{
+	overlaps.Clear();
+	for(int i = 0; i < cell_audits.GetCount(); i++)
+		cell_audits[i] = CellAudit();
+}
+
+void TuiScreen::SetSize(Size cells)
+{
+	cells.cx = max(cells.cx, 0);
+	cells.cy = max(cells.cy, 0);
+	if(cells == size)
+		return;
+	size = cells;
+	int n = size.cx * size.cy;
+	// Clear() first, not just SetCount(): SetCount only default-constructs the
+	// cells it *adds*, and a shrink-then-grow must not resurrect stale cells
+	// of the old geometry (the flush must never read stale `shown`).
+	cur.Clear();
+	cur.SetCount(n);
+	shown.Clear();
+	shown.SetCount(n);
+	if(audit_enabled) {
+		cell_audits.SetCount(n);
+		ClearAudit();
+	}
+	full_repaint = true;
+}
+
+VTCell& TuiScreen::At(int x, int y)
+{
+	ASSERT(x >= 0 && x < size.cx && y >= 0 && y < size.cy);
+	return cur[Idx(x, y)];
+}
+
+const VTCell& TuiScreen::At(int x, int y) const
+{
+	ASSERT(x >= 0 && x < size.cx && y >= 0 && y < size.cy);
+	return cur[Idx(x, y)];
+}
+
+void TuiScreen::Fill(const Rect& cells, const VTCell& pattern, dword filler_flags)
+{
+	Rect r = cells & Rect(Point(0, 0), size);
+	for(int y = r.top; y < r.bottom; y++)
+		for(int x = r.left; x < r.right; x++) {
+			int idx = Idx(x, y);
+			cur[idx].Fill(pattern, filler_flags);
+			if(audit_enabled && idx < cell_audits.GetCount()) {
+				CellAudit& a = cell_audits[idx];
+				a.write_count++;
+				a.last_writer = current_writer;
+				a.last_writer_name = current_writer_name;
+			}
+		}
+}
+
+void TuiScreen::PutText(Point cell, const WString& text, const VTCell& style)
+{
+	if(cell.y < 0 || cell.y >= size.cy)
+		return;
+	int x = cell.x;
+	int y = cell.y;
+	for(int i = 0; i < text.GetCount() && x < size.cx; i++) {
+		VTCell v = style;
+		v.chr = text[i];
+		int w = v.GetWidth();
+		if(w == 0)
+			continue; // combining mark: no target cell (Cell.h:9's grapheme TODO)
+		if(x >= 0) {
+			int idx = Idx(x, y);
+			cur[idx] = v;
+			if(audit_enabled && idx < cell_audits.GetCount()) {
+				CellAudit& a = cell_audits[idx];
+				a.write_count++;
+				if(v.chr > ' ') {
+					a.text_write_count++;
+					if(a.last_writer && a.last_writer != current_writer && a.last_char > ' ') {
+						OverlapReport& o = overlaps.Add();
+						o.cell = Point(x, y);
+						o.writer1 = a.last_writer_name;
+						o.writer2 = current_writer_name;
+						o.chr1 = a.last_char;
+						o.chr2 = v.chr;
+					}
+					a.last_writer = current_writer;
+					a.last_writer_name = current_writer_name;
+					a.last_char = v.chr;
+				}
+			}
+		}
+		x++;
+		if(w == 2) {
+			if(x >= 0 && x < size.cx) {
+				VTCell ext = style;
+				ext.chr = 1; // continuation convention, VTPage::CellAdd (Page.cpp)
+				cur[Idx(x, y)] = ext;
+			}
+			x++;
+		}
+	}
+}
+
+void TuiScreen::PutGlyph(int x, int y, dword chr, Color ink, word sgr)
+{
+	if(x < 0 || x >= size.cx || y < 0 || y >= size.cy)
+		return;
+	int idx = Idx(x, y);
+	VTCell& c = cur[idx];
+	c.chr = chr;
+	c.ink = ink;
+	c.sgr = sgr;
+	if(audit_enabled && idx < cell_audits.GetCount()) {
+		CellAudit& a = cell_audits[idx];
+		a.write_count++;
+		if(chr > ' ') {
+			a.text_write_count++;
+			if(a.last_writer && a.last_writer != current_writer && a.last_char > ' ') {
+				OverlapReport& o = overlaps.Add();
+				o.cell = Point(x, y);
+				o.writer1 = a.last_writer_name;
+				o.writer2 = current_writer_name;
+				o.chr1 = a.last_char;
+				o.chr2 = (wchar)chr;
+			}
+			a.last_writer = current_writer;
+			a.last_writer_name = current_writer_name;
+			a.last_char = (wchar)chr;
+		}
+	}
+}
+
+namespace {
+
+// Weighted (not naive-Euclidean) squared distance: cheap stand-in for a real
+// perceptual metric (CIE Lab etc. would be overkill here), using the classic
+// NTSC luma weights so quantised greys don't drift the way plain RGB
+// Euclidean distance does. See this task's plan doc, risk "Quantisation
+// quality".
+double PerceptualDist2(int r1, int g1, int b1, int r2, int g2, int b2)
+{
+	double dr = r1 - r2, dg = g1 - g2, db = b1 - b2;
+	return 0.30 * dr * dr + 0.59 * dg * dg + 0.11 * db * db;
+}
+
+int CubeLevel(int v)
+{
+	static const int levels[6] = { 0, 95, 135, 175, 215, 255 };
+	int best = 0;
+	int bestd = INT_MAX;
+	for(int i = 0; i < 6; i++) {
+		int d = abs(v - levels[i]);
+		if(d < bestd) {
+			bestd = d;
+			best = i;
+		}
+	}
+	return best;
+}
+
+// xterm-256: 16-231 is a 6x6x6 colour cube, 232-255 a 24-step grey ramp.
+// Indices 0-15 (the user's own ANSI theme) are deliberately not used as
+// quantisation targets here -- they are the COLOR_ANSI16 policy's job, not
+// the RGB depth-fallback's.
+int NearestXterm256(Color c)
+{
+	int r = c.GetR(), g = c.GetG(), b = c.GetB();
+	static const int levels[6] = { 0, 95, 135, 175, 215, 255 };
+
+	int rl = CubeLevel(r), gl = CubeLevel(g), bl = CubeLevel(b);
+	int cube_idx = 16 + 36 * rl + 6 * gl + bl;
+	double cube_d = PerceptualDist2(r, g, b, levels[rl], levels[gl], levels[bl]);
+
+	int gray = (r + g + b) / 3;
+	int gi = (gray - 8 + 5) / 10;
+	gi = minmax(gi, 0, 23);
+	int gv = 8 + gi * 10;
+	int gray_idx = 232 + gi;
+	double gray_d = PerceptualDist2(r, g, b, gv, gv, gv);
+
+	return cube_d <= gray_d ? cube_idx : gray_idx;
+}
+
+struct Ansi16Entry { int idx, r, g, b; };
+
+// Standard xterm default 16-colour palette. The actual RGB a user sees under
+// COLOR_ANSI16 policy is whatever their terminal theme maps these indices
+// to -- this table exists only to pick the *index* nearest an RGB depth
+// fallback wants, not to promise these exact RGB values will appear.
+const Ansi16Entry sAnsi16[16] = {
+	{ 0,   0,   0,   0 }, { 1, 205,   0,   0 }, { 2,   0, 205,   0 }, { 3, 205, 205,   0 },
+	{ 4,   0,   0, 238 }, { 5, 205,   0, 205 }, { 6,   0, 205, 205 }, { 7, 229, 229, 229 },
+	{ 8, 127, 127, 127 }, { 9, 255,   0,   0 }, { 10,  0, 255,   0 }, { 11, 255, 255,   0 },
+	{ 12, 92,  92, 255 }, { 13, 255,  0, 255 }, { 14,  0, 255, 255 }, { 15, 255, 255, 255 },
+};
+
+} // anonymous namespace
+
+int NearestAnsi16(Color c)
+{
+	int r = c.GetR(), g = c.GetG(), b = c.GetB();
+	int best = 0;
+	double bestd = 1e18;
+	for(const Ansi16Entry& e : sAnsi16) {
+		double d = PerceptualDist2(r, g, b, e.r, e.g, e.b);
+		if(d < bestd) {
+			bestd = d;
+			best = e.idx;
+		}
+	}
+	return best;
+}
+
+namespace {
+
+void EmitColor(Vector<String>& params, bool fg, Color c, int colors, TuiScreen::ColorPolicy policy)
+{
+	if(IsNull(c)) {
+		params.Add(fg ? "39" : "49");
+		return;
+	}
+	int sp = c.GetSpecial();
+	if(sp >= 0 && sp < 16) {
+		int code = sp < 8 ? (fg ? 30 : 40) + sp : (fg ? 90 : 100) + (sp - 8);
+		params.Add(AsString(code));
+		return;
+	}
+	if(policy == TuiScreen::COLOR_ANSI16 || colors <= 16) {
+		int idx = NearestAnsi16(c);
+		int code = idx < 8 ? (fg ? 30 : 40) + idx : (fg ? 90 : 100) + (idx - 8);
+		params.Add(AsString(code));
+		return;
+	}
+	if(colors <= 256) {
+		params.Add(fg ? "38" : "48");
+		params.Add("5");
+		params.Add(AsString(NearestXterm256(c)));
+		return;
+	}
+	params.Add(fg ? "38" : "48");
+	params.Add("2");
+	params.Add(AsString(c.GetR()));
+	params.Add(AsString(c.GetG()));
+	params.Add(AsString(c.GetB()));
+}
+
+struct Pen {
+	Color ink;    // default ctor: Null ("terminal default")
+	Color paper;  // default ctor: Null
+	word  sgr = VTCell::SGR_NORMAL;
+
+	bool IsDefault() const { return IsNull(ink) && IsNull(paper) && sgr == VTCell::SGR_NORMAL; }
+};
+
+// Emits only the SGR params that changed between `active` and `want`, then
+// updates `active` to match. Dedicated set/reset codes (22/23/24/25/27/28/
+// 29/55) are used instead of a blanket 0 wherever that is shorter, per this
+// task's plan doc.
+void EmitPenDelta(String& out, Pen& active, const VTCell& want, int colors,
+                   TuiScreen::ColorPolicy policy)
+{
+	Vector<String> params;
+	word w = want.sgr, a = active.sgr;
+
+	if((w & (VTCell::SGR_BOLD | VTCell::SGR_FAINT)) != (a & (VTCell::SGR_BOLD | VTCell::SGR_FAINT))) {
+		if(w & VTCell::SGR_BOLD)  params.Add("1");
+		if(w & VTCell::SGR_FAINT) params.Add("2");
+		if(!(w & (VTCell::SGR_BOLD | VTCell::SGR_FAINT))) params.Add("22");
+	}
+	auto Diff = [&](word bit, const char *on, const char *off) {
+		if((w & bit) != (a & bit))
+			params.Add((w & bit) ? on : off);
+	};
+	Diff(VTCell::SGR_ITALIC,    "3",  "23");
+	Diff(VTCell::SGR_UNDERLINE, "4",  "24");
+	Diff(VTCell::SGR_BLINK,     "5",  "25");
+	Diff(VTCell::SGR_INVERTED,  "7",  "27");
+	Diff(VTCell::SGR_HIDDEN,    "8",  "28");
+	Diff(VTCell::SGR_STRIKEOUT, "9",  "29");
+	Diff(VTCell::SGR_OVERLINE,  "53", "55");
+
+	if(want.ink != active.ink)
+		EmitColor(params, true, want.ink, colors, policy);
+	if(want.paper != active.paper)
+		EmitColor(params, false, want.paper, colors, policy);
+
+	if(params.GetCount()) {
+		out << "\x1b[";
+		for(int i = 0; i < params.GetCount(); i++) {
+			if(i) out << ';';
+			out << params[i];
+		}
+		out << 'm';
+	}
+
+	active.sgr   = want.sgr;
+	active.ink   = want.ink;
+	active.paper = want.paper;
+}
+
+void EmitCUP(String& out, int row, int col) // 0-based cell coordinates in
+{
+	out << "\x1b[" << (row + 1) << ';' << (col + 1) << 'H';
+}
+
+void EmitChar(String& out, dword chr)
+{
+	out.Cat(ToUtf8((wchar)(chr == 0 ? ' ' : chr)));
+}
+
+bool CellEq(const VTCell& a, const VTCell& b)
+{
+	return a.chr == b.chr && a.attrs == b.attrs && a.sgr == b.sgr
+		&& a.data == b.data && a.ink == b.ink && a.paper == b.paper;
+}
+
+} // anonymous namespace
+
+void TuiScreen::Flush(TuiTerminal& t)
+{
+	if(size.cx <= 0 || size.cy <= 0) {
+		full_repaint = false;
+		return;
+	}
+
+	Vector<Rect> dirty;
+	for(int y = 0; y < size.cy; y++) {
+		int first = -1, last = -1;
+		for(int x = 0; x < size.cx; x++) {
+			if(full_repaint || !CellEq(cur[Idx(x, y)], shown[Idx(x, y)])) {
+				if(first < 0) first = x;
+				last = x;
+			}
+		}
+		if(first >= 0)
+			dirty.Add(Rect(first, y, last + 1, y + 1));
+	}
+
+	// Phase 11 seam extension: direct cell writing (e.g. Windows Console API).
+	// If the terminal implementation handles cells directly, it returns true.
+	if(t.PutCells(*this, dirty)) {
+		shown <<= cur;
+		shown_caret = caret;
+		shown_caret_visible = caret_visible;
+		full_repaint = false;
+		return;
+	}
+
+	int colors = t.GetCapabilities().colors;
+	bool sync = t.GetCapabilities().sync_output;
+
+	String body;
+	Pen active; // assumed terminal state: default, matches the reset this
+	            // function issues at the end of every prior flush
+	bool wrote_any = false;
+
+	for(const Rect& r : dirty) {
+		int y = r.top;
+		EmitCUP(body, y, r.left);
+		wrote_any = true;
+		for(int x = r.left; x < r.right; x++) {
+			const VTCell& want = cur[Idx(x, y)];
+			if(want.chr == 1) // wide-char continuation: no glyph of its own
+				continue;
+			EmitPenDelta(body, active, want, colors, policy);
+			EmitChar(body, want.chr);
+		}
+	}
+
+	if(wrote_any && !active.IsDefault())
+		body << "\x1b[0m";
+
+	// Caret placement is folded into this same batch as raw bytes, not a call
+	// to TuiTerminal::SetCursor() -- that primitive does its own Put() (see
+	// TuiTermVT.cpp's "write-through: nothing buffered"), which would both
+	// break "one Put() per flush" and cost bytes on every flush even when the
+	// caret has not moved, defeating the near-zero-on-no-change requirement.
+	if(full_repaint || caret != shown_caret || caret_visible != shown_caret_visible) {
+		body << "\x1b[" << (caret.y + 1) << ';' << (caret.x + 1) << 'H';
+		body << (caret_visible ? "\x1b[?25h" : "\x1b[?25l");
+		shown_caret = caret;
+		shown_caret_visible = caret_visible;
+	}
+
+	// One Put() for the whole batch: many small writes to a Windows console
+	// handle are the classic cause of TUI slowness (this task's plan doc).
+	// Nothing is sent at all -- not even the sync wrapper -- when the body is
+	// empty, which is what keeps a repeated no-change flush at zero bytes.
+	if(body.GetCount()) {
+		String out;
+		if(sync)
+			out << "\x1b[?2026h";
+		out << body;
+		if(sync)
+			out << "\x1b[?2026l";
+		t.Put(out);
+		t.Sync();
+	}
+
+	shown <<= cur;
+	full_repaint = false;
+}
+
+static String sFormatAttrColor(Color c)
+{
+	if(IsNull(c))
+		return ".";
+	return Format("%02X%02X%02X", c.GetR(), c.GetG(), c.GetB());
+}
+
+static String sFormatSgrFlags(word sgr)
+{
+	String s;
+	if(sgr & VTCell::SGR_BOLD)      s.Cat('b');
+	if(sgr & VTCell::SGR_FAINT)     s.Cat('d');
+	if(sgr & VTCell::SGR_ITALIC)    s.Cat('i');
+	if(sgr & VTCell::SGR_UNDERLINE) s.Cat('u');
+	if(sgr & VTCell::SGR_BLINK)     s.Cat('k');
+	if(sgr & VTCell::SGR_INVERTED)  s.Cat('r');
+	if(sgr & VTCell::SGR_HIDDEN)    s.Cat('h');
+	if(sgr & VTCell::SGR_STRIKEOUT) s.Cat('s');
+	if(sgr & VTCell::SGR_OVERLINE)  s.Cat('o');
+	return s;
+}
+
+String TuiScreen::DumpText(bool trim_right) const
+{
+	String out;
+	for(int y = 0; y < size.cy; y++) {
+		String line;
+		for(int x = 0; x < size.cx; x++) {
+			int idx = y * size.cx + x;
+			if(idx >= cur.GetCount())
+				break;
+			const VTCell& c = cur[idx];
+			if(c.chr == 1) // wide-char continuation
+				continue;
+			if(c.chr == 0 || c.chr == ' ')
+				line.Cat(' ');
+			else
+				line.Cat(WString(c.chr, 1).ToString());
+		}
+		if(trim_right) {
+			int len = line.GetCount();
+			while(len > 0 && line[len - 1] == ' ')
+				len--;
+			line.Trim(len);
+		}
+		out << line << "\n";
+	}
+	return out;
+}
+
+String TuiScreen::DumpAttrs() const
+{
+	String out;
+	for(int y = 0; y < size.cy; y++) {
+		String line;
+		for(int x = 0; x < size.cx; x++) {
+			int idx = y * size.cx + x;
+			if(idx >= cur.GetCount())
+				break;
+			const VTCell& c = cur[idx];
+			String tok = sFormatAttrColor(c.ink) + "/" + sFormatAttrColor(c.paper);
+			String sgr = sFormatSgrFlags(c.sgr);
+			if(sgr.GetCount())
+				tok << ":" << sgr;
+			if(x > 0)
+				line.Cat(' ');
+			line.Cat(tok);
+		}
+		out << line << "\n";
+	}
+	return out;
+}
+
+END_UPP_NAMESPACE
+
+#endif
+
diff -uNr -x '*.o' -x '*.a' -x '*.obj' CtrlCore_a/TuiScreen.h CtrlCore_b/TuiScreen.h
--- a/TuiScreen.h	1970-01-01 02:00:00.000000000 +0200
+++ b/TuiScreen.h	2026-09-15 13:11:33.280541300 +0300
@@ -0,0 +1,123 @@
+// CtrlCoreTUI 02/02 (gate_flush): the cell buffer every layer above draws
+// into, and the diff/flush that turns it into VT bytes. Plan doc:
+// CtrlCoreTUI/02-cellmodel/02-cellscreen-and-flush.md.
+//
+// Flat Vector<VTCell>, not VTPage (task 2): a GUI surface is randomly
+// addressed, never scrolled, and needs none of VTPage's scrollback, DEC
+// margins or cursor model -- embedding it would mean carrying dead state and
+// fighting its cursor-relative API for what is here a plain x/y grid.
+//
+// Double-width pairing (task 3) reuses VTPage's own convention (Page.cpp:347,
+// CellAdd): the second cell of a wide character carries chr == 1
+// ("continuation"), not a separate flag. One fewer bit to keep in sync with
+// the primary cell's style, and a future VTPage-to-TuiScreen blit needs no
+// translation. The East Asian Width classification this depends on
+// (VTCell::GetWidth(), TerminalCore/Cell.cpp) already existed in TerminalCore
+// before this task -- it rode along incidentally when Cell.cpp moved out of
+// uppsrc/Terminal in phase 02/01, contrary to this task's own plan text.
+//
+// Zero-width combining marks (Cell.h:9's grapheme TODO) are dropped by
+// PutText rather than merged into the preceding cell: full grapheme
+// clustering is out of scope here, and silently discarding is safer than
+// silently misrendering.
+
+#ifndef _CtrlCore_TuiScreen_h_
+#define _CtrlCore_TuiScreen_h_
+
+#include <TerminalCore/TerminalCore.h>
+
+NAMESPACE_UPP
+
+struct TuiTerminal;
+
+class TuiScreen {
+public:
+	// Depth fallback (RGB, quantised down when the terminal can't do 24-bit)
+	// vs. the phase 07 policy where the theme deliberately speaks the ANSI 16
+	// slots so the user's own terminal palette applies. Phase 02 only needs
+	// both to be expressible; the RGB default is what keeps the U++ theme
+	// looking the same everywhere until phase 07 decides otherwise.
+	enum ColorPolicy { COLOR_RGB, COLOR_ANSI16 };
+
+	TuiScreen();
+
+	void          SetSize(Size cells);
+	Size          GetSize() const                 { return size; }
+
+	VTCell&       At(int x, int y);
+	const VTCell& At(int x, int y) const;
+	VTCell&       At(Point p)                      { return At(p.x, p.y); }
+	const VTCell& At(Point p) const                { return At(p.x, p.y); }
+
+	void          Fill(const Rect& cells, const VTCell& pattern,
+	                    dword filler_flags = VTCell::FILL_NORMAL);
+	void          PutText(Point cell, const WString& text, const VTCell& style);
+	void          PutGlyph(int x, int y, dword chr, Color ink, word sgr = 0);
+
+	void          Invalidate()                     { full_repaint = true; }
+	void          Flush(TuiTerminal& t);
+
+	// The hardware cursor is not this class's business to compute -- callers
+	// (TuiCtrl/TuiWnd, phases 03-04) know the widget caret; TuiScreen only
+	// carries it through to the one Put() the flush algorithm requires.
+	// Defaults to hidden: nothing owns caret placement yet in this phase.
+	void          SetCaret(Point p, bool visible = true) { caret = p; caret_visible = visible; }
+	Point         GetCaret() const                 { return caret; }
+	bool          IsCaretVisible() const           { return caret_visible; }
+
+	void          SetColorPolicy(ColorPolicy p)    { policy = p; }
+	ColorPolicy   GetColorPolicy() const           { return policy; }
+
+	// Phase 13/02 audit and overlap instrumentation
+	struct CellAudit : Moveable<CellAudit> {
+		int write_count = 0;
+		int text_write_count = 0;
+		const void *last_writer = nullptr;
+		String last_writer_name;
+		wchar  last_char = 0;
+	};
+
+	struct OverlapReport : Moveable<OverlapReport> {
+		Point cell;
+		String writer1;
+		String writer2;
+		wchar  chr1 = 0;
+		wchar  chr2 = 0;
+	};
+
+	void SetAudit(bool enable = true);
+	bool IsAudit() const                            { return audit_enabled; }
+	void ClearAudit();
+	void SetCurrentWriter(const void *writer, const String& name) { current_writer = writer; current_writer_name = name; }
+	const Vector<CellAudit>& GetCellAudits() const  { return cell_audits; }
+	const Vector<OverlapReport>& GetOverlaps() const { return overlaps; }
+
+	String DumpText(bool trim_right = true) const;
+	String DumpAttrs() const;
+
+private:
+	Size            size;
+	Vector<VTCell>  cur;    // wanted
+	Vector<VTCell>  shown;  // on screen, for diffing
+	bool            full_repaint;
+	ColorPolicy     policy;
+	Point           caret;
+	bool            caret_visible;
+	Point           shown_caret;         // caret state as last flushed, for diffing
+	bool            shown_caret_visible;
+
+	// Audit fields
+	bool                  audit_enabled;
+	const void           *current_writer;
+	String                current_writer_name;
+	Vector<CellAudit>     cell_audits;
+	Vector<OverlapReport> overlaps;
+
+	int  Idx(int x, int y) const                   { return y * size.cx + x; }
+};
+
+int NearestAnsi16(Color c);
+
+END_UPP_NAMESPACE
+
+#endif
diff -uNr -x '*.o' -x '*.a' -x '*.obj' CtrlCore_a/TuiTermHeadless.cpp CtrlCore_b/TuiTermHeadless.cpp
--- a/TuiTermHeadless.cpp	1970-01-01 02:00:00.000000000 +0200
+++ b/TuiTermHeadless.cpp	2026-09-15 22:59:27.844917400 +0300
@@ -0,0 +1,260 @@
+#include "CtrlCore.h"
+
+#ifdef PLATFORM_TUI
+
+#include "TuiTermHeadless.h"
+#include "TuiDraw.h"
+
+NAMESPACE_UPP
+
+static TuiTerminal *sOverrideTerminal = nullptr;
+
+void SetTuiTerminalOverride(TuiTerminal *term)
+{
+	sOverrideTerminal = term;
+}
+
+TuiTerminal *GetTuiTerminalOverride()
+{
+	return sOverrideTerminal;
+}
+
+TuiTerminalHeadless::TuiTerminalHeadless()
+{
+	started = false;
+	size = Size(80, 25);
+	caps.colors = 1 << 24; // 24-bit RGB
+	caps.mouse = true;
+	caps.sync_output = false;
+	caps.blocks_2x2 = true;
+	caps.blocks_2x3 = true;
+	caps.blocks_2x4 = true;
+	cursor_pos = Point(0, 0);
+	cursor_visible = false;
+	captured_size = Size(0, 0);
+}
+
+TuiTerminalHeadless::~TuiTerminalHeadless()
+{
+}
+
+bool TuiTerminalHeadless::Start()
+{
+	started = true;
+	emitted_bytes.Clear();
+	input_queue.Clear();
+	CaptureScreen();
+	return true;
+}
+
+void TuiTerminalHeadless::Stop()
+{
+	started = false;
+	captured_cells.Clear();
+	emitted_bytes.Clear();
+	input_queue.Clear();
+}
+
+const TuiCapabilities& TuiTerminalHeadless::GetCapabilities() const
+{
+	return caps;
+}
+
+void TuiTerminalHeadless::SetCapabilities(const TuiCapabilities& c)
+{
+	caps = c;
+}
+
+Size TuiTerminalHeadless::GetCellSize()
+{
+	return size;
+}
+
+void TuiTerminalHeadless::SetSize(Size cells)
+{
+	size = cells;
+#ifndef VIRTUALGUI
+	Ctrl::TuiSyncResize();
+#endif
+}
+
+void TuiTerminalHeadless::Put(const String& bytes)
+{
+	emitted_bytes.Cat(bytes);
+}
+
+void TuiTerminalHeadless::Sync()
+{
+	CaptureScreen();
+}
+
+void TuiTerminalHeadless::SetCursor(Point cell, bool visible)
+{
+	cursor_pos = cell;
+	cursor_visible = visible;
+}
+
+bool TuiTerminalHeadless::WaitInput(int ms)
+{
+	if(!input_queue.IsEmpty())
+		return true;
+	if(ms > 0)
+		Sleep(ms);
+	return !input_queue.IsEmpty();
+}
+
+String TuiTerminalHeadless::ReadInput()
+{
+	String s = input_queue;
+	input_queue.Clear();
+	return s;
+}
+
+void TuiTerminalHeadless::WakeUp()
+{
+}
+
+void TuiTerminalHeadless::FeedKeys(const String& vt_bytes)
+{
+	input_queue.Cat(vt_bytes);
+}
+
+void TuiTerminalHeadless::FeedClick(Point cell, int button, dword mods)
+{
+	int b = button;
+	if(mods & K_SHIFT) b |= 4;
+	if(mods & K_ALT)   b |= 8;
+	if(mods & K_CTRL)  b |= 16;
+	input_queue.Cat(Format("\x1b[<%d;%d;%d", b, cell.x + 1, cell.y + 1) + "M");
+	input_queue.Cat(Format("\x1b[<%d;%d;%d", b, cell.x + 1, cell.y + 1) + "m");
+}
+
+void TuiTerminalHeadless::FeedResize(Size cells)
+{
+	size = cells;
+#ifndef VIRTUALGUI
+	Ctrl::TuiSyncResize();
+#endif
+}
+
+void TuiTerminalHeadless::ClearBytes()
+{
+	emitted_bytes.Clear();
+}
+
+String TuiTerminalHeadless::DumpBytes() const
+{
+	return emitted_bytes;
+}
+
+void TuiTerminalHeadless::CaptureScreen()
+{
+	Size sz = TheTuiScreen().GetSize();
+	if(sz.cx <= 0 || sz.cy <= 0)
+		sz = size;
+	captured_size = sz;
+	captured_cells.SetCount(sz.cx * sz.cy);
+	for(int y = 0; y < sz.cy; y++) {
+		for(int x = 0; x < sz.cx; x++) {
+			if(x < TheTuiScreen().GetSize().cx && y < TheTuiScreen().GetSize().cy)
+				captured_cells[y * sz.cx + x] = TheTuiScreen().At(x, y);
+			else {
+				VTCell empty;
+				empty.chr = ' ';
+				captured_cells[y * sz.cx + x] = empty;
+			}
+		}
+	}
+}
+
+String TuiTerminalHeadless::DumpText(bool trim_right) const
+{
+	const_cast<TuiTerminalHeadless*>(this)->CaptureScreen();
+
+	Size sz = captured_size.cx > 0 ? captured_size : size;
+	String out;
+	for(int y = 0; y < sz.cy; y++) {
+		String line;
+		for(int x = 0; x < sz.cx; x++) {
+			int idx = y * sz.cx + x;
+			if(idx >= captured_cells.GetCount())
+				break;
+			const VTCell& c = captured_cells[idx];
+			if(c.chr == 1) // wide character continuation cell
+				continue;
+			if(c.chr == 0 || c.chr == ' ')
+				line.Cat(' ');
+			else
+				line.Cat(WString(c.chr, 1).ToString());
+		}
+		if(trim_right) {
+			int len = line.GetCount();
+			while(len > 0 && line[len - 1] == ' ')
+				len--;
+			line.Trim(len);
+		}
+		out << line << "\n";
+	}
+	return out;
+}
+
+static String FormatAttrColor(Color c)
+{
+	if(IsNull(c))
+		return ".";
+	return Format("%02X%02X%02X", c.GetR(), c.GetG(), c.GetB());
+}
+
+static String FormatSgrFlags(word sgr)
+{
+	String s;
+	if(sgr & VTCell::SGR_BOLD)      s.Cat('b');
+	if(sgr & VTCell::SGR_FAINT)     s.Cat('d');
+	if(sgr & VTCell::SGR_ITALIC)    s.Cat('i');
+	if(sgr & VTCell::SGR_UNDERLINE) s.Cat('u');
+	if(sgr & VTCell::SGR_BLINK)     s.Cat('k');
+	if(sgr & VTCell::SGR_INVERTED)  s.Cat('r');
+	if(sgr & VTCell::SGR_HIDDEN)    s.Cat('h');
+	if(sgr & VTCell::SGR_STRIKEOUT) s.Cat('s');
+	if(sgr & VTCell::SGR_OVERLINE)  s.Cat('o');
+	return s;
+}
+
+String TuiTerminalHeadless::DumpAttrs() const
+{
+	const_cast<TuiTerminalHeadless*>(this)->CaptureScreen();
+
+	Size sz = captured_size.cx > 0 ? captured_size : size;
+	String out;
+	for(int y = 0; y < sz.cy; y++) {
+		String line;
+		for(int x = 0; x < sz.cx; x++) {
+			int idx = y * sz.cx + x;
+			if(idx >= captured_cells.GetCount())
+				break;
+			const VTCell& c = captured_cells[idx];
+			String tok = FormatAttrColor(c.ink) + "/" + FormatAttrColor(c.paper);
+			String sgr = FormatSgrFlags(c.sgr);
+			if(sgr.GetCount())
+				tok << ":" << sgr;
+			if(x > 0)
+				line.Cat(' ');
+			line.Cat(tok);
+		}
+		out << line << "\n";
+	}
+	return out;
+}
+
+TuiTerminalHeadless& GetTuiTerminalHeadless()
+{
+	alignas(TuiTerminalHeadless) static byte storage[sizeof(TuiTerminalHeadless)];
+	static TuiTerminalHeadless *sHeadless = nullptr;
+	if(!sHeadless)
+		sHeadless = new(storage) TuiTerminalHeadless;
+	return *sHeadless;
+}
+
+END_UPP_NAMESPACE
+
+#endif
diff -uNr -x '*.o' -x '*.a' -x '*.obj' CtrlCore_a/TuiTermHeadless.h CtrlCore_b/TuiTermHeadless.h
--- a/TuiTermHeadless.h	1970-01-01 02:00:00.000000000 +0200
+++ b/TuiTermHeadless.h	2026-09-14 15:38:35.200063400 +0300
@@ -0,0 +1,73 @@
+// CtrlCoreTUI 13/01 (headless snapshot harness): in-memory TuiTerminal
+// implementation for headless test runners, snapshot regression testing,
+// and scripted UI automation.
+// Plan doc: 2-plan/ai-upp/root/CtrlCoreTUI/13-testing/01-snapshot-harness.md.
+
+#ifndef _CtrlCore_TuiTermHeadless_h_
+#define _CtrlCore_TuiTermHeadless_h_
+
+#include "TuiTerminal.h"
+#include "TuiScreen.h"
+
+NAMESPACE_UPP
+
+struct TuiTerminalHeadless : public TuiTerminal {
+public:
+	TuiTerminalHeadless();
+	virtual ~TuiTerminalHeadless();
+
+	// TuiTerminal interface
+	bool  Start() override;
+	void  Stop() override;
+	const TuiCapabilities& GetCapabilities() const override;
+	Size  GetCellSize() override;
+	void  Put(const String& bytes) override;
+	void  Sync() override;
+	void  SetCursor(Point cell, bool visible) override;
+	bool  WaitInput(int ms) override;
+	String ReadInput() override;
+	void  WakeUp() override;
+
+	// fixed geometry and pinned capabilities, no real tty
+	void   SetSize(Size cells);
+	void   SetCapabilities(const TuiCapabilities& caps);
+
+	// scripted input
+	void   FeedKeys(const String& vt_bytes);
+	void   FeedClick(Point cell, int button = 0, dword mods = 0);
+	void   FeedResize(Size cells);
+
+	// observation
+	String DumpText(bool trim_right = true) const;
+	String DumpAttrs() const;
+	String DumpBytes() const;
+	void   ClearBytes();
+
+	// cell capture & access
+	void   CaptureScreen();
+	const Vector<VTCell>& GetCapturedCells() const        { return captured_cells; }
+	Size   GetCapturedSize() const                        { return captured_size; }
+	Point  GetCursorPos() const                           { return cursor_pos; }
+	bool   IsCursorVisible() const                        { return cursor_visible; }
+
+private:
+	bool            started;
+	Size            size;
+	TuiCapabilities caps;
+	String          input_queue;
+	String          emitted_bytes;
+	Point           cursor_pos;
+	bool            cursor_visible;
+
+	// snapshot buffer
+	mutable Size           captured_size;
+	mutable Vector<VTCell> captured_cells;
+};
+
+TuiTerminalHeadless& GetTuiTerminalHeadless();
+void SetTuiTerminalOverride(TuiTerminal *term);
+TuiTerminal *GetTuiTerminalOverride();
+
+END_UPP_NAMESPACE
+
+#endif
diff -uNr -x '*.o' -x '*.a' -x '*.obj' CtrlCore_a/TuiTerminal.h CtrlCore_b/TuiTerminal.h
--- a/TuiTerminal.h	1970-01-01 02:00:00.000000000 +0200
+++ b/TuiTerminal.h	2026-09-15 13:31:22.656199500 +0300
@@ -0,0 +1,57 @@
+// CtrlCoreTUI: terminal I/O seam (phase 01/02). The TUI backend does all display
+// through a TuiTerminal, never through OS window calls. Three implementations
+// exist or will exist behind this interface:
+//   1. TuiTermVT (TuiTermVT.cpp)          -- the real VT/termios implementation
+//   2. TuiTerminalHeadless (phase 13)     -- in-memory buffer for snapshot tests
+//   3. the Windows legacy-console one (phase 11)
+// A corpus of three users is what nails the seam's shape.
+
+#ifndef _CtrlCore_TuiTerminal_h_
+#define _CtrlCore_TuiTerminal_h_
+
+NAMESPACE_UPP
+
+struct TuiCapabilities {
+	int  colors        = 16;     // 16, 256 or 1 << 24
+	bool mouse         = false;  // SGR 1006
+	bool mouse_pixels  = false;  // SGR-Pixels 1016
+	bool kitty_keys    = false;  // CSI > 1 u
+	bool win32_input   = false;  // Windows Terminal win32-input-mode
+	bool osc52_write   = false;
+	bool osc11_query   = false;
+	Color osc11_bg     = Null;
+	bool sixel         = false;
+	bool kitty_gfx     = false;
+	bool sync_output   = false;  // CSI ?2026h/l (mode 2026, "synchronized output")
+	bool blocks_2x2    = true;
+	bool blocks_2x3    = false;
+	bool blocks_2x4    = false;
+};
+
+class TuiScreen;
+
+struct TuiTerminal {
+	virtual ~TuiTerminal() {}
+	virtual bool  Start() = 0;
+	virtual void  Stop() = 0;
+	virtual const TuiCapabilities& GetCapabilities() const = 0;
+	virtual Size  GetCellSize() = 0;
+	virtual void  Put(const String& bytes) = 0;
+	virtual void  Sync() = 0;
+	virtual void  SetCursor(Point cell, bool visible) = 0;
+	virtual bool  WaitInput(int ms) = 0;
+	virtual String ReadInput() = 0;
+	virtual void  WakeUp() = 0;
+
+	// Phase 11 seam extension: direct cell writing for drivers like Windows Console API.
+	// Returns true if handled directly, false to fall back to byte-oriented Put() flush.
+	virtual bool  PutCells(const TuiScreen& screen, const Vector<Rect>& dirty) { return false; }
+};
+
+TuiTerminal& TheTuiTerminal();
+void         TuiStartTerminal();
+void         TuiStopTerminal();
+
+END_UPP_NAMESPACE
+
+#endif
