+// CtrlCoreTUI: class Ctrl platform payload (GUIPLATFORM_CTRL_DECLS_INCLUDE).
+// Included inside 'class Ctrl' in CtrlCore.h.
+// EndSession inline model: CocoCtrl.h:21-22.
+//
+// PaintWinBarBackground/PaintWinBar: CtrlDraw.cpp:420,424 call these behind
+// `#if defined(PLATFORM_WIN32) && !defined(VIRTUALGUI)`, and the host Windows
+// keeps PLATFORM_WIN32 defined even under flagTUI, so Ctrl must offer them.
+// Empty stubs for the gate (a TUI has no native title bar); Win32Ctrl.h:48-49
+// is the declaration model, Win32Proc.cpp:137,148 the definition model.
+
+private:
+	void   PaintWinBarBackground(SystemDraw& w, const Rect& clip);
+	void   PaintWinBar(SystemDraw& w, const Rect& clip);
+
+public:
+	// CtrlCoreTUI 06/01: was an inert stub through gate_flag (matching
+	// CocoCtrl.h's own choice, since Cocoa's real quit path runs through
+	// NSApplication instead) -- made real here because the panic key
+	// (TuiKbd.cpp, default Ctrl+Alt+Q) needs it to actually end every
+	// nested Ctrl::EventLoop, the way Win32Wnd.cpp's own EndSession() does
+	// (EndSessionLoopNo = EventLoopNo; every level's own
+	// `ctx.loop_no <= EndSessionLoopNo` check, already in EventLoopIteration
+	// since gate_flag, then disqualifies it).
+	static void      EndSession()              { EndSessionLoopNo = EventLoopNo; }
+	static bool      IsEndSession()            { return EndSessionLoopNo >= EventLoopNo; }
+#ifdef PLATFORM_WIN32
+	static int       GetCaretBlinkTime()       { return ::GetCaretBlinkTime(); }
+#else
+	static int       GetCaretBlinkTime()       { return 500; }
+#endif
+
+	// CtrlCoreTUI 05/01 (gate_window): the window layer. One terminal, one
+	// popup stack (main window plus menus/droplists/modals), bottom-to-top --
+	// VirtualGui.h's topctrl/invalid/PaintScene/GetClipBound/FindTopCtrl/NewTop
+	// is the model (a single composited surface, not per-window native
+	// handles), simplified: no synthetic title-bar "frame" Ctrl (a TUI paints
+	// no title bar at all, PaintWinBar* above are already no-ops) and no
+	// separate "desktop" Ctrl (leftover space around a smaller-than-terminal
+	// main window is a plain paper fill in PaintScene, not a StaticRect).
+	static Vector<Ctrl *> topctrl;
+	static bool           invalid;
+
+	static void Invalidate()                   { invalid = true; }
+	static Rect GetClipBound(const Vector<Rect>& inv, const Rect& r);
+	static void PaintScene(SystemDraw& draw);
+	static void DoPaint();
+
+	// Resizes TheTuiScreen() and every owner-less (main) TopWindow to the
+	// current terminal size when it changed since the last call; returns
+	// whether anything changed. Polled once per event-loop turn from
+	// ProcessEvent (TuiWnd.cpp) -- WINDOW_BUFFER_SIZE_EVENT/SIGWINCH (phase
+	// 01) only set a pending flag inside TuiTermVT.cpp, they do not call
+	// back into Ctrl.
+	static bool TuiSyncResize();
+	static void TuiDumpPeriodicSnapshot();
+	static int  TuiGetDumpInterval();
+
+	int  FindTopCtrl() const;
+	void NewTop()                              { SetTop(new Top); GetTop()->owner_window = NULL; }
+
+	// CtrlCoreTUI 06/01: DispatchKey/SyncCaret are private Ctrl members --
+	// VirtualGui's own DoKeyFB (the model for this) gets access only because
+	// it is itself a Ctrl member function (VirtualGui/Ctrl.h). TuiKbd.cpp's
+	// decoder is a free function, so it calls this thin wrapper instead of
+	// either directly.
+	static bool TuiDispatchKey(dword keycode, int count, bool synth_keyup = true);
+
+	// CtrlCoreTUI 06/02 (gate_input, mouse half): routing modelled on
+	// Ctrl::DoMouseFB (VirtualGui/Event.cpp) -- capture redirection, hit
+	// test through the popup stack (topctrl, phase 05, back-to-front so a
+	// higher popup wins), and window-activation-on-click. No desktop
+	// fallback (no desktop Ctrl exists in this backend, phase 05).
+	static void  DoMouseTui(int event, Point p, int zdelta);
+
+private:
+	friend struct TuiDnDLoop;
+	static void  MouseEventTui(Ptr<Ctrl> t, int event, Point p, int zdelta);
+	static Ctrl *FindMouseTopCtrl(Point p);
+
