+// CtrlCoreTUI 06/02 (gate_input, mouse half): decode SGR mouse reports into
+// U++ mouse events. Declarations shared with TuiKbd.cpp, which owns the one
+// VTInStream both keyboard and mouse decoding share (one byte stream, one
+// parser instance).
+
+#ifndef _CtrlCore_TuiMouse_h_
+#define _CtrlCore_TuiMouse_h_
+
+#include <TerminalCore/TerminalCore.h>
+
+NAMESPACE_UPP
+
+// Called from TuiKbd.cpp's CSI handler whenever seq.mode == '<' (the SGR
+// mouse private marker) -- TuiKbd.cpp owns the parser and routes to this
+// rather than each file installing its own WhenCsi handler on the same
+// VTInStream.
+void TuiHandleMouseCsi(const VTInStream::Sequence& seq);
+
+// Dispatches the newest coalesced motion/hover report, if any, and clears
+// it. Any-event tracking (CSI ?1003h) can report once per cell of movement,
+// far more often than the paint loop needs; called once per event-loop turn
+// (from TuiKbd.cpp's TuiProcessInput, which is itself called once per turn)
+// so only the latest position each turn actually reaches Ctrl::DoMouseTui.
+bool TuiFlushPendingMotion();
+
+END_UPP_NAMESPACE
+
+#endif
