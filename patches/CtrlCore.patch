diff -uNr -x '*.o' -x '*.a' -x '*.obj' CtrlCore_a/TuiMouse.cpp CtrlCore_b/TuiMouse.cpp
--- a/TuiMouse.cpp	1970-01-01 02:00:00.000000000 +0200
+++ b/TuiMouse.cpp	2026-09-15 19:02:49.491727600 +0300
@@ -0,0 +1,159 @@
+#include <CtrlCore/CtrlCore.h>
+
+#if defined(PLATFORM_TUI) && !defined(VIRTUALGUI)
+
+#include "TuiTerminal.h"
+#include "TuiFontSys.h"
+#include "TuiMouse.h"
+
+NAMESPACE_UPP
+
+// CtrlCoreTUI 06/02 (gate_input, mouse half): SGR mouse reports (CSI ?1006h,
+// enabled from phase 01/02 alongside ?1000h/?1002h/?1003h) decoded into U++
+// mouse events. Cell granularity is the contract (the plan doc's own
+// precision table -- SGR-Pixels is xterm/kitty/foot/WezTerm only, not
+// Windows Terminal/conhost, so it is a bonus, never assumed); pixel = cell
+// centre, never a cell's top-left, so a click on the boundary between two
+// widgets is never ambiguous.
+
+namespace {
+
+bool sLeft, sRight, sMiddle;
+Point sMousePos; // last known position, in Ctrl's pixel space
+
+Point CellToPixel(int cellx, int celly)
+{
+	Size cs = TuiCellSize();
+	return Point(cellx * cs.cx + cs.cx / 2, celly * cs.cy + cs.cy / 2);
+}
+
+// ---- double/triple click synthesis (task 6) -----------------------------
+// VT mouse reports carry no click count. Ctrl::DispatchMouse (common,
+// CtrlMouse.cpp) already upgrades a plain xxxDOWN to xxxTRIPLE by itself
+// *if* it was preceded by a matching xxxDOUBLE at the same position within
+// GetKbdDelay() -- its own leftdbltime/leftdblpos are private to that file,
+// so this backend only ever has to decide the *second* click of a pair
+// (send DOUBLE instead of DOWN); the common code takes it from there for a
+// third.
+struct LastClick { int button = -1; Point pos; int64 time = 0; } sLastClick;
+
+int ClassifyDown(int button, Point p, int baseEvent, bool force_dbl = false)
+{
+	bool dbl = force_dbl || (sLastClick.button == button && sLastClick.pos == p
+	        && msecs() - sLastClick.time < Ctrl::GetKbdDelay());
+	sLastClick.button = dbl ? -1 : button; // reset after a double: a third
+	                                        // click is sent as plain DOWN and
+	                                        // it is common code's own state
+	                                        // (set the moment DOUBLE ships)
+	                                        // that promotes it to TRIPLE.
+	sLastClick.pos = p;
+	sLastClick.time = msecs();
+	return dbl ? (baseEvent & ~Ctrl::ACTION) | Ctrl::DOUBLE : baseEvent;
+}
+
+// ---- motion coalescing (task 4) -----------------------------------------
+// Any-event tracking (?1003h) can report once per cell of movement -- far
+// more often than the paint loop needs -- so only the newest one per turn
+// is ever actually dispatched. Remembers which *event* to send, not just a
+// position: a hover move (no button held) is MOUSEMOVE, but motion while a
+// button is held must stay a MIDDLE/LEFT/RIGHTDRAG or Ctrl::DispatchMouse's
+// own drag-distance/capture logic never sees it as a drag.
+bool  sHasPendingMotion;
+int   sPendingMotionEvent;
+Point sPendingMotionPos;
+
+} // anonymous namespace
+
+bool TuiFlushPendingMotion()
+{
+	if(!sHasPendingMotion)
+		return false;
+	sHasPendingMotion = false;
+	sMousePos = sPendingMotionPos;
+	Ctrl::DoMouseTui(sPendingMotionEvent, sPendingMotionPos, 0);
+	return true;
+}
+
+void TuiHandleMouseCsi(const VTInStream::Sequence& seq)
+{
+	if(seq.mode != '<' || (seq.opcode != 'M' && seq.opcode != 'm'))
+		return; // not an SGR mouse report
+
+	int b = seq.GetInt(1, 0);
+	int x = seq.GetInt(2, 1);
+	int y = seq.GetInt(3, 1);
+	bool release = seq.opcode == 'm';
+	bool dbl_flag = (b & 128) != 0;
+	b &= ~128;
+
+	// SGR coordinates are 1-based; cells are 0-based (plan's own "coordinate
+	// off-by-one" risk note).
+	Point cell(x - 1, y - 1);
+	Point p = (TheTuiTerminal().GetCapabilities().mouse_pixels)
+	          ? Point(x, y)     // ?1016h: already sub-cell pixel coordinates
+	          : CellToPixel(cell.x, cell.y);
+
+	if(b & 64) {
+		// Wheel: buttons 64/65 vertical, 66/67 horizontal (plan's table).
+		// zdelta uses the same +-120-per-notch convention Timing.cpp's own
+		// zdelta/120 step computation expects.
+		int which = b & 3;
+		if(which == 0 || which == 1) {
+			int zdelta = which == 0 ? 120 : -120;
+			sMousePos = p;
+			Ctrl::DoMouseTui(Ctrl::MOUSEWHEEL, p, zdelta);
+		}
+		else {
+			static bool logged;
+			if(!logged) {
+				logged = true;
+				RLOG("TuiMouse: horizontal wheel (SGR button " << b
+					<< ") has no CtrlLib event to map to; dropped.");
+			}
+		}
+		return;
+	}
+
+	int btn = b & 3; // 0 left, 1 middle, 2 right, 3 = none (release or plain motion)
+	bool motion = (b & 32) != 0;
+
+	if(motion) {
+		// Both hover and dragging motion: coalesce as MOUSEMOVE.
+		// Standard U++ DispatchMouse and captureCtrl expect MOUSEMOVE
+		// while GetMouseLeft() is true to drive SliderCtrl and ScrollBar dragging.
+		sHasPendingMotion = true;
+		sPendingMotionEvent = Ctrl::MOUSEMOVE;
+		sPendingMotionPos = p;
+		sMousePos = p;
+		return;
+	}
+
+	int event;
+	if(release) {
+		if(btn == 0 || (btn == 3 && sLeft))        { event = Ctrl::LEFT | Ctrl::UP; sLeft = false; }
+		else if(btn == 1 || (btn == 3 && sMiddle)) { event = Ctrl::MIDDLE | Ctrl::UP; sMiddle = false; }
+		else if(btn == 2 || (btn == 3 && sRight))  { event = Ctrl::RIGHT | Ctrl::UP; sRight = false; }
+		else return;
+	}
+	else {
+		switch(btn) {
+		case 0: event = Ctrl::LEFT;   sLeft   = true; break;
+		case 1: event = Ctrl::MIDDLE; sMiddle = true; break;
+		case 2: event = Ctrl::RIGHT;  sRight  = true; break;
+		default: return;
+		}
+		event = ClassifyDown(btn, cell, event | Ctrl::DOWN, dbl_flag);
+	}
+
+	sMousePos = p;
+	Ctrl::DoMouseTui(event, p, 0);
+}
+
+bool  GetMouseLeft()   { return sLeft; }
+bool  GetMouseRight()  { return sRight; }
+bool  GetMouseMiddle() { return sMiddle; }
+Point GetMousePos()    { return sMousePos; }
+
+END_UPP_NAMESPACE
+
+#endif
