+
+// CtrlCoreTUI 10/01: Intra-app drag and drop implementation.
+// LocalLoop-driven DnDLoop tracking target, caret position, and delivering
+// DropEvents. Inter-app drops fail cleanly as DND_NONE.
+
+Ptr<Ctrl> sDnDSource;
+
+Ctrl *Ctrl::GetDragAndDropSource()
+{
+	return sDnDSource;
+}
