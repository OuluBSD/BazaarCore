+{
+}
+
+void TopWindow::SyncTitle()
+{
+	GuiLock __;
+	SyncCaption();
+	RefreshFrame();
+}
+
+// The one place a TUI *can* show a window title: the terminal emulator's own
+// window/tab title, via OSC 2. Purely cosmetic (most multiplexers show it,
+// some terminals don't), so failure has no functional consequence -- no
+// capability gate needed, unlike sixel/kitty-graphics.
+void TopWindow::SyncCaption()
+{
+	GuiLock __;
+	String s;
+	s << "\x1b]2;" << ToUtf8(GetTitle()) << "\x07";
+	TheTuiTerminal().Put(s);
+}
+
+void TopWindow::Open(Ctrl *owner)
+{
+	GuiLock __;
+	if(!owner && !GetActiveWindow() && Ctrl::GetTopCtrls().IsEmpty()) {
+		// Main window: always fills the terminal (D1 -- a layer-1 backend is
+		// maximised by default), regardless of whatever rect the app asked
+		// for before calling Open(). TuiSyncResize (TuiCtrl.cpp) keeps it
+		// that way across resizes using the same "no owner" test.
+		SetRect(GetWorkArea());
+	}
+	else {
+		if(!owner)
+			owner = GetActiveWindow();
+		if(!owner && Ctrl::GetTopCtrls().GetCount() > 0)
+			owner = Ctrl::GetTopCtrls().Top();
+
+		Rect r = GetRect();
+		if(r.IsEmpty())
+			r = GetDefaultWindowRect();
+		Size cell = TuiCellSize();
+		if(r.left == 0 && r.top == 0) {
+			Size sz = r.GetSize();
+			sz.cx = CeilDiv(sz.cx, cell.cx) * cell.cx;
+			sz.cy = CeilDiv(sz.cy, cell.cy) * cell.cy;
+			if(!frameless)
+				sz += 2 * cell;
+			if(owner && center == 1)
+				r = owner->GetRect().CenterRect(sz);
+			else if(center)
+				r = GetWorkArea().CenterRect(sz);
+			else
+				r = Rect(Point(0, 0), sz);
+		}
+		Rect wa = GetWorkArea();
+		if(r.GetWidth() > wa.GetWidth())
+			r.right = r.left + wa.GetWidth();
+		if(r.GetHeight() > wa.GetHeight())
+			r.bottom = r.top + wa.GetHeight();
+		r.left = max(wa.left, min(r.left, wa.right - r.GetWidth()));
+		r.top = max(wa.top, min(r.top, wa.bottom - r.GetHeight()));
+		int w = CeilDiv(r.GetWidth(), cell.cx) * cell.cx;
+		int h = CeilDiv(r.GetHeight(), cell.cy) * cell.cy;
+		int x = FloorDiv(r.left, cell.cx) * cell.cx;
+		int y = FloorDiv(r.top, cell.cy) * cell.cy;
+		r = RectC(x, y, w, h);
+		if(r.right > wa.right)
+			r.Offset(wa.right - r.right, 0);
+		if(r.bottom > wa.bottom)
+			r.Offset(0, wa.bottom - r.bottom);
+		if(r.left < wa.left)
+			r.left = wa.left;
+		if(r.top < wa.top)
+			r.top = wa.top;
+		SetRect(r);
+	}
+	PopUp(owner, false, true, false, false);
+	SyncCaption();
+}
+
+void TopWindow::Open()
+{
+	Open(GetActiveWindow());
+}
+
+void TopWindow::OpenMain()
+{
+	Open(NULL);
+}
