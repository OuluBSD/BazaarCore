@@ -0,0 +1,92 @@
+// CtrlCoreTUI: TUI backend platform header (GUIPLATFORM_INCLUDE, selected at
+// CtrlCore.h:58). This is included *outside* 'namespace Upp' (CtrlCore.h:84),
+// so the namespace is opened here, Win32Gui.h model.
+//
+// gate_flag: the stub SystemDraw/BackDraw/ImageDraw surface. No op touches
+// cells yet -- the cell model (TuiScreen) and the VT emitter land in phases
+// 02-04. DrawDragRect is not needed (uppsrc's common CtrlClip.cpp handles it
+// via the painting surface, and the VirtualGui-only DrawDragRect does not
+// exist in this tree for native backends).
+//
+// phase 03/01: TuiFontSys.h is included here, at file scope outside
+// 'namespace Upp', because it opens/closes that namespace itself
+// (NAMESPACE_UPP/END_UPP_NAMESPACE, the TuiTerminal.h pattern) -- including
+// it from inside the 'namespace Upp' block below would nest a second Upp
+// namespace and silently break every UPP::-qualified call to it from
+// TuiGuiA.h's GUI_APP_MAIN. TuiDraw.h (phase 04/01) is included here for the
+// same reason.
+#include "TuiFontSys.h"
+#include "TuiDraw.h"
+#include "TuiRaster.h"
+#include "TuiIcon.h"
+#include "TuiGraphics.h"
+#include "TuiClip.h"
+#include "TuiLook.h"
+#include "TuiTerminal.h"
+
+#define GUI_TUI
+
+namespace Upp {
+
+class SystemDraw : public TuiDraw {
+public:
+	SystemDraw() {}
+	virtual ~SystemDraw() {}
+};
+
+class BackDraw : public SystemDraw {
+	Size   size;
+	Draw  *painting;
+	Point  painting_offset;
+
+public:
+	virtual bool IsPaintingOp(const Rect& r) const;
+
+public:
+	void Put(SystemDraw& w, int x, int y);
+	void Put(SystemDraw& w, Point p)            { Put(w, p.x, p.y); }
+
+	void Create(SystemDraw& w, int cx, int cy);
+	void Create(SystemDraw& w, Size sz)         { Create(w, sz.cx, sz.cy); }
+	void Destroy();
+
+	void SetPaintingDraw(Draw& w, Point off)   { painting = &w; painting_offset = off; }
+
+	BackDraw();
+	~BackDraw();
+};
+
+// CtrlCoreTUI 04/01: real rasterisation (SImageDraw, the software renderer),
+// not a SystemDraw-derived stub -- application code and Chameleon image
+// synthesis need actual pixels here, and phase 09 downsamples the result for
+// sixel/kitty-graphics display. VirtualGui.h's ImageDraw is the model: with
+// SImageDraw doing the real work, nothing else needs to be declared.
+class ImageDraw : public SImageDraw {
+public:
+	ImageDraw(Size sz) : SImageDraw(sz) {}
+	ImageDraw(int cx, int cy) : SImageDraw(cx, cy) {}
+};
+
+// StandardDialogIds__ provides IDOK/IDCANCEL/... on non-Win32. On Windows those
+// names are windows.h macros everywhere (host platform is WIN32 even under
+// flagTUI), so the enum would collide after any platform include. Skeleton.h:94
+// is the precedent for the guard.
+#ifndef PLATFORM_WIN32
+#include <CtrlCore/stdids.h>
+#endif
+
+// CtrlCoreTUI 05/01: which Ctrl a popped-up window is owned by (Ctrl::GetOwner()
+// reads it back). VirtualGui.h's own owner_window is the model.
+#define GUIPLATFORM_CTRL_TOP_DECLS Ctrl *owner_window = NULL;
+
+#define GUIPLATFORM_CTRL_DECLS_INCLUDE "TuiCtrl.h"
+
+#define GUIPLATFORM_PASTECLIP_DECLS \
+	bool dnd; \
+	friend struct TuiDnDLoop;
+
+#define GUIPLATFORM_TOPWINDOW_DECLS_INCLUDE "TuiTop.h"
+
+}
+
+#define GUIPLATFORM_INCLUDE_AFTER "TuiGuiA.h"
