+	// it should always repaint a scrolled view through ordinary invalidation
+	// instead. Asserting is the desired outcome (plan's own Risk note): a
+	// widget that reaches here needs a phase 08 entry, not a silent Invalidate.
+	ASSERT(!"WndScrollView called under GUIPLATFORM_NOSCROLL");
+	Invalidate();
+}
+
+void Ctrl::PopUp(Ctrl *owner, bool savebits, bool activate, bool dropshadow, bool topmost)
+{
+	// savebits ignored (plan: "a full repaint of the covered area is cheap
+	// and the cell buffer diff makes it nearly free"). dropshadow is a
+	// phase 07 theme option, default off, so also ignored here -- nothing
+	// currently turns it on. topmost is meaningless beyond topctrl's own
+	// order (there is no separate OS z-order to fight).
+	GuiLock __;
+	ASSERT(!IsChild() && !IsOpen() && FindTopCtrl() < 0);
+	Size cs = TuiCellSize();
+	if(cs.cx > 0 && cs.cy > 0) {
+		Rect r = GetRect();
+		int w = CeilDiv(r.GetWidth(), cs.cx) * cs.cx;
+		int h = CeilDiv(r.GetHeight(), cs.cy) * cs.cy;
+		int x = FloorDiv(r.left, cs.cx) * cs.cx;
+		int y = FloorDiv(r.top, cs.cy) * cs.cy;
+		SetWndRect(RectC(x, y, w, h));
+	}
+	NewTop();
+	if(owner) {
+		Ctrl *ow = owner->GetTopWindow();
+		if(!ow)
+			ow = owner->GetTopCtrl();
+		if(ow && ow != this && GetTop())
+			GetTop()->owner_window = ow;
+	}
+	topctrl.Add(this);
+	isopen = true;
+	popup = true;
+	RefreshLayoutDeep();
+	if(activate)
+		SetFocusWnd();
+	Invalidate();
+}
