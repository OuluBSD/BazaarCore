+
+// Terminal graphics protocol seam (Phase 09/02)
+struct TuiGraphics {
+	virtual ~TuiGraphics() {}
+	virtual bool CanDisplay() const = 0;
+	virtual bool Display(const Rect& cells, const Image& img) = 0;
+	virtual void Erase(const Rect& cells) = 0;
