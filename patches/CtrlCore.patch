diff -uNr -x '*.o' -x '*.a' -x '*.obj' CtrlCore_a/TuiDraw.h CtrlCore_b/TuiDraw.h
--- a/TuiDraw.h	1970-01-01 02:00:00.000000000 +0200
+++ b/TuiDraw.h	2026-09-15 17:19:30.096159000 +0300
@@ -0,0 +1,127 @@
+// CtrlCoreTUI 04/01 (gate_text): TuiDraw.cpp turns Draw operations into cells.
+// Declarations shared across TUI backend files.
+
+#ifndef _CtrlCore_TuiDraw_h_
+#define _CtrlCore_TuiDraw_h_
+
+#include <Draw/Draw.h>
+#include "TuiScreen.h"
+
+NAMESPACE_UPP
+
+// The single TuiScreen every SystemDraw instance writes into. This is a
+// layer-1 backend (D1): one terminal, one composited surface -- several
+// independent OS-level windows sharing one terminal is phase 14's optional
+// VirtualGui host, not this backend. Sized by Ctrl::TuiSyncResize()
+// (TuiCtrl.cpp, phase 05), polled once per event-loop turn from
+// Ctrl::ProcessEvent; TuiInitDraw() deliberately does not size it itself,
+// since terminal dimensions aren't known until the terminal is started, and
+// a probe that never starts a real terminal may still size it by hand.
+TuiScreen& TheTuiScreen();
+
+// One-time TUI backend draw-model init, called from GUI_APP_MAIN (TuiGuiA.h)
+// right after TuiInitFontSys(). Ctrl::GlobalBackBuffer(true): TuiScreen
+// already *is* the double buffer (phase 02), so Ctrl must not also allocate
+// its own per-window back buffer (Coco.h's BackDraw is the same idea, "Dummy
+// only, as we are running in GlobalBackBuffer mode").
+void TuiInitDraw();
+
+// Floor/ceil division for pixel<->cell conversion, correct for negative
+// pixel coordinates (Rect_'s own operator/ and % truncate toward zero).
+// Shared by TuiDraw.cpp's own coordinate conversion and TuiWnd.cpp's
+// WndSetPos cell-grid snapping (phase 05).
+int FloorDiv(int a, int b);
+int CeilDiv(int a, int b);
+
+// Widget attribution helpers for audit and user gate (Phase 13)
+void        TuiSetPaintingCtrl(const Ctrl *ctrl);
+const Ctrl *TuiGetPaintingCtrl();
+
+struct TuiPaintingCtrlScope {
+	const Ctrl *prev;
+	TuiPaintingCtrlScope(const Ctrl *c) {
+		prev = TuiGetPaintingCtrl();
+		TuiSetPaintingCtrl(c);
+	}
+	~TuiPaintingCtrlScope() {
+		TuiSetPaintingCtrl(prev);
+	}
+};
+
+class TuiDraw : public Draw {
+public:
+	TuiDraw();
+	virtual ~TuiDraw();
+
+	virtual dword GetInfo() const override;
+	virtual Size  GetPageSize() const override;
+
+	virtual void BeginOp() override;
+	virtual void EndOp() override;
+	virtual void OffsetOp(Point p) override;
+	virtual bool ClipOp(const Rect& r) override;
+	virtual bool ClipoffOp(const Rect& r) override;
+	virtual bool ExcludeClipOp(const Rect& r) override;
+	virtual bool IntersectClipOp(const Rect& r) override;
+	virtual bool IsPaintingOp(const Rect& r) const override;
+	virtual Rect GetPaintRect() const override;
+
+	virtual void DrawRectOp(int x, int y, int cx, int cy, Color color) override;
+	virtual void SysDrawImageOp(int x, int y, const Image& img, Color color) override;
+	virtual void SysDrawImageOp(int x, int y, const Image& img, const Rect& src, Color color) override;
+	virtual void DrawImageOp(int x, int y, int cx, int cy, const Image& img, const Rect& src, Color color) override;
+	virtual void DrawLineOp(int x1, int y1, int x2, int y2, int width, Color color) override;
+
+	virtual void DrawPolyPolylineOp(const Point *vertices, int vertex_count,
+	                                const int *counts, int count_count,
+	                                int width, Color color, Color doxor) override;
+	virtual void DrawPolyPolyPolygonOp(const Point *vertices, int vertex_count,
+	                                   const int *subpolygon_counts, int scc,
+	                                   const int *disjunct_polygon_counts, int dpcc,
+	                                   Color color, int width, Color outline,
+	                                   uint64 pattern, Color doxor) override;
+	virtual void DrawArcOp(const Rect& rc, Point start, Point end, int width, Color color) override;
+	virtual void DrawEllipseOp(const Rect& r, Color color, int pen, Color pencolor) override;
+	virtual void DrawTextOp(int x, int y, int angle, const wchar *text, Font font,
+	                        Color ink, int n, const int *dx) override;
+	virtual void DrawDrawingOp(const Rect& target, const Drawing& w) override;
+	virtual void DrawPaintingOp(const Rect& target, const Painting& w) override;
+
+	virtual Size GetNativeDpi() const override;
+	virtual void BeginNative() override;
+	virtual void EndNative() override;
+	virtual int  GetCloffLevel() const override;
+
+	Point       GetOffset() const { return offset; }
+	Rect        GetClip() const   { return clip; }
+	bool        CanSetSurface()   { return false; }
+	static void Flush()           {}
+
+	friend void TuiRasteriseImage(TuiDraw& w, const Rect& dest_pixel_rect, const Image& img, const Rect& src, Color color);
+	friend void TuiDrawRasterText(TuiDraw& w, int x, int y, const wchar *text, Font font, Color ink, int n, const int *dx);
+
+protected:
+	struct Cloff : Moveable<Cloff> {
+		Point        offset;
+		Rect         clip;
+		Vector<Rect> excluded;
+	};
+	Vector<Cloff> cloff;
+	Point         offset;
+	Rect          clip;
+	Vector<Rect>  excluded;
+
+	bool   CellVisible(const Rect& cellpixels) const;
+	Rect   OutwardCellRect(Rect pixel) const;
+	Point  FloorCell(Point pixel) const;
+	void   FillCellRect(const Rect& cellrect, const VTCell& pattern);
+	void   ErrorFill(const Rect& pixelrect, const char *what);
+	void   PutGlyph(int cellx, int celly, dword chr, Color ink, word sgr = 0);
+	bool   AxisAlignedLine(Point a, Point b, Color color);
+};
+
+void TuiDrawFocus(Draw& w, const Rect& r, Color c = SColorText());
+
+END_UPP_NAMESPACE
+
+#endif
diff -uNr -x '*.o' -x '*.a' -x '*.obj' CtrlCore_a/TuiFontSys.cpp CtrlCore_b/TuiFontSys.cpp
--- a/TuiFontSys.cpp	1970-01-01 02:00:00.000000000 +0200
+++ b/TuiFontSys.cpp	2026-09-15 19:03:35.391516000 +0300
@@ -0,0 +1,171 @@
+#include <CtrlCore/CtrlCore.h>
+
+#ifdef PLATFORM_TUI
+
+#include "TuiFontSys.h"
+#include <TerminalCore/TerminalCore.h>
+
+NAMESPACE_UPP
+
+// CtrlCoreTUI 03/01 (gate_metrics): CUSTOM_FONTSYS's five functions
+// (Draw/FontInt.h) for a font system with exactly one face and exactly one
+// size -- the terminal cell. This is CUSTOM_FONTSYS's first real user in the
+// tree (FontWin32.cpp/FontFc.cpp's own `#ifndef CUSTOM_FONTSYS` guards had
+// never been exercised end to end); engaging it for flagTUI is Draw.h's job
+// (`#if defined(flagCFONTS) || defined(flagUWP) || defined(flagTUI)`), not
+// this file's -- a `#define CUSTOM_FONTSYS` written only here would never
+// reach FontWin32.cpp/FontFc.cpp, which are separately-compiled translation
+// units in a different package that only see what their own first line,
+// `#include "Draw.h"`, defines.
+
+Size TuiCellSize()
+{
+	static Size sz;
+	ONCELOCK {
+		sz = Size(8, 16);
+		String o = GetEnv("UPP_TUI_CELL");
+		int p = o.Find('x');
+		if(p < 0)
+			p = o.Find('X');
+		if(p > 0) {
+			int w = StrInt(~o + 0);
+			int h = StrInt(~o + p + 1);
+			if(w > 0 && h > 0)
+				sz = Size(w, h);
+		}
+	}
+	return sz;
+}
+
+namespace {
+
+bool StrictFonts()
+{
+	static bool strict;
+	ONCELOCK {
+		// Strict mode only when explicitly enabled via UPP_TUI_STRICT_FONTS=1.
+		// By default, standard GUI fonts (Roman, Arial, etc.) snap to cell text.
+		strict = GetEnv("UPP_TUI_STRICT_FONTS") == "1";
+	}
+	return strict;
+}
+
+void LogFontDowngrade(Font font, const char *why)
+{
+	static VectorMap<int64, bool> seen;
+	int64 key = font.AsInt64();
+	if(seen.Find(key) >= 0)
+		return;
+	seen.Add(key, true);
+	RLOG("TuiFontSys: " << font.GetFaceName() << " height " << font.GetHeight()
+		<< " is " << why << " -- " << (StrictFonts()
+			? "painting as error graphics (UPP_TUI_STRICT_FONTS=0 to downgrade)"
+			: "snapped to cell text (UPP_TUI_STRICT_FONTS=0)"));
+}
+
+} // anonymous namespace
+
+TuiFontBucket ClassifyTuiFont(Font font)
+{
+	Size cell = TuiCellSize();
+	bool synthetic_face = font.GetFace() == Font::STDFONT;
+	if(synthetic_face && font.GetHeight() == cell.cy)
+		return TUI_FONT_CELL_TEXT;
+
+	if(font.GetHeight() >= cell.cy * 2)
+		return TUI_FONT_RASTER;
+
+	const char *why = !synthetic_face ? "not the synthetic monospace face"
+	                                   : "not the cell height";
+	LogFontDowngrade(font, why);
+	return StrictFonts() ? TUI_FONT_ERROR : TUI_FONT_CELL_TEXT;
+}
+
+void TuiInitFontSys()
+{
+	Size cell = TuiCellSize();
+	Font::SetStdFont(Font(Font::STDFONT, cell.cy));
+}
+
+CommonFontInfo GetFontInfoSys(Font font)
+{
+	Size cell = TuiCellSize();
+
+	CommonFontInfo fi;
+	memset(&fi, 0, sizeof(fi));
+	fi.avewidth      = cell.cx;
+	fi.maxwidth      = cell.cx;
+	// descent = cy/4, ascent = the remainder: reproduces the plan's 12/4 split
+	// exactly at the default 16, degrades gracefully (never negative) at any
+	// other UPP_TUI_CELL height, including the 1x1 experiment size.
+	fi.descent       = max(cell.cy / 4, cell.cy > 0 ? 1 : 0);
+	fi.ascent        = cell.cy - fi.descent;
+	fi.external      = 0; // line pitch must equal the cell height exactly
+	fi.internal      = 0;
+	fi.overhang      = 0; // a cell cannot overhang
+	fi.firstchar     = 0;
+	fi.charcount     = 0x110000; // representability is decided per glyph
+	fi.default_char  = '?';
+	fi.spacebefore   = 0;
+	fi.spaceafter    = 0;
+	fi.fixedpitch    = true;  // critical: GetTextSize becomes a multiplication
+	fi.scaleable     = false; // exactly one size
+	fi.ttf           = false;
+	fi.colorimg_cy   = 0;
+	return fi;
+}
+
+GlyphInfo GetGlyphInfoSys(Font font, int chr)
+{
+	GlyphInfo gi;
+	memset(&gi, 0, sizeof(gi));
+
+	// Lone surrogate halves are never valid codepoints on their own -- the
+	// one case this layer can be sure about without asking the real host
+	// terminal, which is the only thing that actually knows what it can
+	// render.
+	if(chr >= 0xD800 && chr <= 0xDFFF) {
+		gi.width = (int16)0x8000;
+		gi.lspc  = -2;
+		gi.rspc  = 0;
+		return gi;
+	}
+
+	Size cell = TuiCellSize();
+	int  w    = GetCharWidth((dword)chr); // shared with VTCell::GetWidth() (TerminalCore)
+	gi.width  = (int16)(w * cell.cx);
+	gi.lspc   = gi.rspc = 0;
+	return gi;
+}
+
+Vector<FaceInfo> GetAllFacesSys()
+{
+	Vector<FaceInfo> list;
+	FaceInfo& f = list.Add();
+	f.name = "STDFONT";
+	f.info = Font::FIXEDPITCH;
+	return list; // exactly one face: a font picker has nothing to offer
+}
+
+String GetFontDataSys(Font font, const char *table, int offset, int size)
+{
+	return String(); // no font file
+}
+
+void RenderCharacterSys(FontGlyphConsumer& sw, double x, double y, int ch, Font fnt)
+{
+	// Outline-rendering entry point for Painter's text-as-path. There is no
+	// outline -- a terminal cell is not glyph geometry -- so this produces
+	// nothing rather than guessing. Phase 09 decides whether text inside a
+	// Painting becomes block graphics or error graphics.
+	static bool logged = false;
+	if(!logged) {
+		logged = true;
+		RLOG("TuiFontSys: RenderCharacterSys() has no meaning in a TUI build "
+			"(no glyph outlines exist); text-as-path output is empty until phase 09.");
+	}
+}
