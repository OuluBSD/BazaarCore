+		topctrl.Top()->ActivateWnd();
+}
+
+void Ctrl::SetWndForeground()
+{
+	GuiLock __;
+	int q = FindTopCtrl();
+	if(q >= 0) {
+		auto IsOwnedByThis = [&](Ctrl *c) {
+			while(c) {
+				Ctrl *owner = c->GetOwner();
+				if(owner == this) return true;
+				c = owner;
+			}
+			return false;
+		};
+		int target = topctrl.GetCount() - 1;
+		for(int i = 0; i < topctrl.GetCount(); i++) {
+			if(i != q && (IsOwnedByThis(topctrl[i]) || (!popup && topctrl[i]->IsPopUp()))) {
+				target = min(target, i - 1);
+			}
+		}
+		target = max(0, target);
+		if(q != target) {
+			topctrl.Remove(q);
+			topctrl.Insert(target, this);
+			Invalidate();
+		}
+	}
+	if(this != focusCtrl)
+		ActivateWnd();
+}
+
+bool Ctrl::IsWndForeground() const
+{
+	GuiLock __;
+	if(topctrl.IsEmpty())
+		return false;
+	if(topctrl.Top() == this)
+		return true;
+	for(int i = topctrl.GetCount() - 1; i >= 0; i--) {
+		if(topctrl[i] == this)
+			return true;
+		if(!topctrl[i]->IsPopUp())
+			break;
+	}
+	return false;
+}
