+struct TuiClipboard {
+	void   Clear()                                      { target.Clear(); }
+	void   Put(const String& fmt, const ClipData& data) { target.GetAdd(fmt) = data; }
+	bool   IsAvailable(const String& fmt) const         { return target.Find(fmt) >= 0; }
+	String Get(const String& fmt) const                 { int i = target.Find(fmt); return i >= 0 ? target[i].Render() : Null; }
+
+private:
+	VectorMap<String, ClipData> target;
+};
