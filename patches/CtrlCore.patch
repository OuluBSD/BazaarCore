+// ---- CtrlCoreTUI 05/01: window layer (VirtualGui/Wnd.cpp's PaintScene/
+// GetClipBound/FindTopCtrl is the model) ------------------------------
+
+Vector<Ctrl *> Ctrl::topctrl;
+bool           Ctrl::invalid;
+
+int Ctrl::FindTopCtrl() const
+{
+	for(int i = 0; i < topctrl.GetCount(); i++)
+		if(this == topctrl[i])
+			return i;
+	return -1;
+}
+
+Rect Ctrl::GetClipBound(const Vector<Rect>& inv, const Rect& r)
+{
+	Rect ri = Null;
+	for(int j = 0; j < inv.GetCount(); j++) {
+		Rect rr = inv[j] & r;
+		if(!rr.IsEmpty())
+			ri = IsNull(ri) ? rr : rr | ri;
+	}
+	return ri;
+}
+
+static Rect TuiScreenRectPx()
+{
+	Size cells = TheTuiScreen().GetSize();
+	Size cell = TuiCellSize();
+	return Rect(0, 0, cells.cx * cell.cx, cells.cy * cell.cy);
+}
+
+// Painted main window first (in topctrl order, which is bottom-to-top, so we
+// walk it back-to-front like VirtualGui does), then popups on top; occlusion
+// is handled by later entries simply overwriting earlier ones' cells (the
+// plan's own call: "with a cell buffer, overwriting is free and simpler than
+// region arithmetic") rather than by clip subtraction for the *painted*
+// area -- Subtract()/ExcludeClip() below still narrow what each earlier
+// (lower) entry is asked to paint, purely so a fully-hidden window's Paint()
+// isn't invoked pointlessly, not because overwriting would be wrong.
+void Ctrl::PaintScene(SystemDraw& draw)
+{
+	Rect screen_px = TuiScreenRectPx();
+	if(screen_px.IsEmpty())
+		return;
+
+	draw.Begin();
+	Vector<Rect> invalid_px;
+	invalid_px.Add(screen_px);
+	for(int i = topctrl.GetCount() - 1; i >= 0; i--) {
+		Rect r = topctrl[i]->GetRect();
+		Rect ri = GetClipBound(invalid_px, r);
+		if(!IsNull(ri)) {
+			draw.Clipoff(r);
+			topctrl[i]->UpdateArea(draw, ri - r.TopLeft());
+			draw.End();
+			Size cs = TuiCellSize();
+			Rect ex(FloorDiv(r.left, cs.cx) * cs.cx, FloorDiv(r.top, cs.cy) * cs.cy,
+			        CeilDiv(r.right, cs.cx) * cs.cx, CeilDiv(r.bottom, cs.cy) * cs.cy);
+			Subtract(invalid_px, ex);
+			draw.ExcludeClip(ex);
+		}
+	}
+	// Leftover space (a main window smaller than the terminal, D1's "honoured
+	// but centred, with the remainder painted as desktop background"): a
+	// plain paper fill, not a separate desktop Ctrl -- a layer-1 backend has
+	// nothing else to show there.
+	for(int j = 0; j < invalid_px.GetCount(); j++)
+		draw.DrawRect(invalid_px[j], SColorFace());
+	draw.End();
+}
+
+void Ctrl::DoPaint()
+{
+	if(invalid) {
+		invalid = false;
+		SystemDraw draw;
+		PaintScene(draw);
+	}
+
+	// The caret becomes the real terminal cursor (TuiScreen::SetCaret feeds
+	// TuiTerminal::SetCursor via the same batched Put() as the rest of the
+	// flush, phase 02) instead of the common PaintCaret()'s InvertColor rect
+	// -- DrawRectOp (TuiDraw.cpp) makes that rect a no-op by treating
+	// InvertColor as nothing to draw, so this is the only place the caret
+	// actually reaches the terminal. caretCtrl/WndCaretVisible are Ctrl's own
+	// common members (CtrlKbd.cpp); DoPaint is itself a Ctrl member so it can
+	// read them directly, no accessor needed.
+	// CtrlCoreTUI 06/01: CSI ?1004h focus reporting (TuiKbd.cpp) also stops
+	// the caret from blinking away while the terminal itself is unfocused --
+	// same as any native backend hiding its caret on WM_KILLFOCUS.
+	Point cell(0, 0);
+	bool  visible = false;
+	if(caretCtrl && WndCaretVisible && TuiTerminalHasFocus()) {
+		Rect abs = caretCtrl->GetCaret() + caretCtrl->GetScreenRect().TopLeft();
+		Size cs = TuiCellSize();
+		if(cs.cx > 0 && cs.cy > 0) {
+			cell = Point(max(abs.left, 0) / cs.cx, max(abs.top, 0) / cs.cy);
+			visible = true;
+		}
+	}
+	TheTuiScreen().SetCaret(cell, visible);
+
+	// Flush exactly once per loop turn (ProcessEvents calls DoPaint once),
+	// after all painting -- flushing per-widget (e.g. from WndUpdate) would
+	// emit a batch per widget instead of one per turn.
+	TheTuiScreen().Flush(TheTuiTerminal());
+}
+
+bool Ctrl::TuiSyncResize()
+{
+	static Size last;
+	Size cells = TheTuiTerminal().GetCellSize();
+	if(cells.cx <= 0 || cells.cy <= 0 || cells == last)
+		return false;
+	last = cells;
+	TheTuiScreen().SetSize(cells);
+	Rect full = TuiScreenRectPx();
+	for(int i = 0; i < topctrl.GetCount(); i++) {
+		TopWindow *w = dynamic_cast<TopWindow *>(topctrl[i]);
+		if(w && !(w->GetTop() && w->GetTop()->owner_window)) {
+			Size min = w->GetMinSize();
+			if(full.GetWidth() < min.cx || full.GetHeight() < min.cy)
+				RLOG("TuiCtrl: terminal (" << full.GetSize() << " px) is smaller than "
+					<< UPP::Name(w) << "'s minimum size (" << min << " px) -- clipping, not asserting");
+			w->SetRect(full);
+		}
+	}
+	Invalidate();
+	return true;
+}
+
+bool Ctrl::TuiDispatchKey(dword keycode, int count, bool synth_keyup)
+{
+	bool b = DispatchKey(keycode, count);
+	if(synth_keyup && !(keycode & K_KEYUP))
+		DispatchKey(keycode | K_KEYUP, count);
+	SyncCaret();
+	return b;
+}
+
+// ---- CtrlCoreTUI 06/02: mouse routing (Ctrl::DoMouseFB is the model) ----
+
+void Ctrl::MouseEventTui(Ptr<Ctrl> t, int event, Point p, int zdelta)
+{
+	if(!t || !t->IsEnabled())
+		return;
+	Rect rr = t->GetRect();
+	if((event & Ctrl::ACTION) == DOWN) {
+		t->ClickActivateWnd();
+		t->SetForeground();
+		if(ignoreclick)
+			return;
+	}
+	t->DispatchMouse(event, p - rr.TopLeft(), zdelta);
+}
+
+Ctrl *Ctrl::FindMouseTopCtrl(Point p)
+{
+	for(int i = topctrl.GetCount() - 1; i >= 0; i--)
+		if(topctrl[i]->GetRect().Contains(p))
+			return topctrl[i]->IsEnabled() ? topctrl[i] : NULL;
+	return NULL;
+}
+
+void Ctrl::DoMouseTui(int event, Point p, int zdelta)
+{
+	int a = event & Ctrl::ACTION;
+	if(a == Ctrl::UP && Ctrl::ignoreclick) {
+		EndIgnore();
+		return;
+	}
+	if(a == Ctrl::DOWN && ignoreclick)
+		return;
+	if(captureCtrl)
+		MouseEventTui(captureCtrl->GetTopCtrl(), event, p, zdelta);
+	else
+		MouseEventTui(FindMouseTopCtrl(p), event, p, zdelta);
+}
+
+static int    sTuiDumpInterval = -1;
+static String sTuiDumpDir;
+static bool   sTuiDumpEnabled = true;
+
+Vector<WString>& coreCmdLine__();
+
+static void sInitTuiDumpSettings()
+{
+	static bool inited = false;
+	if(inited) return;
+	inited = true;
+
+	sTuiDumpInterval = 1000; // default 1 second
+	String env_int = GetEnv("UPP_TUI_DUMP_INTERVAL");
+	if(!env_int.IsEmpty())
+		sTuiDumpInterval = max(50, Atoi(env_int));
+	sTuiDumpDir = GetEnv("UPP_TUI_DUMP_DIR");
+	if(GetEnv("UPP_TUI_DUMP") == "0" || GetEnv("UPP_TUI_DUMP") == "false")
+		sTuiDumpEnabled = false;
+
+	Vector<WString>& cmd = coreCmdLine__();
+	static WString s_dump_int = "--tui-dump-interval";
+	static WString s_dump_int_eq = "--tui-dump-interval=";
+	static WString s_dump_dir = "--tui-dump-dir";
+	static WString s_dump_dir_eq = "--tui-dump-dir=";
+	static WString s_no_dump = "--no-tui-dump";
+	static WString s_dump = "--tui-dump";
+
+	for(int i = 0; i < cmd.GetCount();) {
+		if(cmd[i] == s_no_dump) {
+			sTuiDumpEnabled = false;
+			cmd.Remove(i);
+			continue;
+		}
+		if(cmd[i] == s_dump) {
+			sTuiDumpEnabled = true;
+			cmd.Remove(i);
+			continue;
+		}
+		if(cmd[i] == s_dump_int && i + 1 < cmd.GetCount()) {
+			sTuiDumpInterval = max(50, Atoi(cmd[i + 1].ToString()));
+			cmd.Remove(i, 2);
+			continue;
+		}
+		if(cmd[i].StartsWith(s_dump_int_eq)) {
+			sTuiDumpInterval = max(50, Atoi(cmd[i].Mid(s_dump_int_eq.GetCount()).ToString()));
+			cmd.Remove(i);
+			continue;
+		}
+		if(cmd[i] == s_dump_dir && i + 1 < cmd.GetCount()) {
+			sTuiDumpDir = cmd[i + 1].ToString();
+			cmd.Remove(i, 2);
+			continue;
+		}
+		if(cmd[i].StartsWith(s_dump_dir_eq)) {
+			sTuiDumpDir = cmd[i].Mid(s_dump_dir_eq.GetCount()).ToString();
+			cmd.Remove(i);
+			continue;
+		}
+		i++;
+	}
+
+	if(sTuiDumpDir.IsEmpty())
+		sTuiDumpDir = AppendFileName(GetHomeDirectory(), ".local/state/u++/tuidump");
+	RealizeDirectory(sTuiDumpDir);
+}
+
+int Ctrl::TuiGetDumpInterval()
+{
+	sInitTuiDumpSettings();
+	return sTuiDumpInterval;
+}
+
+void Ctrl::TuiDumpPeriodicSnapshot()
+{
+	sInitTuiDumpSettings();
+	if(!sTuiDumpEnabled)
+		return;
+
+	String app = GetExeTitle();
+	static int sSeq = 0;
+	sSeq++;
+
+	String screen_text = TheTuiScreen().DumpText(false);
+
+	String diag;
+	diag << "=== TUI DIAGNOSTICS: " << app << " (Frame " << sSeq << ") ===\n";
+	diag << "Timestamp: " << GetSysTime() << " (uptime " << msecs() << " ms)\n";
+	diag << "Screen size: " << TheTuiScreen().GetSize() << " cells ("
+	     << TheTuiScreen().GetSize().cx * TuiCellSize().cx << "x"
+	     << TheTuiScreen().GetSize().cy * TuiCellSize().cy << " px)\n";
+	diag << "Loop level: " << Ctrl::GetLoopLevel() << "\n";
+	diag << "Top windows count: " << Ctrl::GetTopCtrls().GetCount() << "\n";
+	for(int i = 0; i < Ctrl::GetTopCtrls().GetCount(); i++) {
+		Ctrl *c = Ctrl::GetTopCtrls()[i];
+		if(c) {
+			diag << "  [" << i << "] " << UPP::Name(c) << " Rect: " << c->GetRect()
+			     << " Open: " << c->IsOpen() << " Visible: " << c->IsVisible()
+			     << " InLoop: " << c->InLoop() << "\n";
+			TopWindow *tw = dynamic_cast<TopWindow*>(c);
+			if(tw) {
+				diag << "       Title: \"" << tw->GetTitle() << "\"\n";
+			}
+		}
+	}
+	Ctrl *focus = Ctrl::GetFocusCtrl();
+	diag << "Focus ctrl: " << (focus ? UPP::Name(focus) : "none") << "\n";
+	diag << "Caret pos: " << TheTuiScreen().GetCaret() << " Visible: " << TheTuiScreen().IsCaretVisible() << "\n";
+	diag << "Color policy: " << (TheTuiScreen().GetColorPolicy() == TuiScreen::COLOR_RGB ? "RGB" : "ANSI16") << "\n";
+	diag << "Border policy: " << ChBorderPolicyValue() << "\n";
+	diag << "Overlaps: " << TheTuiScreen().GetOverlaps().GetCount() << "\n";
+	diag << "===================================================\n";
+
+	String frame_path = AppendFileName(sTuiDumpDir, Format("%s_frame_%04d.txt", app, sSeq));
+	String frame_attrs = AppendFileName(sTuiDumpDir, Format("%s_frame_%04d.attrs", app, sSeq));
+	String latest_path = AppendFileName(sTuiDumpDir, Format("%s_latest.txt", app));
+	String latest_attrs = AppendFileName(sTuiDumpDir, Format("%s_latest.attrs", app));
+	String diag_path = AppendFileName(sTuiDumpDir, Format("%s_latest.diag", app));
+
+	String screen_attrs = TheTuiScreen().DumpAttrs();
+	SaveFile(frame_path, screen_text);
+	SaveFile(frame_attrs, screen_attrs);
+	SaveFile(latest_path, screen_text);
+	SaveFile(latest_attrs, screen_attrs);
+	SaveFile(diag_path, diag);
+
+	// Also write in CWD for immediate inspection
+	SaveFile(Format("tuidump_%s_latest.txt", app), screen_text);
+	SaveFile(Format("tuidump_%s_latest.diag", app), diag);
+}
+
+void TuiStartTerminal()
+{
+	TheTuiTerminal().Start();
+}
+
+void TuiStopTerminal()
+{
+	TheTuiTerminal().Stop();
+}
+
+END_UPP_NAMESPACE
+
+#endif
