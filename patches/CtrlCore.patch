@@ -0,0 +1,713 @@
+#include <CtrlCore/CtrlCore.h>
+
+#ifdef PLATFORM_TUI
+
+#include "TuiDraw.h"
+#include <TerminalCore/TerminalCore.h>
+
+#define LLOG(x) // LOG(x)
+
+NAMESPACE_UPP
+
+// CtrlCoreTUI 04/01 (gate_text): translating Draw operations into cells. See
+// the plan doc for the full design; the notes here cover what a reader of
+// this file specifically needs.
+//
+// SystemDraw derives from Draw directly, not SDraw (uppsrc/Draw/SDraw.h) --
+// SDraw is the software rasteriser every pixel-target backend (Turtle,
+// NetDpy, rainbow/Telpp) uses to turn DrawTextOp into PutRect/PutImage, which
+// would rasterise every glyph and defeat the whole premise of this backend.
+//
+// There is no native window, so unlike the Win32 backend (DrawOpWin32.cpp's
+// SetOrg(), which nudges a real device-context origin) every op below adds
+// `offset` itself. `clip`/`excluded` are kept in ABSOLUTE (already-offset)
+// pixel space so OffsetOp alone never has to touch them -- only BeginOp/
+// EndOp save and restore the (offset, clip, excluded) triple.
+//
+// Fill order matters and is relied on: U++ text paints no background, so a
+// widget's background DrawRectOp must run before its DrawTextOp, and text
+// writes must never touch a cell's `paper` -- only `chr`/`ink`/`sgr`. Ctrl
+// always paints in that order; nothing here reorders or batches ops.
+
+TuiScreen& TheTuiScreen()
+{
+	static TuiScreen screen;
+	return screen;
+}
+
+void TuiInitDraw()
+{
+	Ctrl::GlobalBackBuffer(true);
+}
+
+static const Ctrl *sTuiPaintingCtrl = nullptr;
+
+void TuiSetPaintingCtrl(const Ctrl *ctrl)
+{
+	sTuiPaintingCtrl = ctrl;
+	TheTuiScreen().SetCurrentWriter(ctrl, ctrl ? UPP::Name(ctrl) : String());
+}
+
+const Ctrl *TuiGetPaintingCtrl()
+{
+	return sTuiPaintingCtrl;
+}
+
+// Rect_'s own operator/ and % truncate toward zero, which is wrong for a
+// floor/ceil split on negative pixel coordinates (offscreen or scrolled
+// content) -- cell 0 must own pixels [0,cw), not (-cw,0]. Declared in
+// TuiDraw.h (not anonymous-namespaced here) because TuiWnd.cpp's WndSetPos
+// (phase 05) needs the same cell-grid snapping.
+int FloorDiv(int a, int b)
+{
+	int q = a / b, r = a % b;
+	return (r != 0 && ((r < 0) != (b < 0))) ? q - 1 : q;
+}
+
+int CeilDiv(int a, int b)
+{
+	return -FloorDiv(-a, b);
+}
+
+namespace {
+
+bool StrictDraw()
+{
+	static bool strict;
+	ONCELOCK {
+		strict = GetEnv("UPP_TUI_STRICT_DRAW") != "0";
+	}
+	return strict;
+}
+
+void LogOnce(const char *key, const String& msg)
+{
+	static VectorMap<String, bool> seen;
+	if(seen.Find(key) >= 0)
+		return;
+	seen.Add(key, true);
+	RLOG("TuiDraw: " << msg);
+}
+
+} // anonymous namespace
+
+TuiDraw::TuiDraw()
+{
+	// ClipOp/ClipoffOp/IntersectClipOp only ever narrow `clip` (&=) -- they
+	// have no way to widen it -- so the starting region must stand for
+	// "everything", not Rect_'s own default-constructed (0,0,0,0), or the
+	// very first real Clipoff would intersect against zero area and nothing
+	// would ever be visible. A million pixels in every direction is not
+	// really "unbounded", but no Ctrl coordinate comes close, and staying
+	// inside int32 keeps every `+ offset`/`&` downstream simple.
+	clip = Rect(-1000000, -1000000, 1000000, 1000000);
+}
+
+dword TuiDraw::GetInfo() const
+{
+	// Deliberately NOT DRAWTEXTLINES: with that flag clear, Draw::DrawText
+	// (uppsrc/Draw/DrawText.cpp) leaves bold/italic/underline/strikeout set
+	// on the Font it hands to DrawTextOp instead of synthesising underline/
+	// strikeout itself -- so that TuiDraw.cpp receives the request intact
+	// and can emit VT underline / strikethrough SGR attributes rather than
+	// line primitives.
+	return NATIVE;
+}
+
+Size TuiDraw::GetPageSize() const
+{
+	return Size(0, 0);
+}
+
+Size TuiDraw::GetNativeDpi() const
+{
+	return Size(96, 96);
+}
+
+void TuiDraw::BeginNative()
+{
+}
+
+void TuiDraw::EndNative()
+{
+}
+
+int TuiDraw::GetCloffLevel() const
+{
+	return cloff.GetCount();
+}
+
+TuiDraw::~TuiDraw() {
+	GuiLock __;
+}
+
+#if !defined(VIRTUALGUI)
+void BackDraw::Destroy()
+{
+	GuiLock __;
+}
+
+void BackDraw::Create(SystemDraw& w, int cx, int cy) {
+	GuiLock __;
+}
+
+void BackDraw::Put(SystemDraw& w, int x, int y) {
+	GuiLock __;
+}
+#endif
+
+// ---- offset / clip stack -----------------------------------------------
+
+void TuiDraw::BeginOp()
+{
+	Cloff& c = cloff.Add();
+	c.offset = offset;
+	c.clip = clip;
+	c.excluded <<= excluded;
+}
+
+void TuiDraw::EndOp()
+{
+	ASSERT(cloff.GetCount());
+	Cloff& c = cloff.Top();
+	offset = c.offset;
+	clip = c.clip;
+	excluded = pick(c.excluded);
+	cloff.Drop();
+}
+
+// OffsetOp/ClipOp/ClipoffOp each push their own restore point (via BeginOp)
+// before narrowing -- this is not optional bookkeeping, it is what the
+// common CtrlCore call sites actually rely on. CtrlDraw.cpp's CtrlPaint does
+// `w.Offset(off); q.CtrlPaint(w, ...); w.End();` with no Begin() of its own
+// around the Offset, and Ctrl::PaintScene's per-topctrl-entry loop
+// (TuiCtrl.cpp) does the same with Clipoff: one narrowing call, one matching
+// End() per iteration, relying on the narrowing call itself to have made
+// that End() have something to pop. Win32's own SystemDraw (DrawOpWin32.cpp)
+// does exactly this via a private Begin() lazy-push; ours has no native
+// resource to lazily allocate, so it is always eager.
+void TuiDraw::OffsetOp(Point p)
+{
+	BeginOp();
+	offset += p;
+}
+
+bool TuiDraw::ClipOp(const Rect& r)
+{
+	BeginOp();
+	clip &= r + offset;
+	return !clip.IsEmpty();
+}
+
+bool TuiDraw::ClipoffOp(const Rect& r)
+{
+	BeginOp();
+	clip &= r + offset;
+	offset += r.TopLeft();
+	return !clip.IsEmpty();
+}
+
+// ExcludeClipOp/IntersectClipOp do NOT push: PaintScene calls ExcludeClip
+// once per topctrl entry, accumulating holes across the whole loop until the
+// single outer End() that started the loop's own Begin() -- they narrow the
+// *current* frame permanently for the rest of its lifetime, same asymmetry
+// Win32's own ExcludeClipOp/IntersectClipOp have (no Begin() call inside
+// either, DrawOpWin32.cpp).
+bool TuiDraw::ExcludeClipOp(const Rect& r)
+{
+	excluded.Add(r + offset);
+	return !clip.IsEmpty();
+}
+
+bool TuiDraw::IntersectClipOp(const Rect& r)
+{
+	clip &= r + offset;
+	return !clip.IsEmpty();
+}
+
+bool TuiDraw::IsPaintingOp(const Rect& r) const
+{
+	Rect abs = r + offset;
+	if(!abs.Intersects(clip))
+		return false;
+	for(const Rect& e : excluded)
+		if(e.Contains(abs))
+			return false;
+	return true;
+}
+
+Rect TuiDraw::GetPaintRect() const
+{
+	return clip - offset;
+}
+
+// ---- pixel/cell conversion, clip test, and the two write primitives ----
+//
+// Every write goes through PutGlyph (chr/ink/sgr only) or FillCellRect
+// (whole-cell replace, i.e. also sets paper) -- never both on the same
+// call -- so that "text never touches paper" holds by construction rather
+// than by every caller remembering it.
+
+Rect TuiDraw::OutwardCellRect(Rect pixel) const
+{
+	Size cell = TuiCellSize();
+	return Rect(FloorDiv(pixel.left, cell.cx), FloorDiv(pixel.top, cell.cy),
+	            CeilDiv(pixel.right, cell.cx), CeilDiv(pixel.bottom, cell.cy));
+}
+
+Point TuiDraw::FloorCell(Point pixel) const
+{
+	Size cell = TuiCellSize();
+	return Point(FloorDiv(pixel.x, cell.cx), FloorDiv(pixel.y, cell.cy));
+}
+
+bool TuiDraw::CellVisible(const Rect& cellpixels) const
+{
+	if(!clip.Intersects(cellpixels))
+		return false;
+	// `excluded` is a plain list, not a real region (several disjoint holes
+	// are possible, e.g. sibling window occlusion via Ctrl::ExcludeDHCtrls).
+	// A cell only counts as hidden when one exclude rect swallows it whole --
+	// a partly-excluded cell still renders, the same "prefer overfill" call
+	// DrawRectOp's outward rounding makes for the opposite case.
+	for(const Rect& e : excluded)
+		if(e.Contains(cellpixels))
+			return false;
+	return true;
+}
+
+void TuiDraw::FillCellRect(const Rect& cellrect, const VTCell& pattern)
+{
+	TuiScreen& screen = TheTuiScreen();
+	Size ssz = screen.GetSize();
+	Size cell = TuiCellSize();
+	Rect r = cellrect & Rect(0, 0, ssz.cx, ssz.cy);
+	for(int y = r.top; y < r.bottom; y++)
+		for(int x = r.left; x < r.right; x++) {
+			Rect cellpx(x * cell.cx, y * cell.cy, x * cell.cx + cell.cx, y * cell.cy + cell.cy);
+			if(CellVisible(cellpx))
+				screen.Fill(RectC(x, y, 1, 1), pattern, VTCell::FILL_NORMAL);
+		}
+}
+
+void TuiDraw::PutGlyph(int cellx, int celly, dword chr, Color ink, word sgr)
+{
+	TuiScreen& screen = TheTuiScreen();
+	Size ssz = screen.GetSize();
+	if(cellx < 0 || cellx >= ssz.cx || celly < 0 || celly >= ssz.cy)
+		return;
+	Size cell = TuiCellSize();
+	Rect cellpx(cellx * cell.cx, celly * cell.cy, cellx * cell.cx + cell.cx, celly * cell.cy + cell.cy);
+	if(!CellVisible(cellpx))
+		return;
+	screen.PutGlyph(cellx, celly, chr, ink, sgr);
+}
+
+void TuiDraw::ErrorFill(const Rect& pixelrect, const char *what)
+{
+	LogOnce(what, String("not representable, painting error graphics -- ") + what);
+	if(!StrictDraw())
+		return; // UPP_TUI_STRICT_DRAW=0: logged above, draw nothing instead of the loud pattern
+	Rect pixel = pixelrect & clip;
+	if(pixel.IsEmpty())
+		return;
+	VTCell pattern;
+	pattern.chr = '?';
+	pattern.ink = White();
+	pattern.paper = Magenta();
+	FillCellRect(OutwardCellRect(pixel), pattern);
+}
+
+// ---- the workhorse ops ---------------------------------------------------
+
+void TuiDraw::DrawRectOp(int x, int y, int cx, int cy, Color color)
+{
+	// InvertColor is how the common Ctrl::PaintCaret (CtrlKbd.cpp, called
+	// unconditionally after every widget's Paint()) draws the caret --
+	// CtrlCoreTUI 05/01 delegates the caret to a real terminal cursor instead
+	// (Ctrl::DoPaint, TuiCtrl.cpp), so that rect must be a no-op here or the
+	// caret would show twice.
+	if(IsNull(color) || color == InvertColor || cx <= 0 || cy <= 0)
+		return;
+	// Fills round outward: a background that leaves a one-cell gap looks
+	// broken, one cell of overfill does not.
+	Rect pixel = RectC(x, y, cx, cy) + offset;
+	pixel &= clip;
+	if(pixel.IsEmpty())
+		return;
+	Size cell = TuiCellSize();
+	Rect cellrect = OutwardCellRect(pixel);
+	// Thin horizontal line (e.g. mnemonic underline or 1px underline):
+	// If it falls inside cells that already have text, preserve the characters and apply underline.
+	if(pixel.Height() <= 2 && cell.cy > 2) {
+		TuiScreen& screen = TheTuiScreen();
+		Size ssz = screen.GetSize();
+		Rect cr = cellrect & Rect(0, 0, ssz.cx, ssz.cy);
+		bool has_text = false;
+		for(int cy = cr.top; cy < cr.bottom; cy++) {
+			for(int cx = cr.left; cx < cr.right; cx++) {
+				VTCell& c = screen.At(cx, cy);
+				if(c.chr != 0 && c.chr != ' ') {
+					has_text = true;
+					c.sgr |= VTCell::SGR_UNDERLINE;
+				}
+			}
+		}
+		if(has_text)
+			return;
+	}
+
+	VTCell pattern;
+	pattern.Paper(color);
+	FillCellRect(cellrect, pattern);
+}
+
+void TuiDraw::DrawTextOp(int x, int y, int angle, const wchar *text, Font font,
+                            Color ink, int n, const int *dx)
+{
+	int px = x + offset.x, py = y + offset.y;
+	Size cell = TuiCellSize();
+	Rect approx(px, py, px + max(n, 1) * cell.cx * 2, py + cell.cy);
+
+	if(angle != 0) {
+		// Vertical text (angle == 900, one character per row) might be worth
+		// a special case later; any angle is error graphics for now.
+		ErrorFill(approx, "DrawTextOp: angle != 0 (rotated text)");
+		return;
+	}
+	TuiFontBucket bucket = ClassifyTuiFont(font);
+	if(bucket == TUI_FONT_RASTER) {
+		TuiDrawRasterText(*this, x, y, text, font, ink, n, dx);
+		return;
+	}
+	if(bucket != TUI_FONT_CELL_TEXT) {
+		ErrorFill(approx, "DrawTextOp: font is not TUI_FONT_CELL_TEXT (TuiFontSys::ClassifyTuiFont)");
+		return;
+	}
+
+	word sgr = 0;
+	if(font.IsBold())      sgr |= VTCell::SGR_BOLD;
+	if(font.IsItalic())    sgr |= VTCell::SGR_ITALIC;
+	if(font.IsUnderline()) sgr |= VTCell::SGR_UNDERLINE;
+	if(font.IsStrikeout()) sgr |= VTCell::SGR_STRIKEOUT;
+
+	int celly = FloorCell(Point(px, py)).y;
+	int curpx = px;
+	for(int i = 0; i < n; i++) {
+		wchar chr = text[i];
+		int w = GetCharWidth((dword)chr); // shared with VTCell::GetWidth() (TerminalCore, phase 02/03)
+		int adv = dx ? dx[i] : w * cell.cx;
+		if(w > 0) {
+			if(curpx % cell.cx != 0)
+				LogOnce("drawtext-offgrid",
+				        "DrawTextOp: a character position did not land on a cell boundary; "
+				        "text will drift by a fraction of a cell (off-grid coordinate from CtrlLib)");
+			int cellx = FloorDiv(curpx, cell.cx);
+			PutGlyph(cellx, celly, chr, ink, sgr);
+			if(w == 2)
+				PutGlyph(cellx + 1, celly, 1, ink, sgr); // continuation, VTPage::CellAdd convention
+		}
+		// w == 0 (zero-width combining mark): dropped, same call TuiScreen::
+		// PutText made in phase 02 -- Cell.h's own "TODO: Grapheme support."
+		curpx += adv;
+	}
+}
+
+// Shared by DrawLineOp and DrawPolyPolylineOp's per-segment decomposition.
+// `a`/`b` are already absolute (offset applied by the caller).
+bool TuiDraw::AxisAlignedLine(Point a, Point b, Color color)
+{
+	Size cell = TuiCellSize();
+	if(a.y == b.y) {
+		int celly = FloorDiv(a.y, cell.cy);
+		int left  = FloorDiv(min(a.x, b.x), cell.cx);
+		int right = CeilDiv(max(a.x, b.x) + 1, cell.cx);
+		for(int cx = left; cx < right; cx++)
+			PutGlyph(cx, celly, 0x2500, color); // light horizontal
+		return true;
+	}
+	if(a.x == b.x) {
+		int cellx = FloorDiv(a.x, cell.cx);
+		int top    = FloorDiv(min(a.y, b.y), cell.cy);
+		int bottom = CeilDiv(max(a.y, b.y) + 1, cell.cy);
+		for(int cy = top; cy < bottom; cy++)
+			PutGlyph(cellx, cy, 0x2502, color); // light vertical
+		return true;
+	}
+	return false;
+}
+
+void TuiDraw::DrawLineOp(int x1, int y1, int x2, int y2, int width, Color color)
+{
+	if(IsNull(color))
+		return;
+	Point a(x1 + offset.x, y1 + offset.y), b(x2 + offset.x, y2 + offset.y);
+	if(AxisAlignedLine(a, b, color))
+		return;
+
+	Rect dest(min(a.x, b.x), min(a.y, b.y), max(a.x, b.x) + max(width, 1), max(a.y, b.y) + max(width, 1));
+	if(!dest.Intersects(clip))
+		return;
+	Size sz = dest.GetSize();
+	if(sz.cx <= 0 || sz.cy <= 0)
+		return;
+
+	ImageDraw iw(sz);
+	iw.Alpha().DrawRect(0, 0, sz.cx, sz.cy, Black());
+	iw.DrawRect(0, 0, sz.cx, sz.cy, Black());
+	Point p1 = a - dest.TopLeft();
+	Point p2 = b - dest.TopLeft();
+	iw.DrawLine(p1.x, p1.y, p2.x, p2.y, width, color);
+	iw.Alpha().DrawLine(p1.x, p1.y, p2.x, p2.y, width, White());
+
+	Image img = iw;
+	TuiRasteriseImage(*this, dest, img, Rect(sz), Null);
+}
+
+void TuiDraw::DrawPolyPolylineOp(const Point *vertices, int vertex_count,
+                                    const int *counts, int count_count,
+                                    int width, Color color, Color doxor)
+{
+	if(IsNull(color) || vertex_count <= 0)
+		return;
+
+	bool all_axis = true;
+	const Point *p = vertices;
+	for(int i = 0; i < count_count; i++) {
+		int cnt = counts[i];
+		for(int j = 0; j + 1 < cnt; j++) {
+			Point a = p[j] + offset, b = p[j + 1] + offset;
+			if(a.x != b.x && a.y != b.y) {
+				all_axis = false;
+				break;
+			}
+		}
+		if(!all_axis) break;
+		p += cnt;
+	}
+
+	if(all_axis) {
+		p = vertices;
+		for(int i = 0; i < count_count; i++) {
+			int cnt = counts[i];
+			for(int j = 0; j + 1 < cnt; j++) {
+				Point a = p[j] + offset, b = p[j + 1] + offset;
+				AxisAlignedLine(a, b, color);
+			}
+			p += cnt;
+		}
+		return;
+	}
+
+	Rect bound = Null;
+	for(int i = 0; i < vertex_count; i++) {
+		Point pt = vertices[i] + offset;
+		bound = IsNull(bound) ? Rect(pt, pt + Size(1, 1)) : (bound | Rect(pt, pt + Size(1, 1)));
+	}
+	bound = Rect(bound.left, bound.top, bound.right + max(width, 1), bound.bottom + max(width, 1));
+	if(!bound.Intersects(clip))
+		return;
+
+	Size sz = bound.GetSize();
+	if(sz.cx <= 0 || sz.cy <= 0)
+		return;
+
+	Buffer<Point> local_v(vertex_count);
+	for(int i = 0; i < vertex_count; i++)
+		local_v[i] = vertices[i] + offset - bound.TopLeft();
+
+	ImageDraw iw(sz);
+	iw.Alpha().DrawRect(0, 0, sz.cx, sz.cy, Black());
+	iw.DrawRect(0, 0, sz.cx, sz.cy, Black());
+	iw.DrawPolyPolyline(local_v, vertex_count, counts, count_count, width, color, doxor);
+	iw.Alpha().DrawPolyPolyline(local_v, vertex_count, counts, count_count, width, White(), White());
+
+	Image img = iw;
+	TuiRasteriseImage(*this, bound, img, Rect(sz), Null);
+}
+
+void TuiDraw::DrawPolyPolyPolygonOp(const Point *vertices, int vertex_count,
+	const int *subpolygon_counts, int subpolygon_count_count,
+	const int *disjunct_polygon_counts, int disjunct_polygon_count_count,
+	Color color, int width, Color outline, uint64 pattern, Color doxor)
+{
+	if(vertex_count <= 0)
+		return;
+
+	Rect bound = Null;
+	for(int i = 0; i < vertex_count; i++) {
+		Point pt = vertices[i] + offset;
+		bound = IsNull(bound) ? Rect(pt, pt + Size(1, 1)) : (bound | Rect(pt, pt + Size(1, 1)));
+	}
+	bound = Rect(bound.left, bound.top, bound.right + max(width, 1), bound.bottom + max(width, 1));
+	if(!bound.Intersects(clip))
+		return;
+
+	Size sz = bound.GetSize();
+	if(sz.cx <= 0 || sz.cy <= 0)
+		return;
+
+	Buffer<Point> local_v(vertex_count);
+	for(int i = 0; i < vertex_count; i++)
+		local_v[i] = vertices[i] + offset - bound.TopLeft();
+
+	ImageDraw iw(sz);
+	iw.Alpha().DrawRect(0, 0, sz.cx, sz.cy, Black());
+	iw.DrawRect(0, 0, sz.cx, sz.cy, Black());
+	iw.DrawPolyPolyPolygon(local_v, vertex_count, subpolygon_counts, subpolygon_count_count, disjunct_polygon_counts, disjunct_polygon_count_count, color, width, outline, pattern, doxor);
+	iw.Alpha().DrawPolyPolyPolygon(local_v, vertex_count, subpolygon_counts, subpolygon_count_count, disjunct_polygon_counts, disjunct_polygon_count_count, White(), width, White(), pattern, White());
+
+	Image img = iw;
+	TuiRasteriseImage(*this, bound, img, Rect(sz), Null);
+}
+
+void TuiDraw::DrawArcOp(const Rect& rc, Point start, Point end, int width, Color color)
+{
+	Rect dest = rc + offset;
+	if(!dest.Intersects(clip))
+		return;
+	Size sz = dest.GetSize();
+	if(sz.cx <= 0 || sz.cy <= 0)
+		return;
+
+	ImageDraw iw(sz);
+	iw.Alpha().DrawRect(0, 0, sz.cx, sz.cy, Black());
+	iw.DrawRect(0, 0, sz.cx, sz.cy, Black());
+	Point s = start - rc.TopLeft();
+	Point e = end - rc.TopLeft();
+	iw.DrawArc(Rect(sz), s, e, width, color);
+	iw.Alpha().DrawArc(Rect(sz), s, e, width, White());
+
+	Image img = iw;
+	TuiRasteriseImage(*this, dest, img, Rect(sz), Null);
+}
+
+void TuiDraw::DrawEllipseOp(const Rect& r, Color color, int pen, Color pencolor)
+{
+	Rect dest = r + offset;
+	if(!dest.Intersects(clip))
+		return;
+	Size sz = dest.GetSize();
+	if(sz.cx <= 0 || sz.cy <= 0)
+		return;
+
+	ImageDraw iw(sz);
+	iw.Alpha().DrawRect(0, 0, sz.cx, sz.cy, Black());
+	iw.DrawRect(0, 0, sz.cx, sz.cy, Black());
+	iw.DrawEllipse(Rect(sz), color, pen, pencolor);
+	iw.Alpha().DrawEllipse(Rect(sz), White(), pen, White());
+
+	Image img = iw;
+	TuiRasteriseImage(*this, dest, img, Rect(sz), Null);
+}
+
+void TuiDraw::SysDrawImageOp(int x, int y, const Image& img, Color color)
+{
+	Rect dest = RectC(x, y, img.GetWidth(), img.GetHeight()) + offset;
+	TuiRasteriseImage(*this, dest, img, Rect(img.GetSize()), color);
+}
+
+void TuiDraw::SysDrawImageOp(int x, int y, const Image& img, const Rect& src, Color color)
+{
+	Rect dest = RectC(x, y, src.GetWidth(), src.GetHeight()) + offset;
+	TuiRasteriseImage(*this, dest, img, src, color);
+}
+
+void TuiDraw::DrawImageOp(int x, int y, int cx, int cy, const Image& img, const Rect& src, Color color)
+{
+	Rect dest = RectC(x, y, cx, cy) + offset;
+	TuiRasteriseImage(*this, dest, img, src, color);
+}
+
+void TuiDraw::DrawDrawingOp(const Rect& target, const Drawing& w)
+{
+	Rect dest = target + offset;
+	if(!dest.Intersects(clip))
+		return;
+	Size sz = dest.GetSize();
+	if(sz.cx <= 0 || sz.cy <= 0)
+		return;
+
+	ImageDraw iw(sz);
+	iw.DrawDrawing(Rect(sz), w);
+
+	Image img = iw;
+	TuiRasteriseImage(*this, dest, img, Rect(sz), Null);
+}
+
+void TuiDraw::DrawPaintingOp(const Rect& target, const Painting& w)
+{
+	Rect dest = target + offset;
+	if(!dest.Intersects(clip))
+		return;
+	Size sz = dest.GetSize();
+	if(sz.cx <= 0 || sz.cy <= 0)
+		return;
+
+	ImageDraw iw(sz);
+	iw.DrawPainting(Rect(sz), w);
+
+	Image img = iw;
+	TuiRasteriseImage(*this, dest, img, Rect(sz), Null);
+}
+
