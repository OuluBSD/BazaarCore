+// CtrlCoreTUI 05/01: the TopWindow layer. In TUI mode, the main full-screen
+// window needs no border, but owned/dialog popup windows (Prompt, FileSel,
+// modal dialogs) require visible box borders and titles to delineate them
+// from underlying content.
+
+void TopWindow::TuiFrame::FrameLayout(Rect& r)
+{
+	LLOG("TuiFrame::FrameLayout win=" << (void*)win << " dec=" << (win ? win->IsDecorated() : 0) << " r=" << r);
+	if(!win || !win->IsDecorated())
+		return;
+	Size cell = TuiCellSize();
+	r.Deflate(cell.cx, cell.cy);
+}
+
+void TopWindow::TuiFrame::FrameAddSize(Size& sz)
+{
+	if(!win || !win->IsDecorated())
+		return;
+	Size cell = TuiCellSize();
+	sz += 2 * cell;
+}
+
+void TopWindow::TuiFrame::FramePaint(Draw& w, const Rect& r)
+{
+	LLOG("TuiFrame::FramePaint win=" << (void*)win << " dec=" << (win ? win->IsDecorated() : 0) << " r=" << r);
+	if(!win || !win->IsDecorated())
+		return;
+	Size cell = TuiCellSize();
+	bool active = win->IsOpen() && win->IsForeground();
+	Color borderColor = active ? SColorHighlight() : SColorShadow();
+	LLOG("TuiFrame::FramePaint active=" << active << " borderColor=" << borderColor << " title=" << win->GetTitle());
+	w.DrawRect(r, SColorFace());
+	TuiPaintBoxBorder(w, r, borderColor);
+	WString t = win->GetTitle();
+	if(!t.IsEmpty()) {
+		int cols = r.GetWidth() / cell.cx;
+		int max_chars = cols - 4;
+		if(max_chars > 0) {
+			if(t.GetCount() > max_chars)
+				t = t.Left(max(0, max_chars - 2)) + "..";
+			WString s = " " + t + " ";
+			int tw = s.GetCount() * cell.cx;
+			Color titleColor = active ? SColorHighlightText() : SColorText();
+			w.DrawRect(r.left + cell.cx, r.top, tw, cell.cy, SColorFace());
+			w.DrawText(r.left + cell.cx, r.top, s, StdFont(), titleColor);
+		}
+	}
+}
+
+bool TopWindow::IsDecorated() const
+{
+	if(frameless)
+		return false;
+	if(!IsOpen())
+		return false;
+	if(GetTop() && GetTop()->owner_window)
+		return true;
+	if(GetRect() != GetWorkArea())
+		return true;
+	return false;
+}
