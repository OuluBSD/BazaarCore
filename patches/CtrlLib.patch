diff -uNr -x '*.o' -x '*.a' -x '*.obj' CtrlLib_a/ChTui.cpp CtrlLib_b/ChTui.cpp
--- a/ChTui.cpp	1970-01-01 02:00:00.000000000 +0200
+++ b/ChTui.cpp	2026-09-16 00:58:38.170583800 +0300
@@ -0,0 +1,352 @@
+#include "CtrlLib.h"
+
+#ifdef PLATFORM_TUI
+
+namespace Upp {
+
+// CtrlCoreTUI 08/01 (gate_widgets): CtrlLib widget ChStyle overrides for TUI.
+
+void ChTuiApplyCtrlLib(bool dark, bool ansi16)
+{
+	GUI_PopUpEffect_Write(GUIEFFECT_NONE);
+	GUI_DropShadows_Write(0);
+
+	Size cell = TuiCellSize();
+
+	// 1. Button styles
+	{
+		Button::Style& bs = Button::StyleNormal().Write();
+		Color btn_normal = dark ? (ansi16 ? Color::Special(8) : Color(52, 52, 52))
+		                        : Color(245, 245, 245);
+		bs.look[CTRL_NORMAL] = btn_normal;
+		bs.look[CTRL_HOT] = SColorHighlight();
+		bs.look[CTRL_PRESSED] = SColorHighlight();
+		bs.look[CTRL_DISABLED] = SColorFace();
+		bs.textcolor[CTRL_NORMAL] = SColorText();
+		bs.textcolor[CTRL_HOT] = SColorHighlightText();
+		bs.textcolor[CTRL_PRESSED] = SColorHighlightText();
+		bs.textcolor[CTRL_DISABLED] = SColorDisabled();
+		bs.monocolor[CTRL_NORMAL] = SColorText();
+		bs.monocolor[CTRL_HOT] = SColorHighlightText();
+		bs.monocolor[CTRL_PRESSED] = SColorHighlightText();
+		bs.monocolor[CTRL_DISABLED] = SColorDisabled();
+		bs.focusmargin = 0;
+		bs.pressoffset = Point(0, 0);
+		bs.overpaint = 0;
+		bs.transparent = false;
+		bs.font = StdFont();
+
+		Button::Style& ok = Button::StyleOk().Write();
+		ok = bs;
+		ok.look[CTRL_NORMAL] = SColorHighlight();
+		ok.textcolor[CTRL_NORMAL] = SColorHighlightText();
+		ok.monocolor[CTRL_NORMAL] = SColorHighlightText();
+
+		Button::Style& be = Button::StyleEdge().Write();
+		be = bs;
+
+		Button::Style& bsc = Button::StyleScroll().Write();
+		bsc = bs;
+	}
+
+	// 2. ScrollBar style
+	{
+		ScrollBar::Style& sb = ScrollBar::StyleDefault().Write();
+		sb.barsize = cell.cx;
+		sb.arrowsize = cell.cy;
+		sb.thumbmin = cell.cy;
+		sb.overthumb = 0;
+		sb.thumbwidth = cell.cx;
+		sb.bgcolor = SColorFace();
+		for(int i = 0; i < 4; i++) {
+			sb.vupper[i] = sb.vlower[i] = sb.hupper[i] = sb.hlower[i] = SColorFace();
+			sb.vthumb[i] = sb.hthumb[i] = (i == CTRL_HOT || i == CTRL_PRESSED) ? SColorHighlight() : SColorShadow();
+		}
+		sb.up = sb.down = sb.left = sb.right = Button::StyleNormal();
+	}
+
+	// 3. MenuBar style
+	{
+		MenuBar::Style& ms = MenuBar::StyleDefault().Write();
+		ms.look = SColorFace();
+		ms.arealook = SColorFace();
+		ms.topitem[0] = Null;
+		ms.topitem[1] = SColorHighlight();
+		ms.topitem[2] = SColorHighlight();
+		ms.topitemtext[0] = SColorText();
+		ms.topitemtext[1] = SColorHighlightText();
+		ms.topitemtext[2] = SColorHighlightText();
+		ms.item = SColorHighlight();
+		ms.menutext = SColorText();
+		ms.itemtext = SColorHighlightText();
+		ms.popupframe = ChBorder((const ColorF *)nullptr, SColorShadow());
+		ms.popupbody = SColorFace();
+		ms.popupiconbar = Null;
+		ms.pullshift = Point(0, 0);
+		ms.leftgap = cell.cx;
+		ms.textgap = 0;
+		ms.lsepm = 0;
+		ms.rsepm = 0;
+		ms.maxiconsize = Size(cell.cx, cell.cy);
+		ms.separator.l1 = ms.separator.l2 = SColorShadow();
+		ms.breaksep.l1 = ms.breaksep.l2 = SColorShadow();
+	}
+
+	// 4. StatusBar style
+	{
+		StatusBar::Style& st = StatusBar::StyleDefault().Write();
+		st.look = SColorFace();
+	}
+
+	// 5. Splitter style
+	{
+		Splitter::Style& ss = Splitter::StyleDefault().Write();
+		ss.width = cell.cx;
+		ss.vert[0] = ss.vert[1] = SColorFace();
+		ss.horz[0] = ss.horz[1] = SColorFace();
+		ss.dots = false;
+	}
+
+	// 6. EditField style
+	{
+		EditField::Style& es = EditField::StyleDefault().Write();
+		es.paper = SColorPaper();
+		es.disabled = SColorFace();
+		es.focus = SColorPaper();
+		es.invalid = Color(128, 0, 0);
+		es.text = SColorText();
+		es.textdisabled = SColorDisabled();
+		es.selected = SColorHighlight();
+		es.selectedtext = SColorHighlightText();
+		es.selected0 = SColorShadow();
+		es.selectedtext0 = SColorText();
+		for(int i = 0; i < 4; i++)
+			es.edge[i] = Null;
+		es.activeedge = false;
+		es.vfm = 0;
+	}
+
+	// 7. HeaderCtrl style
+	{
+		HeaderCtrl::Style& hs = HeaderCtrl::StyleDefault().Write();
+		for(int i = 0; i < 4; i++)
+			hs.look[i] = (i == CTRL_HOT || i == CTRL_PRESSED) ? SColorHighlight() : SColorFace();
+		hs.pressoffset = false;
+		hs.gridadjustment = 0;
+	}
+
+	// 8. TabCtrl style
+	{
+		TabCtrl::Style& ts = TabCtrl::StyleDefault().Write();
+		ts.tabheight = cell.cy;
+		ts.margin = 0;
+		ts.extendleft = 0;
+		ts.sel = Rect(0, 0, 0, 0);
+		ts.edge = Rect(0, 0, 0, 0);
+		ts.body = SColorFace();
+		for(int i = 0; i < 4; i++) {
+			ts.normal[i] = ts.first[i] = ts.last[i] = ts.both[i] =
+				(i == CTRL_HOT || i == CTRL_PRESSED) ? SColorHighlight() : SColorFace();
+			ts.text_color[i] = (i == CTRL_HOT || i == CTRL_PRESSED) ? SColorHighlightText()
+			                 : (i == CTRL_DISABLED) ? SColorDisabled() : SColorText();
+		}
+		ts.font = StdFont();
+	}
+
+	// 9. MultiButton style (and DropList base)
+	{
+		MultiButton::Style& mbs = MultiButton::StyleDefault().Write();
+		mbs.stdwidth = cell.cx * 2;
+		for(int i = 0; i < 4; i++) {
+			mbs.look[i] = SColorFace();
+			mbs.left[i] = mbs.lmiddle[i] = mbs.right[i] = mbs.rmiddle[i] = mbs.simple[i] = mbs.trivial[i] = SColorFace();
+			mbs.monocolor[i] = mbs.fmonocolor[i] = SColorText();
+			mbs.edge[i] = Null;
+		}
+		mbs.activeedge = false;
+		mbs.border = 0;
+		mbs.trivialborder = 0;
+		mbs.pressoffset = Point(0, 0);
+		mbs.sepm = 0;
+		mbs.overpaint = 0;
+		mbs.loff = mbs.roff = 0;
+		mbs.margin = Rect(0, 0, 0, 0);
+		mbs.paper = SColorPaper();
+	}
+
+	// 10. ToolBar & ToolButton styles
+	{
+		ToolBar::Style& tbs = ToolBar::StyleDefault().Write();
+		tbs.look = SColorFace();
+		tbs.arealook = SColorFace();
+		tbs.buttonminsize = Size(cell.cx * 4, cell.cy);
+		tbs.maxiconsize = Size(cell.cx * 2, cell.cy);
+		tbs.buttonkind = ToolButton::RIGHTLABEL;
+		tbs.separator.l1 = tbs.separator.l2 = SColorShadow();
+		tbs.breaksep.l1 = tbs.breaksep.l2 = SColorShadow();
+
+		ToolButton::Style& tbtn = ToolButton::StyleDefault().Write();
+		for(int i = 0; i < 6; i++) {
+			tbtn.look[i] = (i == 1 || i == 2 || i == 4 || i == 5) ? SColorHighlight() : Null;
+			tbtn.textcolor[i] = (i == 1 || i == 2 || i == 4 || i == 5) ? SColorHighlightText() : SColorText();
+			tbtn.offset[i] = Point(0, 0);
+		}
+		tbtn.overpaint = 0;
+		tbtn.font = StdFont();
+	}
+
+	// 11. ProgressIndicator style
+	{
+		ProgressIndicator::Style& ps = ProgressIndicator::StyleDefault().Write();
+		ps.classic = false;
+		ps.bound = false;
+		ps.nomargins = true;
+		Color trough = dark ? (ansi16 ? Color::Special(0) : Color(18, 18, 18))
+		                    : Color(210, 210, 210);
+		ps.hlook = ps.vlook = trough;
+		ps.hchunk = ps.vchunk = SColorHighlight();
+	}
+
+	// 12. Default icon glyph substitution table (Phase 09/02)
+	{
+		auto Reg = [](const Image& img, const char *glyph_utf8, Color ink = Null) {
+			if(img.IsEmpty()) return;
+			TuiRegisterIconGlyph(img, glyph_utf8, ink);
+			TuiRegisterIconGlyph(DisabledImage(img), glyph_utf8, SColorDisabled());
+		};
+
+		auto RegNerd = [](const Image& img, const char *glyph_utf8, Color ink = Null) {
+			if(img.IsEmpty()) return;
+			TuiRegisterNerdFontGlyph(img, glyph_utf8, ink);
+			TuiRegisterNerdFontGlyph(DisabledImage(img), glyph_utf8, SColorDisabled());
+		};
+
+		// --- Tier 1: Standard Unicode glyphs ---
+		// Checkboxes
+		Reg(CtrlsImg::O0(), "☐");
+		Reg(CtrlsImg::O0h(), "☐");
+		Reg(CtrlsImg::O0p(), "☐");
+		Reg(CtrlsImg::O0d(), "☐", SColorDisabled());
+		Reg(CtrlsImg::O1(), "☑");
+		Reg(CtrlsImg::O1h(), "☑");
+		Reg(CtrlsImg::O1p(), "☑");
+		Reg(CtrlsImg::O1d(), "☑", SColorDisabled());
+		Reg(CtrlsImg::O2(), "▣");
+		Reg(CtrlsImg::O2h(), "▣");
+		Reg(CtrlsImg::O2p(), "▣");
+		Reg(CtrlsImg::O2d(), "▣", SColorDisabled());
+
+		// Radio buttons
+		Reg(CtrlsImg::S0(), "○");
+		Reg(CtrlsImg::S0h(), "○");
+		Reg(CtrlsImg::S0p(), "○");
+		Reg(CtrlsImg::S0d(), "○", SColorDisabled());
+		Reg(CtrlsImg::S1(), "●");
+		Reg(CtrlsImg::S1h(), "●");
+		Reg(CtrlsImg::S1p(), "●");
+		Reg(CtrlsImg::S1d(), "●", SColorDisabled());
+
+		// Menu check/radio and submenu arrow
+		Reg(CtrlImg::MenuCheck0(), " ");
+		Reg(CtrlImg::MenuCheck1(), "✓");
+		Reg(CtrlImg::MenuRadio0(), " ");
+		Reg(CtrlImg::MenuRadio1(), "●");
+		Reg(CtrlImg::right_arrow(), "►");
+
+		// Arrows
+		Reg(CtrlsImg::UA(), "▲");
+		Reg(CtrlsImg::DA(), "▼");
+		Reg(CtrlsImg::LA(), "◄");
+		Reg(CtrlsImg::RA(), "►");
+		Reg(CtrlsImg::kUA(), "▲");
+		Reg(CtrlsImg::kDA(), "▼");
+		Reg(CtrlsImg::kLA(), "◄");
+		Reg(CtrlsImg::kRA(), "►");
+		Reg(CtrlsImg::SpU(), "▲");
+		Reg(CtrlsImg::SpD(), "▼");
+		Reg(CtrlsImg::kSpU(), "▲");
+		Reg(CtrlsImg::kSpD(), "▼");
+
+		// Size grip
+		Reg(CtrlsImg::SizeGrip(), "◢", SColorShadow());
+
+		// Tree expanders
+		Reg(CtrlImg::treeplus(), "⊞");
+		Reg(CtrlImg::treeminus(), "⊟");
+		Reg(CtrlImg::cross(), "✕");
