diff -uNr -x '*.o' -x '*.a' -x '*.obj' CtrlLib_a/Button.cpp CtrlLib_b/Button.cpp
--- a/Button.cpp	2026-03-14 17:37:18.827910300 +0200
+++ b/Button.cpp	2026-11-09 21:19:49.684236871 +0200
@@ -360,8 +360,31 @@
 	if(monoimg)
 		dl.lcolor = st.monocolor[visualstate];
 	bool push = visualstate == CTRL_PRESSED;
+#ifdef PLATFORM_TUI
+	Size cell = TuiCellSize();
+	int tx = r.left + 3 + push * st.pressoffset.x;
+	int tcx = r.GetWidth() - 6;
+	int ty = r.top + 3 + push * st.pressoffset.y;
+	int tcy = r.GetHeight() - 6;
+	if(cell.cy > 0 && cell.cx > 0) {
+		TuiDraw *td = dynamic_cast<TuiDraw*>(&w);
+		Point off = td ? td->GetOffset() : (ctrl ? ctrl->GetScreenRect().TopLeft() : Point(0, 0));
+		Rect pixel = r + off;
+		Rect cellrect = Rect(FloorDiv(pixel.left, cell.cx), FloorDiv(pixel.top, cell.cy),
+		                     CeilDiv(pixel.right, cell.cx), CeilDiv(pixel.bottom, cell.cy));
+		Size txtsz = *label ? GetSmartTextSize(label, dl.font) : Size(0, 0);
+		int text_cy = max(cell.cy, txtsz.cy);
+		int text_rows = CeilDiv(text_cy, cell.cy);
+		int total_rows = max(1, cellrect.Height());
+		int start_row = cellrect.top + max(0, (total_rows - text_rows) / 2);
+		ty = start_row * cell.cy - off.y;
+		tcy = text_cy;
+	}
+	dl.Paint(w, tx, ty, tcx, tcy);
+#else
 	dl.Paint(w, r.left + 3 + push * st.pressoffset.x, r.top + 3 + push * st.pressoffset.y,
 	         r.GetWidth() - 6, r.GetHeight() - 6);
+#endif
 	if(focus)
 		DrawFocus(w, r.Deflated(st.focusmargin));
 }
