+int Color::GetSpecial() const
+{
+	if(color & SPECIAL)
+		return color & 0x7fffffff;
+	if(color & SCOLOR) {
+		dword val = color & VBITS;
+		if(val < s_Max) {
+			dword r = s_color[val];
+			if(r & SPECIAL)
+				return r & 0x7fffffff;
+		}
+	}
+	return -1;
+}
+
+Color Color::Resolved() const
+{
+	int sp = GetSpecial();
+	if(sp >= 0)
+		return Special(sp);
+	return FromRaw(Get());
+}
